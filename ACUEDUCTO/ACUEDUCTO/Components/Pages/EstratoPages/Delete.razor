@page "/estratos/delete"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Estrato</h2>
    <hr />
    @if (estrato is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@estrato.Descripcion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SobreTasa</dt>
            <dd class="col-sm-10">@estrato.SobreTasa</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CargoFijo</dt>
            <dd class="col-sm-10">@estrato.CargoFijo</dd>
        </dl>
        <EditForm method="post" Model="estrato" OnValidSubmit="DeleteEstrato" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(estrato is null)">Delete</button> |
            <a class="btn btn-outline-secondary btn-sm" href="" onclick="return cerrarVentana('');">Cerrar</a>
        </EditForm>
    }
</div>

@code {
    private Estrato? estrato;

    [SupplyParameterFromQuery]
    private int Idestrato { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        estrato = await context.Estratos.FirstOrDefaultAsync(m => m.Idestrato == Idestrato);

        if (estrato is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEstrato()
    {
        using var context = DbFactory.CreateDbContext();
        context.Estratos.Remove(estrato!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/estratos");
    }
}
