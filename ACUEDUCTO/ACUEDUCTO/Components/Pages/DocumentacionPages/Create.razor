@page "/documentacions/create"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Crear documento</PageTitle>

<div class="container py-2">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <h1 class="h5 mb-0">Crear documento</h1>
            <small class="text-muted">TRD - Tabla de retención documental</small>
        </div>
        <div>
            <a class="btn btn-secondary" href="/documentacions" onclick="return cerrarVentana('/documentacions');">Cerrar</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm method="post" Model="Documentacion" OnValidSubmit="AddDocumentacion" FormName="create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label for="codigo" class="form-label">Código</label>
                        <InputText id="codigo" @bind-Value="Documentacion.Codigo" class="form-control" />
                        <ValidationMessage For="() => Documentacion.Codigo" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="idserie" class="form-label">Serie</label>
                        <InputSelect id="idserie" @bind-Value="Documentacion.Idserie" class="form-select">
                            <option value="">Seleccione una serie</option>
                            @foreach (var serie in series)
                            {
                                <option value="@serie.Id">@serie.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Documentacion.Idserie" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="idtipo" class="form-label">Tipo</label>
                        <InputSelect id="idtipo" @bind-Value="Documentacion.Idtipo" class="form-select">
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in tipos)
                            {
                                <option value="@tipo.Id">@tipo.Nombre</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Documentacion.Idtipo" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tiempoarchivogestion" class="form-label">Archivo Gestión (Años)</label>
                        <InputNumber id="tiempoarchivogestion" @bind-Value="Documentacion.TiempoArchivoGestion" class="form-control" />
                        <ValidationMessage For="() => Documentacion.TiempoArchivoGestion" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tiempoarchivocentral" class="form-label">Archivo Central (Años)</label>
                        <InputNumber id="tiempoarchivocentral" @bind-Value="Documentacion.TiempoArchivoCentral" class="form-control" />
                        <ValidationMessage For="() => Documentacion.TiempoArchivoCentral" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="disposicionfinal" class="form-label">Disposición final</label>
                        <InputText id="disposicionfinal" @bind-Value="Documentacion.DisposicionFinal" class="form-control" />
                        <ValidationMessage For="() => Documentacion.DisposicionFinal" class="text-danger" />
                    </div>
                    <div class="col-12">
                        <label for="observaciones" class="form-label">Observaciones</label>
                        <InputText id="observaciones" @bind-Value="Documentacion.Observaciones" class="form-control" />
                        <ValidationMessage For="() => Documentacion.Observaciones" class="text-danger" />
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a class="btn btn-light" href="/documentacions" onclick="return cerrarVentana('/documentacions');">Cerrar</a>
                    <button type="submit" class="btn btn-primary">Crear</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Documentacion Documentacion { get; set; } = new();

    private List<SerieDocumentacion> series = new();
    private List<TipoDocumentacion> tipos = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        series = await context.SerieDocumentacions.OrderBy(c => c.Nombre).ToListAsync();
        tipos = await context.TipoDocumentacions.OrderBy(c => c.Nombre).ToListAsync();
    }

    private async Task AddDocumentacion()
    {
        using var context = DbFactory.CreateDbContext();
        Documentacion.Id = Guid.NewGuid().ToString();
        context.Documentacions.Add(Documentacion);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/documentacions");
    }
}
