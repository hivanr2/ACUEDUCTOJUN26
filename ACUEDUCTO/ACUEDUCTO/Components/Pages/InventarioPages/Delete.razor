@page "/inventarios/delete"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Inventario</h2>
    <hr />
    @if (inventario is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Codigo</dt>
            <dd class="col-sm-10">@inventario.Codigo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DescripcionCorta</dt>
            <dd class="col-sm-10">@inventario.DescripcionCorta</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DescripcionLarga</dt>
            <dd class="col-sm-10">@inventario.DescripcionLarga</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Unidad</dt>
            <dd class="col-sm-10">@inventario.Unidad</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Medida</dt>
            <dd class="col-sm-10">@inventario.Medida</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Cantidad</dt>
            <dd class="col-sm-10">@inventario.Cantidad</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ValorUnitario</dt>
            <dd class="col-sm-10">@inventario.ValorUnitario</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ValorTotal</dt>
            <dd class="col-sm-10">@inventario.ValorTotal</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaHoraRegistro</dt>
            <dd class="col-sm-10">@inventario.FechaHoraRegistro</dd>
        </dl>
        <EditForm method="post" Model="inventario" OnValidSubmit="DeleteInventario" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(inventario is null)">Delete</button> |
            <a href="/inventarios">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Inventario? inventario;

    [SupplyParameterFromQuery]
    private string Idinventario { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        inventario = await context.Inventarios.FirstOrDefaultAsync(m => m.Idinventario == Idinventario);

        if (inventario is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteInventario()
    {
        using var context = DbFactory.CreateDbContext();
        context.Inventarios.Remove(inventario!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/inventarios");
    }
}
