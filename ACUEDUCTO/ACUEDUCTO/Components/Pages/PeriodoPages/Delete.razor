@page "/periodos/delete"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Periodo</h2>
    <hr />
    @if (periodo is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">DescripcionCorta</dt>
            <dd class="col-sm-10">@periodo.DescripcionCorta</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DescripcionLarga</dt>
            <dd class="col-sm-10">@periodo.DescripcionLarga</dd>
        </dl>
        <EditForm method="post" Model="periodo" OnValidSubmit="DeletePeriodo" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(periodo is null)">Delete</button> |
            <a class="btn btn-outline-secondary btn-sm" href="" onclick="return cerrarVentana('');">Cerrar</a>
        </EditForm>
    }
</div>

@code {
    private Periodo? periodo;

    [SupplyParameterFromQuery]
    private int Idperiodo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        periodo = await context.Periodos.FirstOrDefaultAsync(m => m.Idperiodo == Idperiodo);

        if (periodo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePeriodo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Periodos.Remove(periodo!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/periodos");
    }
}
