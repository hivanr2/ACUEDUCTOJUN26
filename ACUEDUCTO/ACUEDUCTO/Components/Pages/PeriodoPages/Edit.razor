@page "/periodos/edit"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Editar Periodo</PageTitle>

<h1>Editar Periodo</h1>

<h2>Periodo</h2>
<hr />
@if (Periodo is null)
{
    <p><em>Llamando...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Periodo" OnValidSubmit="UpdatePeriodo" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Periodo.Idperiodo" value="@Periodo.Idperiodo" />
                <div class="mb-3">
                    <label for="descripcioncorta" class="form-label">DescripcionCorta:</label>
                    <InputText id="descripcioncorta" @bind-Value="Periodo.DescripcionCorta" class="form-control" />
                    <ValidationMessage For="() => Periodo.DescripcionCorta" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="descripcionlarga" class="form-label">DescripcionLarga:</label>
                    <InputText id="descripcionlarga" @bind-Value="Periodo.DescripcionLarga" class="form-control" />
                    <ValidationMessage For="() => Periodo.DescripcionLarga" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">GUARDAR</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a class="btn btn-outline-secondary btn-sm" href="" onclick="return cerrarVentana('');">Cerrar</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Idperiodo { get; set; }

    [SupplyParameterFromForm]
    private Periodo? Periodo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Periodo ??= await context.Periodos.FirstOrDefaultAsync(m => m.Idperiodo == Idperiodo);

        if (Periodo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdatePeriodo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Periodo!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!PeriodoExists(Periodo!.Idperiodo))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/periodos");
    }

    private bool PeriodoExists(int idperiodo)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Periodos.Any(e => e.Idperiodo == idperiodo);
    }
}
