@page "/tipodocumentacions/details"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>TipoDocumentacion</h2>
    <hr />
    @if (tipodocumentacion is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@tipodocumentacion.Nombre</dd>
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@tipodocumentacion.Descripcion</dd>
        </dl>
        <div>
            <a href="@($"/tipodocumentacions/edit?id={tipodocumentacion.Id}")">Edit</a> |
            <a href="@($"/tipodocumentacions")">Back to List</a>
        </div>
    }
</div>

@code {
    private TipoDocumentacion? tipodocumentacion;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tipodocumentacion = await context.TipoDocumentacions.FirstOrDefaultAsync(m => m.Id == Id);

        if (tipodocumentacion is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
