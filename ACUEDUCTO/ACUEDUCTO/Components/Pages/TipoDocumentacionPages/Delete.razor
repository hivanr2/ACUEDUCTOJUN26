@page "/tipodocumentacions/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TipoDocumentacion</h2>
    <hr />
    @if (tipodocumentacion is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@tipodocumentacion.Nombre</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@tipodocumentacion.Descripcion</dd>
        </dl>
        <EditForm method="post" Model="tipodocumentacion" OnValidSubmit="DeleteTipoDocumentacion" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(tipodocumentacion is null)">Delete</button> |
            <a href="/tipodocumentacions">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TipoDocumentacion? tipodocumentacion;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tipodocumentacion = await context.TipoDocumentacions.FirstOrDefaultAsync(m => m.Id == Id);

        if (tipodocumentacion is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTipoDocumentacion()
    {
        using var context = DbFactory.CreateDbContext();
        context.TipoDocumentacions.Remove(tipodocumentacion!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipodocumentacions");
    }
}
