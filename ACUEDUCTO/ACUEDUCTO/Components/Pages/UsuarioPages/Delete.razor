@page "/usuarios/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>@(usuario?.ApellidosNombres ?? "Borrar Usuario")</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Usuario</h2>
    <hr />
    @if (usuario is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">ApellidosNombres</dt>
            <dd class="col-sm-10">@usuario.ApellidosNombres</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Celular</dt>
            <dd class="col-sm-10">@usuario.Celular</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CorreoElectronico</dt>
            <dd class="col-sm-10">@usuario.CorreoElectronico</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">NivelEducativo</dt>
            <dd class="col-sm-10">@usuario.NivelEducativo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Observaciones</dt>
            <dd class="col-sm-10">@usuario.Observaciones</dd>
        </dl>
        <EditForm method="post" Model="usuario" OnValidSubmit="DeleteUsuario" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(usuario is null)">Delete</button> |
            <a href="/usuarios">Volve a la Lista</a>
        </EditForm>
    }
</div>

@code {
    private Usuario? usuario;

    [SupplyParameterFromQuery]
    private string Identificacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        usuario = await context.Usuarios.FirstOrDefaultAsync(m => m.Identificacion == Identificacion);

        if (usuario is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteUsuario()
    {
        using var context = DbFactory.CreateDbContext();
        context.Usuarios.Remove(usuario!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/usuarios");
    }
}
