@page "/egresos/create"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Egreso</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Egreso" OnValidSubmit="AddEgreso" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="fechahora" class="form-label">FechaHora:</label> 
                <InputDate id="fechahora" @bind-Value="Egreso.FechaHora" class="form-control" /> 
                <ValidationMessage For="() => Egreso.FechaHora" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="numero" class="form-label">Numero:</label>
                <InputNumber id="numero" @bind-Value="Egreso.Numero" class="form-control" />
                <ValidationMessage For="() => Egreso.Numero" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="idproveedor" class="form-label">Idproveedor:</label> 
                <InputText id="idproveedor" @bind-Value="Egreso.Idproveedor" class="form-control" /> 
                <ValidationMessage For="() => Egreso.Idproveedor" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="idcxp" class="form-label">Idcxp:</label> 
                <InputText id="idcxp" @bind-Value="Egreso.Idcxp" class="form-control" /> 
                <ValidationMessage For="() => Egreso.Idcxp" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="concepto" class="form-label">Concepto:</label> 
                <InputText id="concepto" @bind-Value="Egreso.Concepto" class="form-control" /> 
                <ValidationMessage For="() => Egreso.Concepto" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="valor" class="form-label">Valor:</label> 
                <InputNumber id="valor" @bind-Value="Egreso.Valor" class="form-control" /> 
                <ValidationMessage For="() => Egreso.Valor" class="text-danger" /> 
            </div>        
            <div class="d-flex justify-content-end gap-2 mt-2">
                <a class="btn btn-outline-secondary" href="/egresos" onclick="return cerrarVentana('/egresos');">Cerrar</a>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </EditForm>
    </div>
</div>

<div>
    <a href="/egresos" onclick="return cerrarVentana('/egresos');">Cerrar</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Egreso Egreso { get; set; } = new();
    private MovimientoCaja movimientoCaja { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        if (Egreso.Numero == null || Egreso.Numero == 0)
        {
            // Ingreso.FechaHora = DateTime.Now;
            int siguienteNumero = 1240; // Valor por defecto en caso de que no haya registros

            if (context.Egresos.Any())
            {
                siguienteNumero = ((int)context.Egresos.Where(a => a.Numero > 0).Select(a => a.Numero).Max()) + 1;
            }
            Egreso.Numero = siguienteNumero;
        }
    }




    private async Task AddEgreso()
    {
        using var context = DbFactory.CreateDbContext();
        Egreso.Idegreso = Guid.NewGuid().ToString();
        context.Egresos.Add(Egreso);
        await context.SaveChangesAsync();

        // Se hace registro de movimiento de caja
        movimientoCaja.FechaHora = Egreso.FechaHora;
        movimientoCaja.Iddocumento = "EGRESO#" + Egreso.Numero.ToString();
        movimientoCaja.Entrada = 0;
        movimientoCaja.Salida = Egreso.Valor;
        movimientoCaja.Saldo = Egreso.Valor;
        context.MovimientoCajas.Add(movimientoCaja);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/egresos");
        StateHasChanged();
    }
}
