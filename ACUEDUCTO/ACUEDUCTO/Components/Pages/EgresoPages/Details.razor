@page "/egresos/details"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Egreso</h2>
    <hr />
    @if (egreso is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Numero</dt>
            <dd class="col-sm-10">@egreso.Numero</dd>
            <dt class="col-sm-2">FechaHora</dt>
            <dd class="col-sm-10">@egreso.FechaHora</dd>
            <dt class="col-sm-2">Idproveedor</dt>
            <dd class="col-sm-10">@egreso.Idproveedor</dd>
            <dt class="col-sm-2">Idcxp</dt>
            <dd class="col-sm-10">@egreso.Idcxp</dd>
            <dt class="col-sm-2">Concepto</dt>
            <dd class="col-sm-10">@egreso.Concepto</dd>
            <dt class="col-sm-2">Valor</dt>
            <dd class="col-sm-10">@egreso.Valor</dd>
        </dl>
        <div>
            <a href="@($"/egresos/edit?idegreso={egreso.Idegreso}")">Edit</a> |
            <a href="/egresos" onclick="return cerrarVentana('/egresos');">Cerrar</a>
        </div>
    }
</div>

@code {
    private Egreso? egreso;

    [SupplyParameterFromQuery]
    private string Idegreso { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        egreso = await context.Egresos.FirstOrDefaultAsync(m => m.Idegreso == Idegreso);

        if (egreso is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
