@page "/egresos/delete"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Egreso</h2>
    <hr />
    @if (egreso is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Numero</dt>
            <dd class="col-sm-10">@egreso.Numero</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaHora</dt>
            <dd class="col-sm-10">@egreso.FechaHora</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Idproveedor</dt>
            <dd class="col-sm-10">@egreso.Idproveedor</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Idcxp</dt>
            <dd class="col-sm-10">@egreso.Idcxp</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Concepto</dt>
            <dd class="col-sm-10">@egreso.Concepto</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Valor</dt>
            <dd class="col-sm-10">@egreso.Valor</dd>
        </dl>
        <EditForm method="post" Model="egreso" OnValidSubmit="DeleteEgreso" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(egreso is null)">Delete</button> |
            <a href="/egresos" onclick="return cerrarVentana('/egresos');">Cerrar</a>
        </EditForm>
    }
}
</div>

@code {
    private Egreso? egreso;

    [SupplyParameterFromQuery]
    private string Idegreso { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        egreso = await context.Egresos.FirstOrDefaultAsync(m => m.Idegreso == Idegreso);

        if (egreso is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteEgreso()
    {
        using var context = DbFactory.CreateDbContext();
        context.Egresos.Remove(egreso!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/egresos");
    }
}
