@code {
    private const int MaxPeriodos = 10; // Limitar a los últimos 10 periodos
    private int CuantosDiasConsumos = 0;
    private int CuantosDiasPago = 0;
    private int CuantosDiasCorte = 0;
    private int CuantosDiasMantenimiento = 0;
    private List<ConsumoPorPeriodo> consumosPorPeriodo = new List<ConsumoPorPeriodo>();
    private string id_planilla_actual;
    private string id_planilla_siguiente;
    private int desperdicioCount = 0;
    private int totalActivePredios = 0;
    private bool showDesperdicioDetails = false;
    private DesperdicioAlertHome? desperdicioRef;

    protected override async Task OnInitializedAsync()
    {
        await DeterminarPlanillaActual();
    }


    private async Task DeterminarPlanillaActual()
    {
        using var context = DbFactory.CreateDbContext();

        // Obtener la planilla correspondiente al bimestre actual
        var fechaActual = DateTime.Now;
        var planillaActual = await context.Planillas
            .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                        p.FechaHoraRegistroConsumo < fechaActual) // Bimestre actual
            .OrderByDescending(p => p.FechaHoraRegistroConsumo) // Asegurarse de obtener la más reciente
            .FirstOrDefaultAsync();

        id_planilla_actual = planillaActual?.Idplanilla ?? "No disponible";
        if (planillaActual != null)
        {
            // Obtener la planilla del siguiente período
            var planillaSiguiente = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                            p.FechaHoraRegistroConsumo > planillaActual.FechaHoraRegistroConsumo) // Siguiente período
                .OrderBy(p => p.FechaHoraRegistroConsumo) // Obtener la más cercana
                .FirstOrDefaultAsync();

            if (planillaSiguiente != null)
            {
                id_planilla_siguiente = planillaSiguiente.Idplanilla;
                var hoy = DateOnly.FromDateTime(fechaActual);

                // Calcular CuantosDiasConsumos
                if (planillaSiguiente?.FechaHoraRegistroConsumo != null)
                {
                    CuantosDiasConsumos = (planillaSiguiente.FechaHoraRegistroConsumo.Value - fechaActual).Days + 1;
                }

                // Calcular CuantosDiasPago
                if (planillaSiguiente.FechaLimitePago != null)
                {
                    CuantosDiasPago = Math.Max(0, (planillaSiguiente.FechaLimitePago.Value.DayNumber - hoy.DayNumber) + 1);
                }
                // Calcular CuantosDiasCorte
                if (planillaSiguiente.FechaSuspension != null)
                {
                    CuantosDiasCorte = Math.Max(0, (planillaSiguiente.FechaSuspension.Value.DayNumber - hoy.DayNumber) + 1);
                }
            }
            else
            {
                CuantosDiasConsumos = 0;
                CuantosDiasPago = 0;
            }

            // Calcular CuantosDiasMantenimiento: fecha del trabajo más próximo en el futuro
            var trabajoProximo = await context.Trabajos
                .Where(t => t.FechaInicio.HasValue && t.FechaInicio > fechaActual)
                .OrderBy(t => t.FechaInicio)
                .FirstOrDefaultAsync();

            if (trabajoProximo != null && trabajoProximo.FechaInicio.HasValue)
            {
                CuantosDiasMantenimiento = (trabajoProximo.FechaInicio.Value - fechaActual).Days + 1;
            }
            else
            {
                CuantosDiasMantenimiento = 0; // No hay trabajos próximos
            }
        }
        // Resumen de desperdicio provisto por DesperdicioAlert
        try
        {
            if (desperdicioRef is not null)
            {
                var summary = await desperdicioRef.GetSummaryAsync();
                desperdicioCount = summary.Count;
                totalActivePredios = summary.Total;
            }
        }
        catch
        {
            // keep previous values on error
        }
    }

    private async Task ToggleDesperdicio()
    {
        showDesperdicioDetails = !showDesperdicioDetails;

        if (showDesperdicioDetails)
        {
            await Task.Delay(1); // deja que renderice

            if (desperdicioRef is not null)
            {
                var summary = await desperdicioRef.GetSummaryAsync();
                desperdicioCount = summary.Count;
                totalActivePredios = summary.Total;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            using var context = DbFactory.CreateDbContext();
            consumosPorPeriodo = await context.Facturacions
                .Include(f => f.IdplanillaNavigation)
                .ThenInclude(p => p.IdperiodoNavigation)
                .GroupBy(f => f.IdplanillaNavigation.Descripcion)
                .Select(g => new ConsumoPorPeriodo
                    {
                        Periodo = g.Key,
                        TotalConsumoM3 = g.Sum(f => f.ConsumoM3 ?? 0)
                    })
                .OrderByDescending(c => c.Periodo)
                .Take(MaxPeriodos)
                .ToListAsync();

            consumosPorPeriodo.Reverse();

            await JS.InvokeVoidAsync("renderConsumoChart", consumosPorPeriodo);
        }
    }

    public class ConsumoPorPeriodo
    {
        public string Periodo { get; set; }
        public double TotalConsumoM3 { get; set; }
    }
}

