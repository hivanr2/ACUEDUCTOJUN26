@page "/"
@layout NavMenuBotones
@using ACUEDUCTO.Components.Layout
@using ACUEDUCTO.Components.Pages.IngresoPages
@using ACUEDUCTO.Components.Pages.PredioPages
@using ACUEDUCTO.Components.Shared
@using ACUEDUCTO.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AcueductoContext> DbFactory
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="container-fluid my-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border border-light">
        <div class="col-auto text-center text-md-start">
            <img src="./fondologo-acueducto.jpg" alt="Logo" class="img-fluid rounded-circle shadow-sm" style="max-height: 80px;" />
        </div>
        <div class="col text-center text-md-start mt-3 mt-md-0">
            <span class="text-muted text-uppercase fw-semibold tracking-wider" style="font-size: 0.75rem; letter-spacing: 0.1em;">Sistema de Gestión</span>
            <h1 class="h2 mb-1 text-primary fw-bold">ACUEDUCTO COMUNITARIO</h1>
            <p class="text-muted mb-0">Junta de Acción de Comunal Tobia Chica</p>
        </div>
    </div>

    <!-- Alert Metrics Grid -->
    <div class="row g-4 mb-4">
        <!-- Consumos -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                            <i class="bi bi-droplet-fill fs-4"></i>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info px-2 py-1">Consumos</span>
                    </div>
                    <h3 class="display-6 fw-bold mb-1">@CuantosDiasConsumos</h3>
                    <p class="card-text text-muted small">Días para registrar consumos e impresión in situ.</p>
                </div>
            </div>
        </div>
        
        <!-- Pago -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Pagos</span>
                    </div>
                    <h3 class="display-6 fw-bold mb-1">@CuantosDiasPago</h3>
                    <p class="card-text text-muted small">Días restantes para el último día de pago.</p>
                </div>
            </div>
        </div>

        <!-- Corte -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                            <i class="bi bi-x-circle-fill fs-4"></i>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Corte</span>
                    </div>
                    <h3 class="display-6 fw-bold mb-1">@CuantosDiasCorte</h3>
                    <p class="card-text text-muted small">Días restantes para corte/suspensión de servicio.</p>
                </div>
            </div>
        </div>

        <!-- Mantenimiento -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                            <i class="bi bi-gear-fill fs-4"></i>
                        </div>
                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1">Mantenimiento</span>
                    </div>
                    <h3 class="display-6 fw-bold mb-1">@CuantosDiasMantenimiento</h3>
                    <p class="card-text text-muted small">Días restantes para mantenimiento preventivo.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alarmas e Info General -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h5 class="card-title fw-bold text-primary mb-0">Consumos y Desperdicio</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-3">
                        <div>
                            <span class="fw-medium d-block">Seguimiento de desperdicio:</span>
                            <small class="text-muted">de @totalActivePredios predios activos</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-danger fs-6 px-3">@desperdicioCount</span>
                        </div>
                    </div>
                    <button @onclick="async () => await ToggleDesperdicio()" class="btn btn-outline-primary btn-sm w-100 py-2">
                        <i class="bi bi-list-check me-2"></i>Ver / Quitar alerta desperdicio
                    </button>
                    
                    @if (showDesperdicioDetails)
                    {
                        <div class="mt-3 border-top pt-3">
                            <DesperdicioAlertHome @ref="desperdicioRef" />
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-lg-6">
            <ReporteTipoConsumoComponent />
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <SeguimientoComponent />
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Historical Data -->
    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-graph-up me-2"></i>Consumos Bimestrales Totales</h5>
                </div>
                <div class="card-body">
                    <div class="chart-wrapper" style="height:320px; position: relative;">
                        <canvas id="consumoChart" name="consumoChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 pt-4">
                    <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-wallet2 me-2"></i>Recaudo Diario del Bimestre</h5>
                </div>
                <div class="card-body">
                    @if (id_planilla_siguiente != null) {
                        <RecaudoDiarioBimestreComponent PlanillaId="@id_planilla_siguiente" />
                    } else {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                            No hay información de planilla siguiente disponible.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<br />
<br />
<br />
@code {
    private const int MaxPeriodos = 10; // Limitar a los últimos 10 periodos
    private int CuantosDiasConsumos = 0;
    private int CuantosDiasPago = 0;
    private int CuantosDiasCorte = 0;
    private int CuantosDiasMantenimiento = 0;
    private List<ConsumoPorPeriodo> consumosPorPeriodo = new List<ConsumoPorPeriodo>();
    private string id_planilla_actual;
    private string id_planilla_siguiente;
    private int desperdicioCount = 0;
    private int totalActivePredios = 0;
    private bool showDesperdicioDetails = false;
    private DesperdicioAlertHome? desperdicioRef;

    protected override async Task OnInitializedAsync()
    {
        await DeterminarPlanillaActual();
    }


    private async Task DeterminarPlanillaActual()
    {
        using var context = DbFactory.CreateDbContext();

        // Obtener la planilla correspondiente al bimestre actual
        var fechaActual = DateTime.Now;
        var planillaActual = await context.Planillas
            .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                        p.FechaHoraRegistroConsumo < fechaActual) // Bimestre actual
            .OrderByDescending(p => p.FechaHoraRegistroConsumo) // Asegurarse de obtener la más reciente
            .FirstOrDefaultAsync();

        id_planilla_actual = planillaActual?.Idplanilla ?? "No disponible";
        if (planillaActual != null)
        {
            // Obtener la planilla del siguiente período
            var planillaSiguiente = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                            p.FechaHoraRegistroConsumo > planillaActual.FechaHoraRegistroConsumo) // Siguiente período
                .OrderBy(p => p.FechaHoraRegistroConsumo) // Obtener la más cercana
                .FirstOrDefaultAsync();

            if (planillaSiguiente != null)
            {
                id_planilla_siguiente = planillaSiguiente.Idplanilla;
                var hoy = DateOnly.FromDateTime(fechaActual);

                // Calcular CuantosDiasConsumos
                if (planillaSiguiente?.FechaHoraRegistroConsumo != null)
                {
                    CuantosDiasConsumos = (planillaSiguiente.FechaHoraRegistroConsumo.Value - fechaActual).Days + 1;
                }

                // Calcular CuantosDiasPago
                if (planillaSiguiente.FechaLimitePago != null)
                {
                    CuantosDiasPago = Math.Max(0, (planillaSiguiente.FechaLimitePago.Value.DayNumber - hoy.DayNumber) + 1);
                }
                // Calcular CuantosDiasCorte
                if (planillaSiguiente.FechaSuspension != null)
                {
                    CuantosDiasCorte = Math.Max(0, (planillaSiguiente.FechaSuspension.Value.DayNumber - hoy.DayNumber) + 1);
                }
            }
            else
            {
                CuantosDiasConsumos = 0;
                CuantosDiasPago = 0;
            }

            // Calcular CuantosDiasMantenimiento: fecha del trabajo más próximo en el futuro
            var trabajoProximo = await context.Trabajos
                .Where(t => t.FechaInicio.HasValue && t.FechaInicio > fechaActual)
                .OrderBy(t => t.FechaInicio)
                .FirstOrDefaultAsync();

            if (trabajoProximo != null && trabajoProximo.FechaInicio.HasValue)
            {
                CuantosDiasMantenimiento = (trabajoProximo.FechaInicio.Value - fechaActual).Days + 1;
            }
            else
            {
                CuantosDiasMantenimiento = 0; // No hay trabajos próximos
            }
        }
        // Resumen de desperdicio provisto por DesperdicioAlert
        try
        {
            if (desperdicioRef is not null)
            {
                var summary = await desperdicioRef.GetSummaryAsync();
                desperdicioCount = summary.Count;
                totalActivePredios = summary.Total;
            }
        }
        catch
        {
            // keep previous values on error
        }
    }

    private async Task ToggleDesperdicio()
    {
        showDesperdicioDetails = !showDesperdicioDetails;

        if (showDesperdicioDetails)
        {
            await Task.Delay(1); // deja que renderice

            if (desperdicioRef is not null)
            {
                var summary = await desperdicioRef.GetSummaryAsync();
                desperdicioCount = summary.Count;
                totalActivePredios = summary.Total;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            using var context = DbFactory.CreateDbContext();
            consumosPorPeriodo = await context.Facturacions
                .Include(f => f.IdplanillaNavigation)
                .ThenInclude(p => p.IdperiodoNavigation)
                .GroupBy(f => f.IdplanillaNavigation.Descripcion)
                .Select(g => new ConsumoPorPeriodo
                    {
                        Periodo = g.Key,
                        TotalConsumoM3 = g.Sum(f => f.ConsumoM3 ?? 0)
                    })
                .OrderByDescending(c => c.Periodo)
                .Take(MaxPeriodos)
                .ToListAsync();

            consumosPorPeriodo.Reverse();

            await JS.InvokeVoidAsync("renderConsumoChart", consumosPorPeriodo);
        }
    }

    public class ConsumoPorPeriodo
    {
        public string Periodo { get; set; }
        public double TotalConsumoM3 { get; set; }
    }
}

