@page "/tipos/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Tipo</h2>
    <hr />
    @if (tipo is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@tipo.Nombre</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@tipo.Descripcion</dd>
        </dl>
        <EditForm method="post" Model="tipo" OnValidSubmit="DeleteTipo" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(tipo is null)">Delete</button> |
            <a href="/tipos">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Tipo? tipo;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tipo = await context.Tipos.FirstOrDefaultAsync(m => m.Id == Id);

        if (tipo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTipo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Tipos.Remove(tipo!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipos");
    }
}
