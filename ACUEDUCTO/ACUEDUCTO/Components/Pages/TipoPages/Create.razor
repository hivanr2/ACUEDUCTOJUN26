@page "/tipos/create"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Tipo</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Tipo" OnValidSubmit="AddTipo" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre:</label> 
                <InputText id="nombre" @bind-Value="Tipo.Nombre" class="form-control" /> 
                <ValidationMessage For="() => Tipo.Nombre" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="descripcion" class="form-label">Descripcion:</label> 
                <InputText id="descripcion" @bind-Value="Tipo.Descripcion" class="form-control" /> 
                <ValidationMessage For="() => Tipo.Descripcion" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/tipos">Back to List</a>
</div>

@code {
    public Tipo Tipo { get; set; } = new();

    private async Task AddTipo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Tipos.Add(Tipo);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipos");
    }
}
