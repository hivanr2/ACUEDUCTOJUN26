@page "/movimientocajas/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>MovimientoCaja</h2>
    <hr />
    @if (movimientocaja is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">FechaHora</dt>
            <dd class="col-sm-10">@movimientocaja.FechaHora</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Iddocumento</dt>
            <dd class="col-sm-10">@movimientocaja.Iddocumento</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Entrada</dt>
            <dd class="col-sm-10">@movimientocaja.Entrada</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Salida</dt>
            <dd class="col-sm-10">@movimientocaja.Salida</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Saldo</dt>
            <dd class="col-sm-10">@movimientocaja.Saldo</dd>
        </dl>
        <EditForm method="post" Model="movimientocaja" OnValidSubmit="DeleteMovimientoCaja" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(movimientocaja is null)">Delete</button> |
            <a href="/movimientocajas">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private MovimientoCaja? movimientocaja;

    [SupplyParameterFromQuery]
    private int Idmov { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        movimientocaja = await context.MovimientoCajas.FirstOrDefaultAsync(m => m.Idmov == Idmov);

        if (movimientocaja is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteMovimientoCaja()
    {
        using var context = DbFactory.CreateDbContext();
        context.MovimientoCajas.Remove(movimientocaja!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/movimientocajas");
    }
}
