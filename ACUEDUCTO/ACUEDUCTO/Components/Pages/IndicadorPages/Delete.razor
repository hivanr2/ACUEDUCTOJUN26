@page "/indicadors/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Indicador</h2>
    <hr />
    @if (indicador is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Categoría</dt>
            <dd class="col-sm-10">@indicador.Categoría</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Responsable</dt>
            <dd class="col-sm-10">@indicador.Responsable</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@indicador.Descripcion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FórmulaUnidad</dt>
            <dd class="col-sm-10">@indicador.FórmulaUnidad</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Frecuencia</dt>
            <dd class="col-sm-10">@indicador.Frecuencia</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">MetaUmbral</dt>
            <dd class="col-sm-10">@indicador.MetaUmbral</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">SemáforoGestión</dt>
            <dd class="col-sm-10">@indicador.SemáforoGestión</dd>
        </dl>
        <EditForm method="post" Model="indicador" OnValidSubmit="DeleteIndicador" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(indicador is null)">Delete</button> |
            <a href="/indicadors">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Indicador? indicador;

    [SupplyParameterFromQuery]
    private int Idindicador { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        indicador = await context.Indicadores.FirstOrDefaultAsync(m => m.Idindicador == Idindicador);

        if (indicador is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteIndicador()
    {
        using var context = DbFactory.CreateDbContext();
        context.Indicadores.Remove(indicador!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/indicadors");
    }
}
