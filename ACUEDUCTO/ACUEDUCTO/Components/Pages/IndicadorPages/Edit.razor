@page "/indicadors/edit"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Editar indicador</PageTitle>

<div class="container py-2">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <h1 class="h5 mb-0">Editar indicador</h1>
            <small class="text-muted">Actualiza los datos del indicador</small>
        </div>
        <div>
            <a class="btn btn-secondary" href="/indicadors">Volver</a>
        </div>
    </div>

@if (Indicador is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm method="post" Model="Indicador" OnValidSubmit="UpdateIndicador" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Indicador.Idindicador" value="@Indicador.Idindicador" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label for="categoría" class="form-label">Categoría</label>
                        <InputText id="categoría" @bind-Value="Indicador.Categoría" class="form-control" />
                        <ValidationMessage For="() => Indicador.Categoría" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="responsable" class="form-label">Responsable</label>
                        <InputText id="responsable" @bind-Value="Indicador.Responsable" class="form-control" />
                        <ValidationMessage For="() => Indicador.Responsable" class="text-danger" />
                    </div>
                    <div class="col-12">
                        <label for="descripción" class="form-label">Descripcion</label>
                        <InputText id="descripción" @bind-Value="Indicador.Descripcion" class="form-control" />
                        <ValidationMessage For="() => Indicador.Descripcion" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="fórmulaunidad" class="form-label">Fórmula/Unidad</label>
                        <InputText id="fórmulaunidad" @bind-Value="Indicador.FórmulaUnidad" class="form-control" />
                        <ValidationMessage For="() => Indicador.FórmulaUnidad" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="frecuencia" class="form-label">Frecuencia</label>
                        <InputText id="frecuencia" @bind-Value="Indicador.Frecuencia" class="form-control" />
                        <ValidationMessage For="() => Indicador.Frecuencia" class="text-danger" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="metaumbral" class="form-label">Meta/Umbral</label>
                        <InputText id="metaumbral" @bind-Value="Indicador.MetaUmbral" class="form-control" />
                        <ValidationMessage For="() => Indicador.MetaUmbral" class="text-danger" />
                    </div>
                    <div class="col-12">
                        <label for="semáforogestión" class="form-label">Semáforo de gestión</label>
                        <InputText id="semáforogestión" @bind-Value="Indicador.SemáforoGestión" class="form-control" />
                        <ValidationMessage For="() => Indicador.SemáforoGestión" class="text-danger" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a class="btn btn-light" href="/indicadors">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

</div>

@code {
    [SupplyParameterFromQuery]
    private int Idindicador { get; set; }

    [SupplyParameterFromForm]
    private Indicador? Indicador { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Indicador ??= await context.Indicadores.FirstOrDefaultAsync(m => m.Idindicador == Idindicador);

        if (Indicador is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task UpdateIndicador()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Indicador!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!IndicadorExists(Indicador!.Idindicador))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/indicadors");
    }

    private bool IndicadorExists(int idindicador)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Indicadores.Any(e => e.Idindicador == idindicador);
    }
}
