@page "/tipostrabajos/edit"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>TiposTrabajo</h2>
<hr />
@if (TiposTrabajo is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="TiposTrabajo" OnValidSubmit="UpdateTiposTrabajo" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="TiposTrabajo.IdTipoTrabajo" value="@TiposTrabajo.IdTipoTrabajo" />
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre:</label>
                    <InputText id="nombre" @bind-Value="TiposTrabajo.Nombre" class="form-control" />
                    <ValidationMessage For="() => TiposTrabajo.Nombre" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="descripcion" class="form-label">Descripcion:</label>
                    <InputText id="descripcion" @bind-Value="TiposTrabajo.Descripcion" class="form-control" />
                    <ValidationMessage For="() => TiposTrabajo.Descripcion" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/tipostrabajos">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int IdTipoTrabajo { get; set; }

    [SupplyParameterFromForm]
    private TiposTrabajo? TiposTrabajo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        TiposTrabajo ??= await context.TiposTrabajos.FirstOrDefaultAsync(m => m.IdTipoTrabajo == IdTipoTrabajo);

        if (TiposTrabajo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateTiposTrabajo()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(TiposTrabajo!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!TiposTrabajoExists(TiposTrabajo!.IdTipoTrabajo))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/tipostrabajos");
    }

    private bool TiposTrabajoExists(int idtipotrabajo)
    {
        using var context = DbFactory.CreateDbContext();
        return context.TiposTrabajos.Any(e => e.IdTipoTrabajo == idtipotrabajo);
    }
}
