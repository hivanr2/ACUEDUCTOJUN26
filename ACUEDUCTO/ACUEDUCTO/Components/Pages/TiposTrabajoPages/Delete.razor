@page "/tipostrabajos/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>TiposTrabajo</h2>
    <hr />
    @if (tipostrabajo is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@tipostrabajo.Nombre</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@tipostrabajo.Descripcion</dd>
        </dl>
        <EditForm method="post" Model="tipostrabajo" OnValidSubmit="DeleteTiposTrabajo" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(tipostrabajo is null)">Delete</button> |
            <a href="/tipostrabajos">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private TiposTrabajo? tipostrabajo;

    [SupplyParameterFromQuery]
    private int IdTipoTrabajo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        tipostrabajo = await context.TiposTrabajos.FirstOrDefaultAsync(m => m.IdTipoTrabajo == IdTipoTrabajo);

        if (tipostrabajo is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteTiposTrabajo()
    {
        using var context = DbFactory.CreateDbContext();
        context.TiposTrabajos.Remove(tipostrabajo!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipostrabajos");
    }
}
