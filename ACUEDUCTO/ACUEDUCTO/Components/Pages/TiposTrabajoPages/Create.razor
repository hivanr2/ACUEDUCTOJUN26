@page "/tipostrabajos/create"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Crear Tipos Trabajos</PageTitle>

<h1>Crear Tipos Trabajos</h1>

<h2>Tipos Trabajo</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="TiposTrabajo" OnValidSubmit="AddTiposTrabajo" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre:</label> 
                <InputText id="nombre" @bind-Value="TiposTrabajo.Nombre" class="form-control" /> 
                <ValidationMessage For="() => TiposTrabajo.Nombre" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="descripcion" class="form-label">Descripcion:</label> 
                <InputText id="descripcion" @bind-Value="TiposTrabajo.Descripcion" class="form-control" /> 
                <ValidationMessage For="() => TiposTrabajo.Descripcion" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/tipostrabajos">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private TiposTrabajo TiposTrabajo { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTiposTrabajo()
    {
        using var context = DbFactory.CreateDbContext();
        context.TiposTrabajos.Add(TiposTrabajo);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipostrabajos");
    }
}
