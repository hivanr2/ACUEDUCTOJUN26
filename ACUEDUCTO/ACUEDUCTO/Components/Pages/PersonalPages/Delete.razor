@page "/personals/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Personal</h2>
    <hr />
    @if (personal is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@personal.Nombre</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Cargo</dt>
            <dd class="col-sm-10">@personal.Cargo</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Usuario</dt>
            <dd class="col-sm-10">@personal.Usuario</dd>
        </dl>
        <EditForm method="post" Model="personal" OnValidSubmit="DeletePersonal" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(personal is null)">Delete</button> |
            <a href="/personals">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Personal? personal;

    [SupplyParameterFromQuery]
    private int IdPersonal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        personal = await context.Personals.FirstOrDefaultAsync(m => m.IdPersonal == IdPersonal);

        if (personal is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeletePersonal()
    {
        using var context = DbFactory.CreateDbContext();
        context.Personals.Remove(personal!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/personals");
    }
}
