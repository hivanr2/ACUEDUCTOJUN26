@page "/planillas/recaudocomponent"
@layout SimpleLayout
@using ACUEDUCTO.Components.Layout
@using ACUEDUCTO.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<AcueductoContext> DbFactory
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Env
@inject Microsoft.Extensions.Logging.ILogger<RecaudoComponent> Logger
@rendermode InteractiveServer

<div class="container-fluid py-2 py-md-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
            @if (facturacion != null && facturacion.Count == 1)
            {
                @if (@id_planilla_anterior != "No disponible")
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/planillas/recaudocomponent?id=@id_planilla_anterior" target="_self" title="Anterior">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                }
            }
            <h3 class="h5 mb-0">RECAUDO :: @str_planilla</h3>
            @if (facturacion != null && facturacion.Count == 1)
            {
                @if (@id_planilla_siguiente != "No disponible")
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/planillas/recaudocomponent?id=@id_planilla_siguiente" target="_self" title="Siguiente">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            }
        </div>
        <div class="text-nowrap d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border">Periodo: <strong>@str_periodo_largo</strong></span>
        </div>
    </div>

    @if (!editaPlanilla)
    {
        <div class="alert alert-warning py-2 mb-2 text-center">
            La planilla está cerrada. La edición está deshabilitada.
        </div>
    }

    <div class="card shadow-sm mb-2">
        <div class="card-body py-2">
            <div class="row g-3 align-items-center">
                @if (mostrar)
                {

                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center gap-2">
                            <div class="small text-muted">Índice de Recaudo</div>
                            <span class="badge rounded-pill bg-primary">
                                @indiceRecaudo%
                            </span>
                        </div>
                        <div class="progress mt-1" role="progressbar" aria-valuenow="@indiceRecaudo" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                            <div class="progress-bar" style="width:@indiceRecaudo%"></div>
                        </div>
                    </div>
                }
                <div class="col-12 col-md-6">
                    <div class="d-flex flex-wrap align-items-center gap-3 justify-content-md-end">
                        <div class="form-check form-switch">
                            <input id="verTodas" class="form-check-input" type="checkbox" @bind="verTodas" @bind:after="OnVerTodasChanged" />
                            <label for="verTodas" class="form-check-label">Ver Todas</label>
                        </div>
                        <div class="form-check form-switch">
                            <input id="filtraNopago" class="form-check-input" type="checkbox" @bind="filtraNopago" @bind:after="OnFiltraNopagoChanged" />
                            <label for="filtraNopago" class="form-check-label">No pago</label>
                        </div>
                        @if (facturacion?.Count == 1)
                        {
                            <div class="form-check form-switch">
                                <input id="editarRecaudo" class="form-check-input" type="checkbox" @bind="editaRecaudo" disabled="@(!editaPlanilla)" />
                                <label for="editarRecaudo" class="form-check-label">Edita Recaudo</label>
                            </div>
                            <div class="form-check form-switch">
                                <input id="editarObservaciones" class="form-check-input" type="checkbox" @bind="editarObservaciones" disabled="@(!editaPlanilla)" />
                                <label for="editarObservaciones" class="form-check-label">Editar Observaciones Predio</label>
                            </div>
                        }
                        <div class="input-group input-group-sm" style="width: 180px;">
                            <input id="filtroNombrePredio" class="form-control" placeholder="Filtrar predio" @bind="filtroNombrePredio" @bind:event="oninput" @bind:after="OnFiltroNombrePredioChanged" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroNombrePredio" title="Limpiar filtro">×</button>
                        </div>
                        <div class="input-group input-group-sm" style="width: 140px;">
                            <input id="filtroCodigoUsuario" class="form-control" placeholder="Filtrar código" @bind="filtroCodigoUsuario" @bind:event="oninput" @bind:after="OnFiltroCodigoUsuarioChanged" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroCodigoUsuario" title="Limpiar filtro">×</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @if (facturacion == null)
    {
        <div>Cargando...</div>
    }
    else
    {
        if (facturacion.Count > 0)
        {
            if (!string.IsNullOrWhiteSpace(facturacion.FirstOrDefault()?.CodigoFactura))
            {
                HayFacturas = true;
            }

            <div class="table-container table-responsive">
                <table class="table table-sm table-hover table-striped align-middle fixed-header">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="text-center" style="min-width:120px;">It</th>
                            <th scope="col" style="min-width:280px;">Predio</th>
                            <th scope="col">Código</th>
                            @if (editaPlanilla && editaValores)
                            {
                                @foreach (var header in new[] { "Consumo M3", "Valor Consumo", "Cargo Fijo", "% Sobretasa", "Valor Sobretasa", "% Mora", "Valor Mora", "% Subsidio", "Valor Subsididio" })
                                {
                                    <th scope="col">@header</th>
                                }
                            }
                            <th scope="col">Otros Valores</th>
                            <th scope="col">Valor Periodo</th>
                            <th scope="col" class="border-blue">Deuda Anterior</th>
                            <th scope="col" class="border-blue">Recaudo Bimestre</th>
                            <th scope="col">Deuda Pasa</th>
                            @if (editarObservaciones)
                            {
                                <th scope="col">Observaciones Predio</th>
                            }
                            <th scope="col">Notas Factura</th>
                            <th scope="col">Notas Recaudo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < facturacion.Count; i++)
                        {
                            var factura = facturacion[i];
                            <tr>
                                <td class="text-center">
                                    <div>@(i + 1)</div>
                                    <div class="btn-group btn-group-sm mt-1" role="group">
                                        <a class="btn btn-outline-secondary" href="/facturacion/edit?id=@factura.Idfactura" target="_blank" title="Editar factura"><i class="bi bi-pencil"></i></a>
                                        @if (HayFacturas && hasFacturaPdf.TryGetValue(factura.Idfactura, out var hasPdf) && hasPdf)
                                        {
                                            @if (editaRecaudo)
                                            {
                                                <button class="btn btn-outline-primary" title="Imprimir / Ver (modo edición)" @onclick="() => OpenFacturaImprimir(factura.Idfactura)">
                                                    <i class="bi bi-file-earmark"></i> Ver Factura
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary" title="Ver Factura" @onclick="() => VerFactura(factura)"><i class="bi bi-file-earmark"></i> Ver Factura</button>
                                            }
                                        }
                                        @if (Math.Abs(factura.RecaudoPeriodoTotal ?? 0) > 0)
                                        {
                                            if ((i == 1 || facturacion.Count == 1) && editaRecaudo)
                                            {
                                                <button class="btn btn-outline-secondary" title="Ver Recibo" @onclick="() => VerReciboSmart(factura)">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    Crear Recibo
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-secondary" title="Ver Recibo" @onclick="() => VerReciboSmart(factura)">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                    Ver Recibo
                                                </button>

                                            }
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@factura.IdpredioNavigation.ApellidosNombresUsuario</div>
                                    <div><a class="small" href="/predios/details?idpredio=@factura.Idpredio" target="_blank">Ver predio</a></div>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-link p-0 text-decoration-underline" title="Filtrar por código" @onclick="() => FiltrarPorCodigo(factura.CodigoUsuario ?? string.Empty)">@factura.CodigoUsuario</button>
                                </td>
                                @if (editaPlanilla && editaValores)
                                {
                                    <td>@factura.ConsumoM3</td>
                                    <td>@FormatCurrency(factura.ValorConsumo)</td>
                                    <td>
                                        @factura.CargoFijo
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.CargoFijo" @onchange="async (e) => await OnCargoFijoChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @factura.PorcentajeSobreTasa
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.PorcentajeSobreTasa" @onchange="async (e) => await OnPorcentajeSobreTasaChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @FormatCurrency(factura.ValorSobreTasa)
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.ValorSobreTasa" @onchange="async (e) => await OnValorSobreTasaChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @factura.PorcentajeMora
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.PorcentajeMora" @onchange="async (e) => await OnPorcentajeMoraChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @FormatCurrency(factura.ValorMora)
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.ValorMora" @onchange="async (e) => await OnValorMoraChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @factura.PorcentajeSubsidio
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.PorcentajeSubsidio" @onchange="async (e) => await OnPorcentajeSubsidioChanged(factura, e)" />
                                    </td>
                                    <td>
                                        @FormatCurrency(factura.ValorSubsidio)
                                        <input type="number" class="form-control form-control-sm mt-1" value="@factura.ValorSubsidio" @onchange="async (e) => await OnValorSubsidioChanged(factura, e)" />
                                    </td>
                                }
                                <td>
                                    <div class="h6 mb-1">@FormatCurrency(factura.OtrosValores)</div>
                                    @if (editaPlanilla && editaRecaudo)
                                    {
                                        <input type="number" class="form-control form-control-sm" @bind="factura.OtrosValores" @bind:after="async () => await OnOtrosValoresChanged(factura)" tabindex="@((i * 1000) + 2)" />
                                    }
                                </td>
                                <td>@FormatCurrency(factura.ValorPeriodo)</td>
                                <td class="border-blue">
                                    <div class="h6 mb-1">@FormatCurrency(factura.DeudaAnterior)</div>
                                </td>
                                <td class="border-blue">
                                    <div class="h6 mb-1">@FormatCurrency(factura.RecaudoPeriodoTotal)</div>
                                    @if (editaPlanilla && editaRecaudo)
                                    {
                                        <input type="number" class="form-control form-control-sm" @bind="factura.RecaudoPeriodoTotal" @bind:after="async () => await OnRecaudoPeriodoTotalChanged(factura)" />
                                    }
                                </td>
                                <td>@FormatCurrency(factura.DeudaPasa)</td>
                                @if (editarObservaciones)
                                {
                                    <td>
                                        <div class="small text-muted">@factura.IdpredioNavigation.Observaciones</div>
                                        <textarea class="form-control form-control-sm mt-1" value="@factura.IdpredioNavigation.Observaciones" @onchange="async (e) => await OnObservacionesPredioChanged(factura, e)" tabindex="@((i * 1000) + 4)"></textarea>
                                    </td>
                                }
                                <td>
                                    <div class="small">@((string.IsNullOrWhiteSpace(factura.NotasFactura) && (factura.RecaudoPeriodoTotal ?? 0) == 0) ? $"SIN RECAUDO EN EL BIMESTRE {str_periodo_corto}" : factura.NotasFactura)</div>
                                    @if (editaPlanilla && editaRecaudo)
                                    {
                                        <textarea class="form-control form-control-sm mt-1" value="@factura.NotasFactura" @onchange="async (e) => await OnNotasFacturaChanged(factura, e)" tabindex="@((i * 1000) + 4)"></textarea>
                                    }
                                </td>

                                <td>
                                    <div class="small">@((string.IsNullOrWhiteSpace(factura.NotasRecaudo) && (factura.RecaudoPeriodoTotal ?? 0) == 0) ? $"SIN RECAUDO EN EL BIMESTRE {str_periodo_corto}" : factura.NotasRecaudo)</div>
                                    @if (editaPlanilla && editaRecaudo)
                                    {
                                        <textarea class="form-control form-control-sm mt-1" value="@factura.NotasRecaudo" @onchange="async (e) => await OnNotasRecaudoChanged(factura, e)" tabindex="@((i * 1000) + 5)"></textarea>
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="table-secondary fw-semibold">
                            @if (editaRecaudo && editaValores)
                            {
                                <td colspan="9"></td>
                            }
                            <td colspan="3" class="text-end">Totales</td>
                            <td class="text-center">@FormatCurrency(facturacion.Sum(f => f.OtrosValores ?? 0))</td>
                            <td class="text-center">@FormatCurrency(facturacion.Sum(f => f.ValorPeriodo ?? 0))</td>
                            <td class="text-center border-blue">@FormatCurrency(facturacion.Sum(f => f.DeudaAnterior ?? 0))</td>
                            <td class="text-center border-blue">@FormatCurrency(facturacion.Sum(f => f.RecaudoPeriodoTotal ?? 0))</td>
                            <td class="text-center">@FormatCurrency(facturacion.Sum(f => f.DeudaPasa ?? 0))</td>
                            <td colspan="2"></td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <style>
                .table-container {
                    max-height: 70vh;
                    overflow: auto;
                }

                .fixed-header thead th, .fixed-header thead td {
                    position: sticky;
                    top: 0;
                    background-color: var(--bs-light);
                    z-index: 5;
                }

                .border-blue {
                    border: 1px solid #007bff;
                    border-radius: 4px;
                }
            </style>

        }
        else
        {
            <div class="alert alert-info">Poner letras de ApellidosNombres o el codigo</div>
        }
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string id { get; set; }
    [SupplyParameterFromQuery]
    private string codigo { get; set; }
    [SupplyParameterFromQuery]
    private string usuario { get; set; }
    private bool abrirEnModoEdicionPorCodigo = false;
    private IList<Facturacion> facturacion;
    private bool HayFacturas { get; set; } = false;
    private Dictionary<string, bool> hasFacturaPdf = new();
    private string str_planilla;
    private string id_planilla_siguiente;
    private string id_planilla_anterior;
    private string str_periodo_corto;
    private string str_periodo_largo;
    private string errorMessage;
    private double indiceRecaudo = 0;
    private bool editarObservaciones = false;
    private bool editaRecaudo = false;
    private bool editaValores = false;
    private bool editaPlanilla = false;
    private bool filtraNopago = false;
    private string filtroNombrePredio = string.Empty;
    private string filtroCodigoUsuario = string.Empty;
    private System.Threading.CancellationTokenSource? _filtroCts;
    private DateTime? FechaTomaConsumoPlanilla;
    private DateOnly? FechaUltimoPagoPlanilla;
    private DateOnly? FechaSuspensionPlanilla;
    private bool mostrar = true;
    private IList<Tarifa> tarifas;
    private bool showFullTemporary = false;
    private bool lastHasAnyFilter = false;
    private bool verTodas = false;

    private Dictionary<string, int> _reciboNumeroPorFactura = new();

    private double totalValorPeriodoAnterior;

    protected override async Task OnInitializedAsync() => await LoadData();
    protected override async Task OnParametersSetAsync()
    {
        // If a 'codigo' query parameter is provided, apply it to the codigo filter so the page shows filtered results.
        if (!string.IsNullOrWhiteSpace(codigo))
        {
            // Existing behavior: open in edit mode and prefill recaudo faltante
            filtroCodigoUsuario = codigo;
            abrirEnModoEdicionPorCodigo = true;
        }
        else if (!string.IsNullOrWhiteSpace(usuario))
        {
            // New behavior: open filtered by usuario in read-only mode
            filtroCodigoUsuario = usuario;
            abrirEnModoEdicionPorCodigo = false;
            // ensure editing is disabled when arriving via 'usuario'
            editaRecaudo = false;
        }
        else
        {
            abrirEnModoEdicionPorCodigo = false;
        }
        await LoadData();
    }

    private async Task VerReciboSmart(Facturacion factura)
    {
        if (factura == null) { errorMessage = "Factura no encontrada"; return; }

        // Update notes if there is recaudo (positive or negative for anticipos)
        if (Math.Abs(factura.RecaudoPeriodoTotal ?? 0) > 0)
        {
            try
            {
                using var ctx = DbFactory.CreateDbContext();
                var f = await ctx.Facturacions.FirstOrDefaultAsync(x => x.Idfactura == factura.Idfactura);
                if (f != null)
                {
                    var recaudoVal = f.RecaudoPeriodoTotal ?? (factura.RecaudoPeriodoTotal ?? 0);
                    var deudaPrev = f.DeudaAnterior ?? 0;
                    var nowText = DateTime.Now.ToString("g", new CultureInfo("es-CO"));

                    var noteFacturaReplacement = "GRACIAS POR SU PAGO";
                    var noteRecaudoReplacement = BuildNotaRecaudo(recaudoVal, deudaPrev, nowText);

                    if (string.IsNullOrWhiteSpace(f.NotasFactura))
                    {
                        f.NotasFactura = noteFacturaReplacement;
                    }
                    else
                    {
                        var updatedFacturaNotes = ReplacePlaceholderSegment(f.NotasFactura, "SIN RECAUDO EN EL BIMESTRE", noteFacturaReplacement);
                        updatedFacturaNotes = ReplacePlaceholderSegment(updatedFacturaNotes, "SIN RECAUDO EN BIMESTRE", noteFacturaReplacement);
                        f.NotasFactura = updatedFacturaNotes;
                    }

                    if (string.IsNullOrWhiteSpace(f.NotasRecaudo))
                    {
                        f.NotasRecaudo = noteRecaudoReplacement;
                    }
                    else
                    {
                        f.NotasRecaudo = ReplacePlaceholderSegment(f.NotasRecaudo, "SIN RECAUDO EN EL BIMESTRE", noteRecaudoReplacement);
                    }

                    ctx.Facturacions.Update(f);
                    await ctx.SaveChangesAsync();

                    // Update local model to reflect changes
                    factura.NotasFactura = f.NotasFactura;
                    factura.NotasRecaudo = f.NotasRecaudo;
                }
            }
            catch
            {
                // Ignore DB errors to not block opening recibo
            }
        }

        // Open recibo in new window
        try
        {
            var noteRecaudo = string.Empty;
            var noteFactura = string.Empty;
            try { noteRecaudo = Uri.EscapeDataString(factura.NotasRecaudo ?? string.Empty); } catch { }
            try { noteFactura = Uri.EscapeDataString(factura.NotasFactura ?? string.Empty); } catch { }
            var ts = DateTime.UtcNow.Ticks;
            var url = $"/recibos/details?idfactura={factura.Idfactura}&from=recaudo&noteRecaudo={noteRecaudo}&noteFactura={noteFactura}&ts={ts}";
            await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
        catch
        {
            var url = $"/recibos/details?idfactura={factura.Idfactura}&from=recaudo";
            await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }

    // Replace only the placeholder text portion, preserving any text before or after it.
    private string ReplacePlaceholderSegment(string original, string placeholderStart, string replacement)
    {
        if (string.IsNullOrEmpty(original)) return original;

        int idx = original.IndexOf(placeholderStart, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return original;

        int start = idx;
        int end = FindPlaceholderEnd(original, idx);
        if (end <= start) return original;

        var before = original.Substring(0, start);
        var after = end < original.Length ? original.Substring(end) : string.Empty;
        return before + replacement + after;
    }

    private int FindPlaceholderEnd(string original, int startIdx)
    {
        // Consume until a separator that is part of the surrounding note, not the placeholder.
        // We stop at: " - ", new line, or end of string.
        int end = original.Length;
        int sep1 = original.IndexOf(" - ", startIdx, StringComparison.Ordinal);
        if (sep1 > startIdx) end = Math.Min(end, sep1);
        int nl = original.IndexOf('\n', startIdx);
        if (nl > startIdx) end = Math.Min(end, nl);
        int cr = original.IndexOf('\r', startIdx);
        if (cr > startIdx) end = Math.Min(end, cr);

        // Also include trailing " (....)" if it is immediately attached to the placeholder text.
        int i = startIdx;
        while (i < end)
        {
            if (original[i] == '(')
            {
                int close = original.IndexOf(')', i + 1);
                if (close > i)
                {
                    end = Math.Min(end, close + 1);
                }
                break;
            }
            i++;
        }

        // Trim trailing spaces from the placeholder segment only.
        while (end > startIdx && char.IsWhiteSpace(original[end - 1])) end--;
        return end;
    }

    private string BuildNotaRecaudo(double recaudoVal, double deudaPrev, string fechaHora)
    {
        var recaudoAbs = Math.Abs(recaudoVal);
        var sb = new System.Text.StringBuilder();
        sb.Append($"Recaudo ({fechaHora}) {FormatCurrency(recaudoVal)}");

        if (recaudoAbs < Math.Abs(deudaPrev))
        {
            var faltante = Math.Abs(deudaPrev) - recaudoAbs;
            sb.Append($" {FormatCurrency(faltante)} FALTANTE");
        }
        else if (recaudoAbs > Math.Abs(deudaPrev))
        {
            var anticipo = recaudoAbs - Math.Abs(deudaPrev);
            sb.Append($" {FormatCurrency(anticipo)} ANTICIPO");
        }
        else
        {
            sb.Append(" SALDADO");
        }

        sb.Append('.');
        return sb.ToString();
    }

    private async Task LoadData()
    {
        using var context = DbFactory.CreateDbContext();

        // Load planilla early so header and edit flags are available even when no filters are applied.
        var planillaActual = await context.Planillas.Where(p => p.Idplanilla == id).Include(c => c.IdperiodoNavigation).AsNoTracking().FirstOrDefaultAsync();
        editaPlanilla = planillaActual?.Abierta ?? false;
        FechaTomaConsumoPlanilla = planillaActual?.FechaHoraRegistroConsumo;
        FechaUltimoPagoPlanilla = planillaActual?.FechaLimitePago;
        FechaSuspensionPlanilla = planillaActual?.FechaSuspension;
        if (planillaActual != null)
        {
            str_planilla = planillaActual.Descripcion ?? "No hay planilla";
            str_periodo_corto = planillaActual.IdperiodoNavigation?.DescripcionCorta ?? "N/A";
            str_periodo_largo = planillaActual.IdperiodoNavigation?.DescripcionLarga ?? "N/A";
        }

        // Determine whether any filter is active
        var hasAnyFilter = verTodas || filtraNopago || !string.IsNullOrWhiteSpace(filtroNombrePredio) || !string.IsNullOrWhiteSpace(filtroCodigoUsuario);
        lastHasAnyFilter = hasAnyFilter;

        if (!hasAnyFilter)
        {
            // If we haven't shown the full list temporarily yet, allow one load so the user
            // can see the recaudation index for a few seconds. Subsequent loads without filters
            // will return an empty list.
            if (!showFullTemporary)
            {
                showFullTemporary = true;
                // proceed to load the full list this time
            }
            else
            {
                // We've already shown the full list temporarily; now hide
                facturacion = new List<Facturacion>();
                hasFacturaPdf.Clear();
                _reciboNumeroPorFactura.Clear();
                HayFacturas = false;
                editaRecaudo = false;
                editaValores = false;
                editarObservaciones = false;
                await PonerEnlacesAntesDespues();
                return;
            }
        }
        else
        {
            // A real filter is active — cancel the temporary full-list mode
            showFullTemporary = false;
        }

        var baseQuery = context.Facturacions.Where(f => f.Idplanilla == id);
        if (filtraNopago) baseQuery = baseQuery.Where(f => (f.RecaudoPeriodoTotal ?? 0) == 0);
        if (!string.IsNullOrWhiteSpace(filtroNombrePredio))
        {
            var pattern = $"%{filtroNombrePredio}%";
            baseQuery = baseQuery.Where(f => context.Predios.Any(p => p.Idpredio == f.Idpredio && p.ApellidosNombresUsuario != null && EF.Functions.Like(p.ApellidosNombresUsuario, pattern)));
        }
        if (!string.IsNullOrWhiteSpace(filtroCodigoUsuario))
        {
            var patternCode = $"%{filtroCodigoUsuario}%";
            baseQuery = baseQuery.Where(f => f.CodigoUsuario != null && EF.Functions.Like(f.CodigoUsuario, patternCode));
        }
        var facturasDb = await baseQuery.AsNoTracking().ToListAsync();
        var predioIds = facturasDb.Select(f => f.Idpredio).Distinct().ToList();
        var predios = await context.Predios.Where(p => predioIds.Contains(p.Idpredio)).AsNoTracking().ToDictionaryAsync(p => p.Idpredio, p => p);

        // Preload tarifas
        var tarifasList = await context.Tarifas.AsNoTracking().ToListAsync();
        this.tarifas = tarifasList;

        foreach (var f in facturasDb)
        {
            predios.TryGetValue(f.Idpredio, out var p);
            f.IdpredioNavigation = p;
            // Use in-memory recalculation to prepare display values only.
            // DO NOT call RecalcularValores here because it may persist changes and propagate deuda across planillas.
            await RecalcularValoresEnMemoria(f, tarifasList);
        }
        facturacion = facturasDb.OrderBy(f => f.IdpredioNavigation?.ApellidosNombresUsuario).ToList();

        // If the page was opened with a 'codigo' query parameter, prefill the recaudo
        // input with the amount needed to pay the previous debt and enable edit mode.
        if (!string.IsNullOrWhiteSpace(codigo) && facturacion.Any())
        {
            editaRecaudo = true;
            foreach (var f in facturacion)
            {
                var deudaPrev = f.DeudaAnterior ?? 0;
                var existente = f.RecaudoPeriodoTotal ?? 0;
                var faltante = Math.Max(0, deudaPrev - existente);
                if (faltante > 0)
                {
                    f.RecaudoPeriodoTotal = faltante;
                }
            }
        }

        // Do NOT modify factura notes or balances during listing. Placeholder text will be shown
        // in the UI without mutating the model. Actual persistence must happen only when records
        // are created or the user explicitly saves changes.

        // Check PDF existence for each factura
        hasFacturaPdf.Clear();
        foreach (var f in facturacion)
        {
            try
            {
                var codigoUsuarioSafe = Sanitize(f.CodigoUsuario ?? "usuario");
                var codigoFacturaSafe = Sanitize(f.CodigoFactura ?? "factura");
                var pdfPath = System.IO.Path.Combine(Env.WebRootPath ?? string.Empty, "imagenes", codigoUsuarioSafe, $"{codigoFacturaSafe}.pdf");
                hasFacturaPdf[f.Idfactura] = System.IO.File.Exists(pdfPath);
            }
            catch
            {
                hasFacturaPdf[f.Idfactura] = false;
            }
        }

        // Cargar números de recibo existentes por factura
        _reciboNumeroPorFactura.Clear();
        var facturaIds = facturasDb.Select(f => f.Idfactura).ToList();
        var ingresos = await context.Ingresos.Where(i => facturaIds.Contains(i.Idfactura)).Select(i => new { i.Idfactura, i.Numero }).AsNoTracking().ToListAsync();
        foreach (var ing in ingresos)
        {
            if (ing.Numero > 0 && !_reciboNumeroPorFactura.ContainsKey(ing.Idfactura))
                _reciboNumeroPorFactura[ing.Idfactura] = ing.Numero;
        }

        if (facturacion == null || facturacion.Count != 1) { editaRecaudo = false; editaValores = false; editarObservaciones = false; }
        if (planillaActual != null)
        {
            str_planilla = planillaActual.Descripcion ?? "No hay planilla";
            str_periodo_corto = planillaActual.IdperiodoNavigation?.DescripcionCorta ?? "N/A";
            str_periodo_largo = planillaActual.IdperiodoNavigation?.DescripcionLarga ?? "N/A";
            var planillaAnterior = await context.Planillas.Where(p => p.FechaHoraRegistroConsumo < planillaActual.FechaHoraRegistroConsumo).OrderByDescending(p => p.FechaHoraRegistroConsumo).AsNoTracking().FirstOrDefaultAsync();
            if (planillaAnterior != null)
            {
                // Calculate totals in one query
                var totalsAnterior = await context.Facturacions.Where(f => f.Idplanilla == planillaAnterior.Idplanilla).AsNoTracking()
                    .GroupBy(f => 1)
                    .Select(g => new { TotalValorPeriodo = g.Sum(f => f.ValorPeriodo ?? 0) })
                    .FirstOrDefaultAsync();
                var totalRecaudoActual = facturacion.Sum(f => f.RecaudoPeriodoTotal ?? 0);
                indiceRecaudo = totalsAnterior != null && totalsAnterior.TotalValorPeriodo > 0 ? Math.Round((totalRecaudoActual / totalsAnterior.TotalValorPeriodo) * 100, 0) : 0;
                this.totalValorPeriodoAnterior = totalsAnterior?.TotalValorPeriodo ?? 0;
            }
            await PonerEnlacesAntesDespues();
        }
    }

