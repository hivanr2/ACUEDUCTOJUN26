    private async Task PonerEnlacesAntesDespues()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var actual = await context.Planillas.FirstOrDefaultAsync(p => p.Idplanilla == id);
            if (actual == null) { id_planilla_anterior = "No disponible"; id_planilla_siguiente = "No disponible"; return; }
            var anterior = await context.Planillas.Where(p => p.FechaHoraRegistroConsumo < actual.FechaHoraRegistroConsumo)
                .OrderByDescending(p => p.FechaHoraRegistroConsumo).FirstOrDefaultAsync();
            var siguiente = await context.Planillas.Where(p => p.FechaHoraRegistroConsumo > actual.FechaHoraRegistroConsumo)
                .OrderBy(p => p.FechaHoraRegistroConsumo).FirstOrDefaultAsync();
            id_planilla_anterior = anterior?.Idplanilla ?? "No disponible";
            id_planilla_siguiente = siguiente?.Idplanilla ?? "No disponible";
        }
        catch
        {
            id_planilla_anterior = "No disponible";
            id_planilla_siguiente = "No disponible";
        }
    }

