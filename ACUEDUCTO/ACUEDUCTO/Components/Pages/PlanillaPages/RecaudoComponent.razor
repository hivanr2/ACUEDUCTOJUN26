    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                // hide the temporary index UI
                mostrar = false;

                // if we showed the full list only temporarily and there are still no filters, clear the list
                if (showFullTemporary && !lastHasAnyFilter)
                {
                    facturacion = new List<Facturacion>();
                    hasFacturaPdf.Clear();
                    _reciboNumeroPorFactura.Clear();
                    HayFacturas = false;
                    editaRecaudo = false;
                    editaValores = false;
                    editarObservaciones = false;
                    showFullTemporary = false;
                }

                await InvokeAsync(StateHasChanged);
            });
        }
        await JSRuntime.InvokeVoidAsync("setPageTitle", "REC:" + str_periodo_corto);
    }

    private static string Sanitize(string input)
    { if (string.IsNullOrWhiteSpace(input)) return string.Empty; var invalid = System.IO.Path.GetInvalidFileNameChars(); var safe = string.Join("_", input.Split(invalid, StringSplitOptions.RemoveEmptyEntries)); return safe.Trim(); }

    private async Task PropagarDeudaPasa(Facturacion facturaActual)
    {
        if (facturaActual == null) return;

        try
        {
            using var context = DbFactory.CreateDbContext();

            // Get ordered subsequent planillas starting after the current planilla
            var currentPlanilla = await context.Planillas.FirstOrDefaultAsync(p => p.Idplanilla == id);
            if (currentPlanilla == null) return;

            var subsequentPlanillas = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo > currentPlanilla.FechaHoraRegistroConsumo)
                .OrderBy(p => p.FechaHoraRegistroConsumo)
                .ToListAsync();

            // Start with the deudaPasa from the facturaActual
            double deudaPasaAnterior = facturaActual.DeudaPasa ?? 0;

            // Iterate through each subsequent planilla and update the factura for the same predio
            foreach (var planilla in subsequentPlanillas)
            {
                var facturaSiguiente = await context.Facturacions.FirstOrDefaultAsync(f => f.Idplanilla == planilla.Idplanilla && f.Idpredio == facturaActual.Idpredio);
                if (facturaSiguiente == null) break; // stop propagation when no factura exists for this predio

                // recompute recaudo total from ingresos for that factura
                var ingresos = await context.Ingresos.Where(i => i.Idfactura == facturaSiguiente.Idfactura).ToListAsync();
                facturaSiguiente.RecaudoPeriodoTotal = ingresos.Sum(i => i.Valor ?? 0);

                // set DeudaAnterior and recalculate DeudaPasa
                facturaSiguiente.DeudaAnterior = deudaPasaAnterior;
                var valorPeriodo = facturaSiguiente.ValorPeriodo ?? 0;
                facturaSiguiente.DeudaPasa = RedondearValor((facturaSiguiente.DeudaAnterior ?? 0) + valorPeriodo - (facturaSiguiente.RecaudoPeriodoTotal ?? 0));

                context.Facturacions.Update(facturaSiguiente);
                await context.SaveChangesAsync();

                // prepare deudaPasa for next iteration
                deudaPasaAnterior = facturaSiguiente.DeudaPasa ?? 0;
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Error propagando deuda en cadena para factura {FacturaId}", facturaActual.Idfactura);
        }
    }
