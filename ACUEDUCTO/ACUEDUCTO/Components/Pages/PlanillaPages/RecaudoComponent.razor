    private double RedondearValor(double valor)
    {
        int centenas = (int)(valor / 100); int decenas = (int)((valor % 100) / 10); return decenas <= 5 ? centenas * 100 : (centenas + 1) * 100;
    }

    private async Task RecalcularValores(Facturacion factura, IList<Tarifa> tarifas)
    {
        if (!editaPlanilla) return;
        await CalcularConsumo(factura, tarifas); 
        CalcularValorSobreTasa(factura); 
        await CalcularValorPeriodo(factura);
        var deudaAnterior = factura.DeudaAnterior ?? 0; 
        var valorPeriodo = factura.ValorPeriodo ?? 0; 
        var recaudo = factura.RecaudoPeriodoTotal ?? 0; 
        factura.DeudaPasa = RedondearValor(deudaAnterior + valorPeriodo - recaudo);
        await PropagarDeudaPasa(factura);
    }

    // In-memory recalculation for display only. DOES NOT persist changes or propagate deuda to other planillas.
    private async Task RecalcularValoresEnMemoria(Facturacion factura, IList<Tarifa> tarifas)
    {
        // Compute consumption and value fields for UI display. Do not modify balances or persist.
        await CalcularConsumo(factura, tarifas);
        CalcularValorSobreTasa(factura);
        // Use direct period calculation to avoid side-effects
        CalcularValorPeriodoDirecto(factura);
        // IMPORTANT: do NOT modify DeudaAnterior, RecaudoPeriodoTotal, DeudaPasa here.
        await Task.CompletedTask;
    }

    private async Task CalcularConsumo(Facturacion factura, IList<Tarifa> tarifas)
    {
        if (factura.MedicionActual >= factura.MedicionAnterior) factura.ConsumoM3 = (factura.MedicionActual ?? 0) - (factura.MedicionAnterior ?? 0); else factura.ConsumoM3 = 0;
        await CalcularValorConsumo(factura, tarifas); CalcularValorSobreTasa(factura); CalcularValorPeriodoDirecto(factura);
    }

    private async Task CalcularValorConsumo(Facturacion factura, IList<Tarifa> tarifas)
    {
        double valorConsumo = 0;
        double consumoRestante = factura.ConsumoM3 ?? 0;
        foreach (var tarifa in tarifas.OrderBy(t => t.Desde))
        {
            if (tarifa.Desde.HasValue && tarifa.Hasta.HasValue && tarifa.ValorUnidad.HasValue)
            { double rangoConsumo = Math.Min(consumoRestante, tarifa.Hasta.Value - tarifa.Desde.Value + 1); valorConsumo += rangoConsumo * tarifa.ValorUnidad.Value; consumoRestante -= rangoConsumo; if (consumoRestante <= 0) break; }
        }
        factura.ValorConsumo = valorConsumo;
        await Task.CompletedTask; // Keep async for compatibility
    }

    private void CalcularValorSobreTasa(Facturacion factura)
    { 
        if (factura.CargoFijo.HasValue && factura.PorcentajeSobreTasa.HasValue) { 
            double valorSobreTasa = (double)(factura.CargoFijo.Value + factura.ValorConsumo) * (factura.PorcentajeSobreTasa.Value / 100); factura.ValorSobreTasa = RedondearValor(valorSobreTasa); } 
    }

    private async Task CalcularValorPeriodo(Facturacion factura)
    { double valorPeriodo = (double)((factura.CargoFijo ?? 0) + (factura.ValorConsumo ?? 0) + (factura.ValorSobreTasa ?? 0) + (factura.ValorMora ?? 0) + (factura.ValorSubsidio ?? 0) + (factura.OtrosValores ?? 0)); factura.ValorPeriodo = RedondearValor(valorPeriodo); await Task.CompletedTask; }
    private void CalcularValorPeriodoDirecto(Facturacion factura)
    { double valorPeriodo = (double)((factura.CargoFijo ?? 0) + (factura.ValorConsumo ?? 0) + (factura.ValorSobreTasa ?? 0) + (factura.ValorMora ?? 0) + (factura.ValorSubsidio ?? 0) + (factura.OtrosValores ?? 0)); factura.ValorPeriodo = RedondearValor(valorPeriodo); }

