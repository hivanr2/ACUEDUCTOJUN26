    private void AddDefaultHeaders(ExcelWorksheet worksheet)
    {
        var headers = new[] { "It", "Factura", "Predio", "Codigo", "Medición Anterior", "Medición Actual", "ConsumoM3", "Valor Consumo", "Cargo Fijo", "Porcentaje SobreTasa", "Valor SobreTasa", "Porcentaje Mora", "Valor Mora", "Porcentaje Subsidio", "Valor Subsididio", "Otros Valores", "Valor Periodo", "Deuda Anterior", "Recaudo Bimestre", "Deuda Pasa", "Observaciones Predio", "Notas Factura", "Notas Recaudo" };
        for (int i = 0; i < headers.Length; i++)
        {
            worksheet.Cells[1, i + 1].Value = headers[i];
        }
    }

    private Dictionary<string, int> GetHeadersDict(ExcelWorksheet worksheet)
    {
        var dict = new Dictionary<string, int>();
        if (worksheet.Dimension != null)
        {
            for (int col = 1; col <= worksheet.Dimension.Columns; col++)
            {
                var header = worksheet.Cells[1, col].Text?.Trim();
                if (!string.IsNullOrEmpty(header))
                {
                    dict[header] = col;
                }
            }
        }
        return dict;
    }

