    private async Task CreateReciboAsync(Facturacion f)
    {
        try
        {
            if (!editarFactura)
            {
                // Modo lectura: si ya existe un Ingreso o Recaudo con número asociado, abrir el PDF generado;
                // si no existe, abrir la vista que genera el recibo para repasar.
                using var ctx = DbFactory.CreateDbContext();
                var ingresoExist = await ctx.Ingresos.FirstOrDefaultAsync(i => i.Idfactura == f.Idfactura);
                if (ingresoExist != null)
                {
                    var codigoUsuario = Sanitize(f.CodigoUsuario ?? "usuario");
                    var fileUrl = $"/imagenes/{codigoUsuario}/REC-{ingresoExist.Numero.ToString("0000")}.pdf";
                    await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");
                    return;
                }
                var recaudoExist = await ctx.Recaudos.FirstOrDefaultAsync(r => r.Idfactura == f.Idfactura && r.Numero.HasValue);
                if (recaudoExist != null && recaudoExist.Numero.HasValue)
                {
                    var codigoUsuario = Sanitize(f.CodigoUsuario ?? "usuario");
                    var fileUrl = $"/imagenes/{codigoUsuario}/REC-{recaudoExist.Numero.Value.ToString("0000")}.pdf";
                    await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");
                    return;
                }

                // Si no hay PDF guardado todavía, no abrir la vista que crea el recibo automáticamente.
                // Mostrar mensaje indicando que no existe PDF y que se active EDITAR para generarlo/repasarlo.
                errorMessage = "No existe PDF del recibo. Active 'EDITAR' para generar o repasar el recibo.";
                await JSRuntime.InvokeVoidAsync("alert", errorMessage);
                StateHasChanged();
                return;
            }

            // En modo edición: crear registro de Recaudo y luego abrir la vista de recibo
            using var context = DbFactory.CreateDbContext();

            // Si ya existe un Recaudo o un Ingreso para esta factura, no crear uno nuevo: reutilizar número existente
            var existenteRecaudo = await context.Recaudos.FirstOrDefaultAsync(r => r.Idfactura == f.Idfactura);
            var existenteIngreso = await context.Ingresos.FirstOrDefaultAsync(i => i.Idfactura == f.Idfactura);

            if (existenteRecaudo != null || existenteIngreso != null)
            {
                // No crear, sólo abrir la vista del recibo para repasar la información existente
                var urlAbrirExistente = GetReciboUrl(f);
                await JSRuntime.InvokeVoidAsync("open", urlAbrirExistente, "_blank");
                return;
            }

            // No existe: crear registro mínimo de Recaudo
            var nuevo = new Recaudo
            {
                Idrecaudo = Guid.NewGuid().ToString(),
                FechaHora = DateTime.Now,
                Idfactura = f.Idfactura,
                Valor = f.RecaudoPeriodoTotal ?? 0,
                Concepto = "Recaudo generado desde Facturación",
                Lugar = "Planilla"
            };
            context.Recaudos.Add(nuevo);
            await context.SaveChangesAsync();

            // Abrir la página de impresión del recibo
            var urlAbrir = GetReciboUrl(f);
            await JSRuntime.InvokeVoidAsync("open", urlAbrir, "_blank");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creando recibo: {ex.Message}";
            StateHasChanged();
        }
    }

    private static string Sanitize(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var invalid = Path.GetInvalidFileNameChars();
        var safe = string.Join("_", input.Split(invalid, StringSplitOptions.RemoveEmptyEntries));
        return safe.Trim();
    }

    private async Task<string> BuildConsumoChartDataUri(string idPredio)
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var data = await context.Facturacions
            .Where(c => c.Idpredio == idPredio)
            .Include(f => f.IdplanillaNavigation).ThenInclude(p => p.IdperiodoNavigation)
            .OrderByDescending(c => c.IdplanillaNavigation.FechaHoraFacturacion)
            .Take(10)
            .ToListAsync();

            var pairs = data
            .OrderBy(c => c.IdplanillaNavigation.FechaHoraFacturacion)
            .Select(c => new { Label = c.IdplanillaNavigation.IdperiodoNavigation.DescripcionCorta, Value = (float)(c.ConsumoM3 ?? 0) })
            .ToList();

            int count = Math.Max(1, pairs.Count);
            int width = Math.Max(480, count * 64);
            int height = 200; // más compacto para PDF
            int marginLeft = 40, marginRight = 10, marginTop = 10, marginBottom = 30;
            using var surface = SKSurface.Create(new SKImageInfo(width, height));
            var canvas = surface.Canvas;
            canvas.Clear(SKColors.White);

            using var axisPaint = new SKPaint { Color = SKColors.Black, StrokeWidth = 1, IsAntialias = true };
            using var barPaint = new SKPaint { Color = new SKColor(33, 150, 243), IsAntialias = true };
            using var textPaint = new SKPaint { Color = SKColors.Black, IsAntialias = true, TextSize = 12 };
            using var valuePaint = new SKPaint { Color = SKColors.Black, IsAntialias = true, TextSize = 10 };

            float x0 = marginLeft, y0 = height - marginBottom, x1 = width - marginRight, y1 = marginTop;
            canvas.DrawLine(x0, y0, x1, y0, axisPaint);
            canvas.DrawLine(x0, y0, x0, y1, axisPaint);

            float max = pairs.Count > 0 ? pairs.Max(p => p.Value) : 1f;
            if (max <= 0) max = 1;
            float plotWidth = x1 - x0;
            float barSpace = plotWidth / count;
            float barWidth = MathF.Min(36f, barSpace * 0.6f);

            for (int i = 0; i < count; i++)
            {
                var p = pairs[i];
                float vx = x0 + (i + 0.5f) * barSpace;
                float bh = (p.Value / max) * (y0 - y1);
                var rect = new SKRect(vx - barWidth / 2, y0 - bh, vx + barWidth / 2, y0);
                canvas.DrawRect(rect, barPaint);

                var valStr = p.Value.ToString("0");
                var valBounds = new SKRect();
                valuePaint.MeasureText(valStr, ref valBounds);
                canvas.DrawText(valStr, vx - valBounds.Width / 2, rect.Top - 4, valuePaint);

                var lbl = p.Label ?? string.Empty;
                var tb = new SKRect();
                textPaint.MeasureText(lbl, ref tb);
                canvas.DrawText(lbl, vx - tb.Width / 2, y0 + tb.Height + 4, textPaint);
            }

            using var img = surface.Snapshot();
            using var dataPng = img.Encode(SKEncodedImageFormat.Png, 90);
            using var ms = new MemoryStream();
            dataPng.SaveTo(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            return $"data:image/png;base64,{b64}";
        }
        catch
        {
            return string.Empty;
        }
    }

