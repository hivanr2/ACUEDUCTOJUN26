@page "/planillas/facturacioncomponent"
@layout SimpleLayout
@rendermode InteractiveServer

@* Dynamic compact page title for browser tab: FAC:(ENE-FEB) when period available, otherwise fallback to "FACTURACIÓN" *@
<PageTitle>@(string.IsNullOrWhiteSpace(str_periodo_corto) ? "FACTURACIÓN" : $"FAC:{str_periodo_corto}")</PageTitle>
@using ACUEDUCTO.Components.Layout
@using ACUEDUCTO.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.IO
@using SkiaSharp
@using System.Linq
@using System
@using OfficeOpenXml
@inject IDbContextFactory<AcueductoContext> DbFactory
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager
@inject IServiceProvider ServiceProvider

<style>
    .bg-green-white {
        background-color: #28a745 !important;
        color: #fff !important;
    }

    .progress-thin {
        height: 6px;
    }

    .progress-container {
        min-width: 160px;
    }

    .table-container {
        max-height: 70vh;
        overflow: auto;
    }

    .fixed-header thead th, .fixed-header thead td {
        position: sticky;
        top: 0;
        background-color: var(--bs-light);
        z-index: 5;
    }
</style>

<div class="container-fluid py-2 py-md-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
            @if (@id_planilla_anterior != "No disponible")
            {
                <a class="btn btn-outline-secondary btn-sm" href="/planillas/facturacioncomponent?id=@id_planilla_anterior&codigo=@Uri.EscapeDataString(filtroCodigoUsuario)&predio=@Uri.EscapeDataString(filtroNombrePredio)" target="_self" title="Anterior">
                    <i class="bi bi-arrow-left"></i>
                </a>
            }
            <h3 class="h5 mb-0">FACTURACIÓN :: @str_planilla</h3>
            @if (@id_planilla_siguiente != "No disponible")
            {
                <a class="btn btn-outline-secondary btn-sm" href="/planillas/facturacioncomponent?id=@id_planilla_siguiente&codigo=@Uri.EscapeDataString(filtroCodigoUsuario)&predio=@Uri.EscapeDataString(filtroNombrePredio)" target="_self" title="Siguiente">
                    <i class="bi bi-arrow-right"></i>
                </a>
            }
        </div>
        <div class="text-nowrap">
            <span class="badge bg-primary-subtle text-primary border">Periodo: <strong>@str_periodo_largo</strong></span>
        </div>
    </div>

    @if (facturacion != null && facturacion.Count > 0)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <button class="btn btn-outline-danger btn-sm" @onclick="PrintTextOnlyVersion">
                <i class="bi bi-printer"></i> Impresión formato
            </button>
            <label for="excelInput" class="btn btn-outline-success btn-sm">
                <i class="bi bi-upload"></i> Cargar Excel Respaldo
            </label>
            <div class="form-check form-switch">
                <input type="checkbox" id="editarFactura" class="form-check-input" @bind="editarFactura" />
                <label for="editarFactura" class="form-check-label">EDITAR</label>
            </div>
            @if (isCurrentBimestre)
            {
                <button class="btn btn-outline-info btn-sm" @onclick="VerificarSaldosTotales" title="Actualiza Saldos siguientes bimestres por Predio">
                    <i class="bi bi-check-circle"></i> Actualiza Saldos Totales por Predio
                </button>
                <button class="btn btn-outline-info btn-sm" @onclick="NavigateToAsistencia" title="Listado de Usuarios para Asistencia de Reuniones">
                    <i class="bi bi-list-check"></i> Listado Asistencia
                </button>
                <button class="btn btn-outline-info btn-sm" @onclick="NavigateToActualizacion" title="Listado de Actualización de Datos">
                    <i class="bi bi-pencil-square"></i> Listado Actualización datos
                </button>
            }
            <div class="input-group input-group-sm" style="width: 180px;">
                <input id="filtroNombrePredio" class="form-control" placeholder="Filtrar predio" @bind="filtroNombrePredio" @bind:event="oninput" @bind:after="OnFiltroNombrePredioChanged" />
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroNombrePredio" title="Limpiar filtro">×</button>
            </div>
            <div class="input-group input-group-sm" style="width: 140px;">
                <input id="filtroCodigoUsuario" class="form-control" placeholder="Filtrar código" @bind="filtroCodigoUsuario" @bind:event="oninput" @bind:after="OnFiltroCodigoUsuarioChanged" />
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroCodigoUsuario" title="Limpiar filtro">×</button>
            </div>
        </div>
        <InputFile id="excelInput" OnChange="HandleFileSelected" class="d-none" />
    }

    @if (mostrar)
    {
        <div class="alert alert-info py-2 mb-2 d-flex flex-wrap gap-2 align-items-center">
            <div>
                <strong>Fecha Toma de Consumos:</strong>
                <span>@(FechaTomaConsumoPlanilla.HasValue ? FechaTomaConsumoPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
            <div>
                <strong>Ultimo día de Pago:</strong>
                <span>@(FechaUltimoPagoPlanilla.HasValue ? FechaUltimoPagoPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
            <div>
                <strong>Fecha de Suspensión:</strong>
                <span>@(FechaSuspensionPlanilla.HasValue ? FechaSuspensionPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
            <div class="ms-auto">
                <a class="btn btn-outline-primary btn-sm" href="/planillas/edit?idplanilla=@id" target="_blank" title="Editar planilla">
                    <i class="bi bi-pencil-square"></i> Edita
                </a>
            </div>
        </div>
    }

    @if (facturacion == null)
    {
        <div>Cargando...</div>
    }
    else
    {
        if (facturacion.Count > 0)
        {
            if (!string.IsNullOrWhiteSpace(facturacion.FirstOrDefault()?.CodigoFactura))
            {
                HayFacturas = true;
            }
            <div class="table-container table-responsive">
                <table class="table table-sm table-hover table-striped align-middle fixed-header">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">It</th>
                            <th scope="col">Factura</th>
                            @foreach (var header in new[] { "Predio", "Codigo", "Medición Anterior", "Medición Actual",
 "ConsumoM3", "Valor Consumo", "Cargo Fijo", "Porcentaje SobreTasa",
 "Valor SobreTasa", "Porcentaje Mora", "Valor Mora",
 "Porcentaje Subsidio", "Valor Subsidio", "Otros Valores",
 "Valor Periodo", "Deuda Anterior", "Recaudo Bimestre",
 "Deuda Pasa" })
                            {
                                <th scope="col">@header</th>
                            }
                            @if (editarObservaciones)
                            {
                                <th scope="col">Observaciones Predio</th>
                            }
                            <th scope="col">Notas Factura</th>
                            <th scope="col">Notas Recaudo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < facturacion.Count; i++)
                        {
                            var factura = facturacion[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td class="text-center">
                                    <div class="fw-semibold">@factura.CodigoFactura</div>
                                    @if (HayFacturas)
                                    {
                                        <div class="btn-group btn-group-sm mt-1" role="group">
                                            @* Factura (F) *@
                                            @if (editarFactura)
                                            {
                                                <button class="btn btn-outline-primary" title="Crear / Ver Factura (modo edición)" @onclick="() => CreateFacturaAsync(factura)">F</button>
                                            }
                                            else
                                            {
                                                <a class="btn btn-outline-primary" title="Ver Factura" href="@GetPdfUrl(factura)" target="_blank">F</a>
                                            }

                                            @if ((i == 1 || facturacion.Count == 1) && editarFactura)
                                            {
                                                <button class="btn btn-outline-primary" title="Crear Recibo (modo edición)" @onclick="() => VerReciboSmart(factura)">
                                                    R
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary" title="Ver Recibo" @onclick="() => VerReciboSmart(factura)">
                                                    R
                                                </button>

                                            }



                                            <a class="btn btn-outline-secondary" title="Editar" href="@($"/facturacion/edit?id={factura.Idfactura}")" target="_blank"><i class="bi bi-pencil"></i></a>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @factura.IdpredioNavigation.ApellidosNombresUsuario -
                                    <a href="/predios/details?idpredio=@factura.Idpredio" target="_blank">Ver</a>
                                    - <a href="/predio/historicoconsumos?idpredio=@factura.Idpredio" target="_blank" title="Ver facturas (Fs)">Fs</a>
                                </td>
                                <td>
                                    @if ((factura.ConsumoM3 ?? 0) == 0)
                                    {
                                        // Si no hay consumo, al hacer clic en el código aplicar el filtro en esta misma página de Facturación
                                        <a href="/planillas/facturacioncomponent?id=@id&codigo=@Uri.EscapeDataString(factura.CodigoUsuario ?? string.Empty)&focus=@factura.Idfactura" class="text-decoration-underline" title="Filtrar por código en Facturación">@factura.CodigoUsuario</a>
                                    }
                                    else
                                    {
                                        // Si ya existe consumo, el enlace del código sigue filtrando en esta página de Facturación
                                        <a href="/planillas/facturacioncomponent?id=@id&codigo=@Uri.EscapeDataString(factura.CodigoUsuario ?? string.Empty)&focus=@factura.Idfactura" class="text-decoration-underline" title="Filtrar por código en Facturación">@factura.CodigoUsuario</a>
                                    }
                                </td>
                                <td>@factura.MedicionAnterior</td>
                                <td class="bg-green-white">
                                    @if ((factura.ConsumoM3 ?? 0) == 0)
                                    {
                                        <a href="/planillas/consumoscomponent?id=@id&codigo=@Uri.EscapeDataString(factura.CodigoUsuario ?? string.Empty)&focus=@factura.Idfactura" class="text-decoration-underline text-white" title="Ir a Consumos (toma de datos)">@factura.MedicionActual</a>
                                    }
                                    else if ((factura.MedicionActual ?? 0) > (factura.MedicionAnterior ?? 0))
                                    {
                                        // Si hay lectura mayor al anterior, permitir ver consumos filtrados pero sin activar toma de datos
                                        <a href="/planillas/consumoscomponent?id=@id&codigo=@Uri.EscapeDataString(factura.CodigoUsuario ?? string.Empty)&focus=@factura.Idfactura" class="text-decoration-underline text-white" title="Ver Consumos (solo lectura)">@factura.MedicionActual</a>
                                    }
                                    else
                                    {
                                        @factura.MedicionActual
                                    }
                                </td>
                                <td class="text-center">@factura.ConsumoM3</td>
                                <td class="text-center">@FormatCurrency(factura.ValorConsumo)</td>
                                <td class="text-center">@FormatCurrency(factura.CargoFijo)</td>
                                <td class="text-center">@factura.PorcentajeSobreTasa</td>
                                <td class="text-center">@FormatCurrency(factura.ValorSobreTasa)</td>
                                <td class="text-center">@factura.PorcentajeMora</td>
                                <td class="text-center">@FormatCurrency(factura.ValorMora)</td>
                                <td class="text-center">@factura.PorcentajeSubsidio</td>
                                <td class="text-center">@FormatCurrency(factura.ValorSubsidio)</td>
                                <td class="bg-green-white">@FormatCurrency(factura.OtrosValores)</td>
                                <td class="text-center">@FormatCurrency(factura.ValorPeriodo)</td>
                                <td class="text-center">@FormatCurrency(factura.DeudaAnterior)</td>
                                <td class="bg-green-white">
                                    @{
                                        var recaudoVal = factura.RecaudoPeriodoTotal ?? 0;
                                        var deudaPrev = factura.DeudaAnterior ?? 0;
                                        var codigoEsc = Uri.EscapeDataString(factura.CodigoUsuario ?? string.Empty);
                                    }
                                    @* Si no hay recaudo o es menor a la deuda, abrir en modo edición (parametro 'codigo') *@
                                    @if (recaudoVal == 0 || recaudoVal < deudaPrev)
                                    {
                                        <a class="text-decoration-underline" style="color: white;" href="/planillas/recaudocomponent?id=@id&codigo=@codigoEsc">
                                            @FormatCurrency(factura.RecaudoPeriodoTotal)
                                        </a>
                                    }
                                    else
                                    {
                                        @* Si ya existe recaudo y no falta por pagar, abrir la vista de recaudo en solo lectura filtrada por usuario (param 'usuario') *@
                                        <a class="text-decoration-underline" style="color: white;" href="/planillas/recaudocomponent?id=@id&usuario=@codigoEsc">
                                            @FormatCurrency(factura.RecaudoPeriodoTotal)
                                        </a>
                                    }
                                </td>
                                <td class="text-center">@FormatCurrency(factura.DeudaPasa)</td>
                                @if (editarObservaciones)
                                {
                                    <td>
                                        <div class="small text-muted">@factura.IdpredioNavigation.Observaciones</div>
                                        <textarea class="form-control form-control-sm mt-1" value="@factura.IdpredioNavigation.Observaciones" @onchange="async (e) => await OnObservacionesPredioChanged(factura, e)" tabindex="@((i * 1000) + 4)"></textarea>
                                    </td>
                                }
                                <td><div class="small">@factura.NotasFactura</div></td>
                                <td><div class="small">@factura.NotasRecaudo</div></td>
                            </tr>
                        }
                        <tr class="table-secondary fw-semibold">
                            <td class="text-end" colspan="7">Total Consumo M3: @FormatCurrency(totalConsumoM3)</td>
                            <td colspan="8">Promedio: <strong>@totalpromedio m3</strong></td>
                            <td class="text-center">@totalOtrosValores.ToString("C0")</td>
                            <td class="text-center">@totalValorPeriodo.ToString("C0")</td>
                            <td class="text-center">@totalDeudaAnterior.ToString("C0")</td>
                            <td class="text-center">@totalRecaudoPeriodoTotal.ToString("C0")</td>
                            <td class="text-center">@totalDeudaPasa.ToString("C0")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div>Se crea facturación según Planilla por cada Predio Existente</div>
            @if (str_planilla != null)
            {
                <ExcelPlanillaComponent IdPlanilla="@id" />
            }
            <button class="btn btn-danger" @onclick="ConfirmarFacturacion" disabled="@(isProcessing || facturacionConfirmada)">Estoy seguro</button>
        }
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

<script>
    function downloadFile(filename, base64) {
        const link = document.createElement('a');
        link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + base64;
        link.download = filename;
        link.click();
    }
</script>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? id { get; set; }
    [SupplyParameterFromQuery]
    private string? codigo { get; set; }
    [SupplyParameterFromQuery]
    private string? predio { get; set; }

    private Dictionary<string, int> _reciboNumeroPorFactura = new();

    private bool HayFacturas { get; set; } = false;
    private IList<Facturacion> facturacion = new List<Facturacion>();
    private string? str_planilla;
    private string? id_planilla_siguiente;
    private string? id_planilla_anterior;
    private string? str_periodo_corto;
    private string? str_periodo_largo;
    private string? errorMessage;
    private bool isProcessing = false;
    private bool facturasElaboradas = false;
    private bool showModal = false;
    private Facturacion? selectedFactura;
    private Planilla? planilla;
    private bool mostrar = false;
    private DateTime? FechaTomaConsumoPlanilla;
    private DateOnly? FechaUltimoPagoPlanilla;
    private DateOnly? FechaSuspensionPlanilla;
    private double totalOtrosValores;
    private double totalValorPeriodo;
    private double totalDeudaAnterior;
    private double totalRecaudoPeriodoTotal;
    private double totalDeudaPasa;
    private int totalConsumoM3;
    private int totalpromedio = 0;

    private bool editarObservaciones = false;
    private bool editaPlanilla = false; // bandera de edición
    private bool editarFactura = false;

    // Gráfica final (para mostrar en la página)
    private string? finalChartUri;

    private bool facturacionConfirmada = false;
    private bool isCurrentBimestre = false;

    private string filtroNombrePredio = string.Empty;
    private string filtroCodigoUsuario = string.Empty;
    private System.Threading.CancellationTokenSource? _filtroCts;

    // Guardas para evitar doble carga inicial innecesaria
    private string? _lastLoadedId;
    private string _lastLoadedCodigo = string.Empty;
    private string _lastLoadedPredio = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        filtroCodigoUsuario = codigo ?? string.Empty;
        filtroNombrePredio = predio ?? string.Empty;
        await LoadData();

        // Registrar los valores con los que se hizo la carga inicial
        _lastLoadedId = id;
        _lastLoadedCodigo = filtroCodigoUsuario;
        _lastLoadedPredio = filtroNombrePredio;
    }

    protected override async Task OnParametersSetAsync()
    {
        var newCodigo = codigo ?? string.Empty;
        var newPredio = predio ?? string.Empty;

        // Solo recargar si alguno de los parámetros relevantes cambió
        if (_lastLoadedId != id || _lastLoadedCodigo != newCodigo || _lastLoadedPredio != newPredio)
        {
            filtroCodigoUsuario = newCodigo;
            filtroNombrePredio = newPredio;
            await LoadData();

            _lastLoadedId = id;
            _lastLoadedCodigo = newCodigo;
            _lastLoadedPredio = newPredio;
        }
        else
        {
            // Mantener sincronizados los filtros locales sin recargar datos
            filtroCodigoUsuario = newCodigo;
            filtroNombrePredio = newPredio;
        }
    }


    private async Task VerReciboSmart(Facturacion factura)
    {
        if (factura == null) { errorMessage = "Factura no encontrada"; return; }
        if (editarFactura)
        {
            // Planilla abierta: before opening, update notes but preserve existing notes except placeholder text
            string noteText = string.Empty;
            try
            {
                using var ctx = DbFactory.CreateDbContext();
                var f = await ctx.Facturacions.FirstOrDefaultAsync(x => x.Idfactura == factura.Idfactura);
                if (f != null)
                {
                    // build recaudo note
                    var ingresosList = await ctx.Ingresos.Where(i => i.Idfactura == f.Idfactura).OrderByDescending(i => i.FechaHora).ToListAsync();
                    double recValue = ingresosList.Sum(i => i.Valor ?? 0);
                    if (recValue <= 0 && f.RecaudoPeriodoTotal.HasValue && f.RecaudoPeriodoTotal.Value > 0) recValue = f.RecaudoPeriodoTotal.Value;

                    if (!ingresosList.Any())
                    {
                        var siguienteNumero = (ctx.Ingresos.Any()) ? (await ctx.Ingresos.Where(a => a.Numero > 0).Select(a => a.Numero).MaxAsync()) + 1 : 1;
                        var nuevo = new Ingreso
                        {
                            Idingreso = Guid.NewGuid().ToString(),
                            Numero = siguienteNumero,
                            FechaHora = DateTime.Now,
                            Idcliente = f.IdpredioNavigation?.IdentificacionFacturacion,
                            Idfactura = f.Idfactura,
                            Concepto = $"PAGO FACTURA #{f.CodigoFactura}",
                            Valor = recValue
                        };
                        ctx.Ingresos.Add(nuevo);
                        await ctx.SaveChangesAsync();
                        ingresosList = await ctx.Ingresos.Where(i => i.Idfactura == f.Idfactura).OrderByDescending(i => i.FechaHora).ToListAsync();
                    }

                    var ingresoLatest = ingresosList.FirstOrDefault();
                    var recDate = (ingresoLatest?.FechaHora ?? DateTime.Now).ToString("g", new CultureInfo("es-CO"));
                    var deudaPrev = f.DeudaAnterior ?? 0;

                    noteText = BuildNotaRecaudo(recValue, deudaPrev, recDate);

                    var replacementForFactura = "Gracias por su pago";

                    // Update NotasFactura: replace only placeholder segments if present, preserve all content.
                    if (string.IsNullOrWhiteSpace(f.NotasFactura))
                    {
                        f.NotasFactura = replacementForFactura;
                    }
                    else
                    {
                        // Only replace the placeholder text, keeping the rest of the note intact.
                        f.NotasFactura = ReplacePlaceholderSegment(f.NotasFactura, "SIN RECAUDO EN EL BIMESTRE", replacementForFactura);
                    }

                    // For NotasRecaudo: replace placeholder or append noteText while preserving other content
                    if (string.IsNullOrWhiteSpace(f.NotasRecaudo))
                    {
                        f.NotasRecaudo = noteText;
                    }
                    else if (!f.NotasRecaudo.Contains(noteText))
                    {
                        var replacedRecaudo = ReplacePlaceholderSegment(f.NotasRecaudo, "SIN RECAUDO EN EL BIMESTRE", noteText);
                        replacedRecaudo = ReplacePlaceholderSegment(replacedRecaudo, "INICIANDO", noteText);
                        if (!string.Equals(replacedRecaudo, f.NotasRecaudo, StringComparison.Ordinal))
                        {
                            f.NotasRecaudo = replacedRecaudo;
                        }
                        else
                        {
                            // No placeholder found: append if not already contains
                            f.NotasRecaudo = f.NotasRecaudo + " - " + noteText;
                        }
                    }
                    // else already contains, do nothing

                    ctx.Facturacions.Update(f);
                    await ctx.SaveChangesAsync();

                    // Reflect changes in UI model
                    factura.NotasFactura = f.NotasFactura;
                    factura.NotasRecaudo = f.NotasRecaudo;
                }
            }
            catch
            {
                // ignore DB save errors to not block opening recibo
            }

            // Open recibo component with note in query
            try
            {
                var noteRecaudo = string.Empty;
                var noteFactura = string.Empty;
                try { noteRecaudo = Uri.EscapeDataString(factura.NotasRecaudo ?? string.Empty); } catch { noteRecaudo = string.Empty; }
                try { noteFactura = Uri.EscapeDataString(factura.NotasFactura ?? string.Empty); } catch { noteFactura = string.Empty; }
                var ts = DateTime.UtcNow.Ticks;
                var url = $"/recibos/details?idfactura={factura.Idfactura}&from=recaudo&noteRecaudo={noteRecaudo}&noteFactura={noteFactura}&ts={ts}";
                await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
            }
            catch
            {
                var url = $"/recibos/details?idfactura={factura.Idfactura}&from=recaudo";
                await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
            }
        }
        else
        {
            // Planilla cerrada: abrir PDF en wwwroot
            var codigoUsuario = Sanitize(factura.CodigoUsuario ?? "usuario");
            if (_reciboNumeroPorFactura.TryGetValue(factura.Idfactura, out var nro) && nro > 0)
            {
                var url = $"/imagenes/{codigoUsuario}/REC-{nro:0000}.pdf";
                await JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
            }
            else
            {
                errorMessage = "Recibo PDF no disponible para esta factura";
                StateHasChanged();
                _ = Task.Delay(5000).ContinueWith(_ =>
                {
                    errorMessage = string.Empty;
                    InvokeAsync(StateHasChanged);
                });
            }
        }
    }
    private string ReplacePlaceholderSegment(string original, string placeholderStart, string replacement)
    {
        if (string.IsNullOrEmpty(original)) return original;

        int idx = original.IndexOf(placeholderStart, StringComparison.OrdinalIgnoreCase);
        if (idx < 0) return original;

        int start = idx;
        int end = FindPlaceholderEnd(original, idx);
        if (end <= start) return original;

        var before = original.Substring(0, start);
        var after = end < original.Length ? original.Substring(end) : string.Empty;
        return before + replacement + after;
    }

    private int FindPlaceholderEnd(string original, int startIdx)
    {
        int end = original.Length;
        int sep1 = original.IndexOf(" - ", startIdx, StringComparison.Ordinal);
        if (sep1 > startIdx) end = Math.Min(end, sep1);
        int nl = original.IndexOf('\n', startIdx);
        if (nl > startIdx) end = Math.Min(end, nl);
        int cr = original.IndexOf('\r', startIdx);
        if (cr > startIdx) end = Math.Min(end, cr);

        int i = startIdx;
        while (i < end)
        {
            if (original[i] == '(')
            {
                int close = original.IndexOf(')', i + 1);
                if (close > i)
                {
                    end = Math.Min(end, close + 1);
                }
                break;
            }
            i++;
        }

        while (end > startIdx && char.IsWhiteSpace(original[end - 1])) end--;
        return end;
    }

    private string BuildNotaRecaudo(double recaudoVal, double deudaPrev, string fechaHora)
    {
        var recaudoAbs = Math.Abs(recaudoVal);
        var deudaAbs = Math.Abs(deudaPrev);
        var sb = new System.Text.StringBuilder();
        sb.Append($"Recaudo ({fechaHora}) {FormatCurrency(recaudoVal)}");

        if (recaudoAbs < deudaAbs)
        {
            var faltante = deudaAbs - recaudoAbs;
            sb.Append($" {FormatCurrency(faltante)} FALTANTE");
        }
        else if (recaudoAbs > deudaAbs)
        {
            var anticipo = recaudoAbs - deudaAbs;
            sb.Append($" {FormatCurrency(anticipo)} ANTICIPO");
        }
        else
        {
            sb.Append(" SALDADO");
        }

        sb.Append('.');
        return sb.ToString();
    }



    private async Task LoadData()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();

            planilla = await context.Planillas
            .Include(p => p.IdperiodoNavigation)
            .FirstOrDefaultAsync(p => p.Idplanilla == id);

            facturacion = new List<Facturacion>();
            mostrar = false;
            id_planilla_anterior = "No disponible";
            id_planilla_siguiente = "No disponible";

            if (planilla != null)
            {
                str_planilla = planilla.Descripcion;
                str_periodo_corto = planilla.IdperiodoNavigation?.DescripcionCorta;
                str_periodo_largo = planilla.IdperiodoNavigation?.DescripcionLarga;
                editaPlanilla = planilla.Abierta;
                FechaTomaConsumoPlanilla = planilla.FechaHoraRegistroConsumo;
                FechaUltimoPagoPlanilla = planilla.FechaLimitePago;
                FechaSuspensionPlanilla = planilla.FechaSuspension;

                int currentBimestre = ((DateTime.Now.Month - 1) / 2) + 1;
                isCurrentBimestre = planilla.Idperiodo == currentBimestre;

                // planilla anterior/siguiente por fecha de registro de consumo
                var fechaActual = planilla.FechaHoraRegistroConsumo;
                var planillaAnterior = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo < fechaActual)
                .OrderByDescending(p => p.FechaHoraRegistroConsumo)
                .FirstOrDefaultAsync();
                var planillaSiguiente = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo > fechaActual)
                .OrderBy(p => p.FechaHoraRegistroConsumo)
                .FirstOrDefaultAsync();
                id_planilla_anterior = planillaAnterior?.Idplanilla ?? "No disponible";
                id_planilla_siguiente = planillaSiguiente?.Idplanilla ?? "No disponible";

                var query = context.Facturacions.Where(f => f.Idplanilla == id);
                if (!string.IsNullOrWhiteSpace(filtroNombrePredio))
                {
                    var pattern = $"%{filtroNombrePredio}%";
                    query = query.Where(f => context.Predios.Any(p => p.Idpredio == f.Idpredio && p.ApellidosNombresUsuario != null && EF.Functions.Like(p.ApellidosNombresUsuario, pattern)));
                }
                if (!string.IsNullOrWhiteSpace(filtroCodigoUsuario))
                {
                    var patternCode = $"%{filtroCodigoUsuario}%";
                    query = query.Where(f => f.CodigoUsuario != null && EF.Functions.Like(f.CodigoUsuario, patternCode));
                }
                facturacion = await query
                .Include(f => f.IdpredioNavigation)
                .OrderBy(f => f.IdpredioNavigation.ApellidosNombresUsuario)
                .ToListAsync();

                mostrar = true;

                // Construir la gráfica final (usar el primer predio como referencia)
                finalChartUri = null;
                var firstPredio = facturacion.FirstOrDefault()?.Idpredio;
                if (!string.IsNullOrWhiteSpace(firstPredio))
                {
                    finalChartUri = await BuildConsumoChartDataUri(firstPredio);
                }

                CalcularTotales();
                // Cargar números de recibo existentes por factura
                _reciboNumeroPorFactura.Clear();
                var facturaIds = facturacion.Select(f => f.Idfactura).ToList();
                var ingresos = await context.Ingresos.Where(i => facturaIds.Contains(i.Idfactura)).Select(i => new { i.Idfactura, i.Numero }).AsNoTracking().ToListAsync();
                foreach (var ing in ingresos)
                {
                    if (ing.Numero > 0 && !_reciboNumeroPorFactura.ContainsKey(ing.Idfactura))
                        _reciboNumeroPorFactura[ing.Idfactura] = ing.Numero;
                }

            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando datos: {ex.Message}";
        }
    }

    private void CalcularTotales()
    {
        try
        {
            totalOtrosValores = facturacion.Sum(f => f.OtrosValores ?? 0);
            totalValorPeriodo = facturacion.Sum(f => f.ValorPeriodo ?? 0);
            totalDeudaAnterior = facturacion.Sum(f => f.DeudaAnterior ?? 0);
            totalRecaudoPeriodoTotal = facturacion.Sum(f => f.RecaudoPeriodoTotal ?? 0);
            totalDeudaPasa = facturacion.Sum(f => f.DeudaPasa ?? 0);
            totalConsumoM3 = facturacion.Sum(f => (int)(f.ConsumoM3 ?? 0));
            totalpromedio = facturacion.Count > 0 ? (int)Math.Round(facturacion.Average(f => f.ConsumoM3 ?? 0)) : 0;
        }
        catch { }
    }

    private async Task OnObservacionesPredioChanged(Facturacion factura, ChangeEventArgs e)
    {
        try
        {
            var nuevo = e?.Value?.ToString() ?? string.Empty;
            using var context = DbFactory.CreateDbContext();
            var predio = await context.Predios.FirstOrDefaultAsync(p => p.Idpredio == factura.Idpredio);
            if (predio != null)
            {
                predio.Observaciones = nuevo;
                context.Predios.Update(predio);
                await context.SaveChangesAsync();
                // Sincronizar en memoria
                if (factura.IdpredioNavigation != null)
                {
                    factura.IdpredioNavigation.Observaciones = nuevo;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al actualizar observaciones: {ex.Message}";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            ExcelPackage.License.SetNonCommercialOrganization("Acueducto Comunitario Tobia Chica");
            var file = e.File;
            string extension = Path.GetExtension(file.Name);
            if (file == null || (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) && !file.Name.EndsWith(".xlsm", StringComparison.OrdinalIgnoreCase)))
            {
                errorMessage = "Seleccione un archivo Excel válido (.xlsx o .xlsm)";
                StateHasChanged();
                return;
            }
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            using var package = new ExcelPackage(memoryStream);
            string sheetName = str_periodo_corto ?? "Default";
            ExcelWorksheet worksheet = package.Workbook.Worksheets[sheetName];
            if (worksheet == null)
            {
                errorMessage = $"Hoja '{sheetName}' no encontrada en el archivo Excel. Asegúrese de que el archivo tenga una hoja con ese nombre.";
                StateHasChanged();
                return;
            }
            // Get headers
            var headersDict = new Dictionary<string, int>();
            if (worksheet.Dimension != null && worksheet.Dimension.Rows >= 1)
            {
                for (int col = 1; col <= worksheet.Dimension.Columns; col++)
                {
                    var header = worksheet.Cells[1, col].Text?.Trim();
                    if (!string.IsNullOrEmpty(header))
                    {
                        headersDict[header] = col;
                    }
                }
            }
            else
            {
                AddDefaultHeaders(worksheet);
                headersDict = GetHeadersDict(worksheet);
            }
            // Update data starting from row 6, using column E (5) for matching "Usuario"
            int colCodigo = 5; // Column E
            if (colCodigo <= (worksheet.Dimension?.Columns ?? 0))
            {
                int updatedCount = 0;
                for (int row = 6; row <= (worksheet.Dimension?.Rows ?? 1); row++)
                {
                    var codigoUsuario = worksheet.Cells[row, colCodigo].Text?.Trim().ToLower();
                    if (!string.IsNullOrEmpty(codigoUsuario))
                    {
                        var f = facturacion.FirstOrDefault(fact => fact.CodigoUsuario.Trim().ToLower() == codigoUsuario);
                        if (f != null)
                        {
                            // Update the columns with data
                            // if (headersDict.TryGetValue("Medición Actual", out var col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.MedicionActual;
                            // if (headersDict.TryGetValue("Valor Consumo", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.ValorConsumo;
                            // if (headersDict.TryGetValue("Otros Valores", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.OtrosValores;
                            // if (headersDict.TryGetValue("Valor Periodo", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.ValorPeriodo;
                            // if (headersDict.TryGetValue("Deuda Anterior", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.DeudaAnterior;
                            // if (headersDict.TryGetValue("Recaudo Bimestre", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.RecaudoPeriodoTotal;
                            // if (headersDict.TryGetValue("Deuda Pasa", out col) && col > 0 && col <= worksheet.Dimension?.Columns) worksheet.Cells[row, col].Value = f.DeudaPasa;
                            worksheet.Cells[row, 1].Value = f.CodigoFactura;
                            worksheet.Cells[row, 12].Value = f.MedicionActual;
                            worksheet.Cells[row, 13].Value = f.ConsumoM3;
                            worksheet.Cells[row, 14].Value = f.CargoFijo;
                            worksheet.Cells[row, 15].Value = f.ValorConsumo;
                            worksheet.Cells[row, 16].Value = f.PorcentajeSobreTasa;
                            worksheet.Cells[row, 17].Value = f.ValorSobreTasa;
                            worksheet.Cells[row, 18].Value = f.ValorMora;
                            worksheet.Cells[row, 19].Value = f.PorcentajeSubsidio;
                            worksheet.Cells[row, 20].Value = f.ValorSubsidio;

                            worksheet.Cells[row, 21].Value = f.OtrosValores;
                            worksheet.Cells[row, 22].Value = f.ValorPeriodo;
                            worksheet.Cells[row, 23].Value = f.DeudaAnterior;
                            worksheet.Cells[row, 24].Value = f.RecaudoPeriodoTotal;
                            worksheet.Cells[row, 25].Value = f.DeudaPasa;
                            worksheet.Cells[row, 26].Value = f.NotasFactura;
                            worksheet.Cells[row, 27].Value = f.NotasRecaudo;
                            updatedCount++;
                        }
                    }
                }
                // Show update count
                errorMessage = $"Hoja: {sheetName}, Filas: {worksheet.Dimension?.Rows ?? 0}, Columna Codigo: {colCodigo}, Actualizadas: {updatedCount}";
                StateHasChanged();
            }
            // Save and download
            using var outputStream = new MemoryStream();
            package.SaveAs(outputStream);
            var fileBytes = outputStream.ToArray();
            var base64 = Convert.ToBase64String(fileBytes);
            await JSRuntime.InvokeVoidAsync("downloadFile", $"Respaldo_{sheetName}{extension}", base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error procesando Excel: {ex.Message}";
            StateHasChanged();
        }
