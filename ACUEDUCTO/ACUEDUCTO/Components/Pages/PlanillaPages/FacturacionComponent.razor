                .Include(d => d.EstratoNavigation)
                .ToListAsync();

            foreach (var predio in predios)
            {
                var facturaActual = await context.Facturacions
                    .Where(f => f.Idplanilla == id && f.Idpredio == predio.Idpredio)
                    .Include(f => f.IdpredioNavigation).FirstOrDefaultAsync();

                //var facturaExistente = facturacion.Where(f => f.Idpredio == predio.Idpredio && f.Idplanilla == id).FirstOrDefault();
                int medicion = 0;
                if (facturaActual == null)
                {
                    // Obtiene la factura registrada en la planilla de periodo anterior para el mismi predio
                    // y el mismo año, si no existe se pone 0
                    var facturacionAnterior = await context.Facturacions
                        .Where(f => f.Idplanilla == id_planilla_anterior &&
                            f.Idpredio == predio.Idpredio)
                        .FirstOrDefaultAsync();

                    medicion = (int)(facturacionAnterior?.MedicionActual ?? 0);
                    float cargoFijo = 0;
                    float porcentajeSubsidio = 0;
                    float porcentajeMora = 0;
                    float valorSubsidio = 0;
                    float valorPeriodo = 0;

                    ultimoNumeroFacturado++;
                    string codigoFactura = $"{codigoFacturaPrefix}{year}-{ultimoNumeroFacturado:D4}";

                    cargoFijo = (float)(predio.EstratoNavigation?.CargoFijo ?? 0);

                    // Calcular valores adicionales
                    valorPeriodo = (float)(cargoFijo + ((cargoFijo + (cargoFijo * (predio.EstratoNavigation?.SobreTasa ?? 0) / 100)) * (predio.EstratoNavigation?.SobreTasa ?? 0) / 100));
                    porcentajeMora = (float)(planilla.PorcentajeMora ?? 0);

                    if (predio.TieneSubsidio ?? false)
                    {
                        porcentajeSubsidio = (float)(planilla.PorcentajeSubsidio ?? 0);
                        valorSubsidio = (float)(valorPeriodo * porcentajeSubsidio) / 100;
                        valorPeriodo += valorSubsidio;
                    }
                    else
                        valorSubsidio = 0;

                    // Crear nueva factura
                    var periodoCorto = planilla.IdperiodoNavigation?.DescripcionCorta ?? str_periodo_corto ?? string.Empty;
                    var placeholderNotas = string.IsNullOrWhiteSpace(periodoCorto) ? "SIN RECAUDO EN EL BIMESTRE" : $"SIN RECAUDO EN EL BIMESTRE {periodoCorto}";

                    var nuevaFacturacion = new Facturacion
                    {
                        Idfactura = Guid.NewGuid().ToString(),
                        CodigoFactura = codigoFactura,
                        Idplanilla = planilla.Idplanilla,
                        Idpredio = predio.Idpredio,
                        CodigoUsuario = predio.CodigoUsuario,
                        FechaHoraRegistro = DateTime.Now,
                        MedicionAnterior = medicion,
                        MedicionActual = 0,
                        ConsumoM3 = 0,
                        CargoFijo = cargoFijo,
                        ValorConsumo = 0,
                        PorcentajeSobreTasa = predio.EstratoNavigation?.SobreTasa ?? 0,
                        ValorSobreTasa = ((valorPeriodo) * (predio.EstratoNavigation?.SobreTasa ?? 0)) / 100,
                        PorcentajeSubsidio = porcentajeSubsidio,
                        ValorSubsidio = valorSubsidio,
                        PorcentajeMora = porcentajeMora,
                        ValorMora = 0,
                        OtrosValores = 0,
                        ValorPeriodo = RedondearValor(valorPeriodo),
                        DeudaAnterior = (facturacionAnterior?.DeudaPasa ?? 0), //(facturacion.DeudaPasa ?? 0),
                        RecaudoPeriodoTotal = 0,
                        DeudaPasa = RedondearValor(valorPeriodo + (facturacionAnterior?.DeudaPasa ?? 0)),
                        NotasFactura = placeholderNotas,
                        NotasRecaudo = placeholderNotas
                    };

                    context.Facturacions.Add(nuevaFacturacion);
                }
            }

            // Actualizar la última factura registrada en la planilla actual
            planilla.UltimaFacturaRegistrada = ultimoNumeroFacturado.ToString();
            context.Planillas.Update(planilla);

            await context.SaveChangesAsync();

            // Recargar la lista de facturaciones
            facturacion = await context.Facturacions
                .Where(p => p.Idplanilla == id)
                .Include(f => f.IdpredioNavigation)
                .OrderBy(f => f.IdpredioNavigation.ApellidosNombresUsuario)
                .ToListAsync();

            CalcularTotales();
            facturasElaboradas = true;
            facturacionConfirmada = true;
            await JSRuntime.InvokeVoidAsync("alert", $"Facturación confirmada exitosamente. Se crearon {predios.Count} facturas.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ocurrió un error al crear la facturación: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
    private double RedondearValor(double valor)
    {
        int centenas = (int)(valor / 100);
        int decenas = (int)((valor % 100) / 10);

        if (decenas <= 5)
        {
            return centenas * 100;
        }
        else
        {
            return (centenas + 1) * 100;
        }
    }

    private async Task<string?> GetPreviousPeriodoCorto()
    {
        if (string.IsNullOrEmpty(id_planilla_anterior) || id_planilla_anterior == "No disponible") return null;
        using var context = DbFactory.CreateDbContext();
        var anteriorPlanilla = await context.Planillas
            .Include(p => p.IdperiodoNavigation)
            .FirstOrDefaultAsync(p => p.Idplanilla == id_planilla_anterior);
        return anteriorPlanilla?.IdperiodoNavigation?.DescripcionCorta;
    }

    private async Task VerificarSaldosTotales()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var now = DateTime.Now;
            var messages = new List<string>();

            // Get active predios
            var predios = await context.Predios.Where(p => p.Activo == true)
                .OrderBy(p => p.ApellidosNombresUsuario)
                .ToListAsync();

            foreach (var predio in predios)
            {
                // Load all facturaciones for this predio with planilla navigation
                var facturaciones = await context.Facturacions
                    .Where(f => f.Idpredio == predio.Idpredio)
                    .Include(f => f.IdplanillaNavigation)
                    .OrderBy(f => f.IdplanillaNavigation.FechaHoraRegistroConsumo)
                    .ToListAsync();

                if (facturaciones == null || facturaciones.Count == 0)
                    continue;

                // Find the index of the most recent facturacion whose planilla date is <= now
                int lastPastIndex = -1;
                for (int i = 0; i < facturaciones.Count; i++)
                {
                    var fecha = facturaciones[i].IdplanillaNavigation?.FechaHoraRegistroConsumo;
                    if (fecha.HasValue && fecha.Value <= now)
                        lastPastIndex = i;
                    else if (!fecha.HasValue && facturaciones[i].IdplanillaNavigation != null)
                        lastPastIndex = i; // fallback to include when date not set
                }

                // If there's no past planilla relative to now, skip this predio
                if (lastPastIndex < 0)
                    continue;

                // Start the rolling balance from the deudaPasa of the found past planilla
                double previousBalance = facturaciones[lastPastIndex].DeudaPasa ?? 0;

                // Iterate forward through subsequent planillas and verify/update balances
                var toUpdate = new List<Facturacion>();
                for (int j = lastPastIndex + 1; j < facturaciones.Count; j++)
                {
                    var f = facturaciones[j];
                    double valorPeriodo = f.ValorPeriodo ?? 0;
                    double recaudo = f.RecaudoPeriodoTotal ?? 0;


                    // Compute expected balances and apply the same rounding used when invoices are created
                    double expectedDeudaAnterior = previousBalance;
                    double expectedDeudaPasa = expectedDeudaAnterior + valorPeriodo - recaudo;

                    // Use the same rounding logic as invoice creation to avoid oscillation between rounded values
                    double expectedDeudaAnteriorRounded = RedondearValor(expectedDeudaAnterior);
                    double expectedDeudaPasaRounded = RedondearValor(expectedDeudaPasa);

                    bool changed = false;
                    var beforeAnterior = f.DeudaAnterior ?? 0;
                    var beforePasa = f.DeudaPasa ?? 0;

                    if (!AreClose(f.DeudaAnterior ?? 0, expectedDeudaAnteriorRounded))
                    {
                        f.DeudaAnterior = expectedDeudaAnteriorRounded;
                        changed = true;
                    }
                    if (!AreClose(f.DeudaPasa ?? 0, expectedDeudaPasaRounded))
                    {
                        f.DeudaPasa = expectedDeudaPasaRounded;
                        changed = true;
                    }

                    if (changed)
                    {
                        toUpdate.Add(f);
                        messages.Add($"{predio.ApellidosNombresUsuario} - Planilla:{f.Idplanilla} actualizada: DeudaAnterior {beforeAnterior:C0} -> {f.DeudaAnterior:C0}, DeudaPasa {beforePasa:C0} -> {f.DeudaPasa:C0}");
                    }

                    // Roll forward using the rounded balance so subsequent expected values match persisted values
                    previousBalance = f.DeudaPasa ?? expectedDeudaPasaRounded;
                }

                if (toUpdate.Count > 0)
                {
                    context.Facturacions.UpdateRange(toUpdate);
                    await context.SaveChangesAsync();
                }
            }

            if (messages.Count == 0)
                errorMessage = "Verificación completada: no se encontraron inconsistencias en saldos.";
            else
            {
                // Mostrar resumen en la UI
                errorMessage = "Verificación completada. Actualizaciones realizadas:\n" + string.Join("\n", messages);

                // Enviar correo interno en otro hilo con los detalles (envío interno, no reportado al usuario)
                try
                {
                    var emailSvc = ServiceProvider?.GetService(typeof(EmailService)) as EmailService;
                    if (emailSvc != null)
                    {
                        var subject = $"[ACUEDUCTO] Verificación saldos totales - Actualizaciones ({DateTime.Now:yyyy-MM-dd})";
                        var htmlBody = "<p>Se han realizado actualizaciones en la verificación de saldos totales por predio. Detalles:</p>" +
                            "<ul>" + string.Join("", messages.Select(m => $"<li>{System.Net.WebUtility.HtmlEncode(m)}</li>")) + "</ul>";

                        // Fire-and-forget task; exceptions swallowed so UI isn't impacted
                        _ = System.Threading.Tasks.Task.Run(async () =>
                        {
                            try
                            {
                                await emailSvc.SendEmailAsync("facturacionacueductotobiachica@gmail.com", subject, htmlBody);
                            }
                            catch (Exception ex)
                            {
                                // Internal send failure - log to console only
                                Console.WriteLine($"Error sending internal verification email: {ex.Message}");
                            }
                        });
                    }
                }
                catch
                {
                    // swallow any exception to avoid surfacing to user
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error verificando saldos: {ex.Message}";
        }
        StateHasChanged();
    }

    private static bool AreClose(double a, double b, double tolerance = 0.5)
    {
        return Math.Abs(a - b) <= tolerance;
    }

