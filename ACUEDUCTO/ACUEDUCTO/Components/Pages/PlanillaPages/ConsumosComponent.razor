            var dir = Path.Combine(Env.WebRootPath, "facturas");
            Directory.CreateDirectory(dir);
            var fileName = Sanitize(f.CodigoFactura ?? f.Idfactura) + ".pdf";
            var fullPath = Path.Combine(dir, fileName);
