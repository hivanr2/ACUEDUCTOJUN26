    private async Task<string> BuildConsumoChartDataUri(string idPredio)
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            var rows = await context.Facturacions
                .Where(f => f.Idpredio == idPredio)
                .Join(context.Planillas, f => f.Idplanilla, p => p.Idplanilla, (f, p) => new { f.ConsumoM3, p.FechaHoraRegistroConsumo })
                .OrderByDescending(x => x.FechaHoraRegistroConsumo)
                .Take(12)
                .ToListAsync();

            rows.Reverse();

            int width = 600, height = 200, padding = 30;
            using var bitmap = new SKBitmap(width, height);
            using var canvas = new SKCanvas(bitmap);
            canvas.Clear(SKColors.White);
            using var paintAxis = new SKPaint { Color = SKColors.Gray, StrokeWidth = 1, IsAntialias = true };
            using var paintBar = new SKPaint { Color = new SKColor(13, 110, 253), IsAntialias = true };

            float chartLeft = padding;
            float chartBottom = height - padding;
            float chartRight = width - padding;
            float chartTop = padding;
            canvas.DrawLine(chartLeft, chartBottom, chartRight, chartBottom, paintAxis);
            canvas.DrawLine(chartLeft, chartBottom, chartLeft, chartTop, paintAxis);

            var valores = rows.Select(r => (float)(r.ConsumoM3 ?? 0)).ToArray();
            float max = valores.Length > 0 ? Math.Max(1f, valores.Max()) : 1f;
            int n = Math.Max(1, valores.Length);
            float barWidth = (chartRight - chartLeft) / n * 0.6f;
            float step = (chartRight - chartLeft) / n;

            for (int i = 0; i < n; i++)
            {
                float x = chartLeft + i * step + (step - barWidth) / 2f;
                float h = (valores[i] / max) * (chartBottom - chartTop);
                canvas.DrawRect(new SKRect(x, chartBottom - h, x + barWidth, chartBottom), paintBar);
            }

            using var img = SKImage.FromBitmap(bitmap);
            using var data = img.Encode(SKEncodedImageFormat.Png, 90);
            var b64 = Convert.ToBase64String(data.ToArray());
            return $"data:image/png;base64,{b64}";
        }
        catch
        {
            return string.Empty;
        }
    }




    private async Task SaveFacturaPdf(string idFactura)
    {
