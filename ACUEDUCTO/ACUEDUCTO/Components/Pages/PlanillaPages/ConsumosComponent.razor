    private static string OnlyDigits(string? input)
        => string.IsNullOrWhiteSpace(input) ? string.Empty : Regex.Replace(input, "\\D+", string.Empty);


    private Facturacion? FindFacturaByMeterDigits(string serialDigits)
    {
        if (facturacion is null || facturacion.Count == 0) return null;

        Facturacion? bestFactura = null;
        var bestScore = 0;

        foreach (var f in facturacion)
        {
            var digits = OnlyDigits(f.IdpredioNavigation?.NumeroMedidor);
            if (string.IsNullOrWhiteSpace(digits)) continue;

            var score = LongestCommonEdgeMatch(digits, serialDigits);
            if (score > bestScore)
            {
                bestScore = score;
                bestFactura = f;
            }
        }

        // mínimo 4 dígitos para evitar falsos positivos
        return bestScore >= 4 ? bestFactura : null;
    }

    private static int LongestCommonEdgeMatch(string a, string b)
    {
        if (string.IsNullOrEmpty(a) || string.IsNullOrEmpty(b)) return 0;

        var max = Math.Min(a.Length, b.Length);
        var best = 0;
        for (var len = 1; len <= max; len++)
        {
            if (a.EndsWith(b[^len..], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (a.StartsWith(b[..len], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (b.EndsWith(a[^len..], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (b.StartsWith(a[..len], StringComparison.Ordinal)) best = Math.Max(best, len);
        }
        return best;
    }

    public async Task RegistroAutomatico()
    {
        if (_registroAutomaticoEnProceso)
        {
            return;
        }

        if (selectedImage == null)
        {
            await SetErrorMessageAsync("Por favor, selecciona una imagen.");
            return;
        }

        try
        {
            _registroAutomaticoEnProceso = true;
            _registroAutomaticoEstado = "Processing...";
            await InvokeAsync(StateHasChanged);

            _registroAutomaticoEstado = "Reading image...";
            await InvokeAsync(StateHasChanged);

            await using var stream = selectedImage.OpenReadStream(maxAllowedSize: 15_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _lastImageBytes = ms.ToArray();

            _registroAutomaticoEstado = "Running OCR...";
            await InvokeAsync(StateHasChanged);

            var scan = await OcrApp.ScanAsync(new MemoryStream(_lastImageBytes), CancellationToken.None);

            var result = new OcrScanResult
            {
                NumeroMedidor = scan.NumeroMedidor,
                LecturaActual = scan.LecturaActual,
                Confianza = scan.Confianza
            };

            _lastOcrResult = result;
            _correctionSerial = result.NumeroMedidor;
            _correctionLectura = result.LecturaActual;
            _correctionStatus = null;
            filtroNumeroContador = _correctionSerial;

            _registroAutomaticoEstado = "Applying results...";
            await InvokeAsync(StateHasChanged);

            if (result.LecturaActual is null)
            {
                await SetErrorMessageAsync("No fue posible detectar la lectura del medidor en la imagen.");
                return;
            }

            var serial = string.IsNullOrWhiteSpace(result.NumeroMedidor) ? "N/A" : result.NumeroMedidor;
            var confTxt = result.Confianza is null ? "N/A" : result.Confianza.Value.ToString("N0", CultureInfo.InvariantCulture) + "%";
            await SetErrorMessageAsync($"Lectura: {result.LecturaActual:0} | Serial: {serial} | Confianza: {confTxt}");
        }
        catch (Exception ex)
        {
            await SetErrorMessageAsync($"Error: {ex.Message}");
        }
        finally
        {
            _registroAutomaticoEnProceso = false;
            _registroAutomaticoEstado = "";
            await InvokeAsync(StateHasChanged);
        }
    }

