    private IEnumerable<Facturacion> GetFacturacionFiltrada()
    {
        if (facturacion is null) return Array.Empty<Facturacion>();

        IEnumerable<Facturacion> q = facturacion;

        if (!string.IsNullOrWhiteSpace(filtroNombrePredio))
        {
            var term = filtroNombrePredio.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.ApellidosNombresUsuario ?? string.Empty)
                .Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroCodigoUsuario))
        {
            var term = filtroCodigoUsuario.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.CodigoUsuario ?? string.Empty)
                .Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        // If page was opened with 'codigo' query param, filter to that usuario only
        if (!string.IsNullOrWhiteSpace(codigo))
        {
            var term = codigo.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.CodigoUsuario ?? string.Empty)
                .Equals(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroNumeroContador))
        {
            var termDigits = OnlyDigits(filtroNumeroContador);
            if (!string.IsNullOrWhiteSpace(termDigits) && termDigits.Length >= 4 && termDigits.Trim('0').Length > 0)
            {
                q = q.Where(f =>
                {
                    var digits = OnlyDigits(f.IdpredioNavigation?.NumeroMedidor);
                    if (string.IsNullOrWhiteSpace(digits)) return false;
                    if (digits.Length < 4) return false;
                    if (digits.Trim('0').Length == 0) return false; // evita "0", "00", etc.
                    return digits.Contains(termDigits) || termDigits.Contains(digits);
                });
            }
        }

        return q;
    }

    private sealed class OcrScanResult
    {
        public string? NumeroMedidor { get; set; }
        public double? LecturaActual { get; set; }
        public double? Confianza { get; set; }
    }

    private async Task SetErrorMessageAsync(string? message)
    {
        errorMessage = message;
        _errorMessageVersion++;
        var version = _errorMessageVersion;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(message)) return;

        try { await Task.Delay(5000); } catch { }

        if (version != _errorMessageVersion) return;

        errorMessage = null;
        await InvokeAsync(StateHasChanged);
    }

