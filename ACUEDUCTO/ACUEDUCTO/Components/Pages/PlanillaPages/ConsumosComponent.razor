    private async Task ActualizarMedicionAnteriorEnSiguienteFactura(Facturacion facturaActual)
    {
        using var context = DbFactory.CreateDbContext();

        var planillaActual = await context.Planillas.FirstOrDefaultAsync(p => p.Idplanilla == facturaActual.Idplanilla);
        if (planillaActual == null) return;

        var planillaSiguiente = await context.Planillas
            .Where(p => p.FechaHoraRegistroConsumo > planillaActual.FechaHoraRegistroConsumo)
            .OrderBy(p => p.FechaHoraRegistroConsumo)
            .FirstOrDefaultAsync();

        if (planillaSiguiente == null) return;

        var facturaSiguiente = await context.Facturacions
            .FirstOrDefaultAsync(f => f.Idplanilla == planillaSiguiente.Idplanilla && f.Idpredio == facturaActual.Idpredio);

        if (facturaSiguiente == null) return;

        facturaSiguiente.MedicionAnterior = facturaActual.MedicionActual;

        context.Facturacions.Update(facturaSiguiente);
        await context.SaveChangesAsync();
    }

    private async Task PropagarDeudaPasa(Facturacion facturaActual)
    {
        if (facturaActual == null) return;

        try
        {
            using var context = DbFactory.CreateDbContext();

            var planillaActual = await context.Planillas.FirstOrDefaultAsync(p => p.Idplanilla == facturaActual.Idplanilla);
            if (planillaActual == null) return;

            var subsequentPlanillas = await context.Planillas
                .Where(p => p.FechaHoraRegistroConsumo > planillaActual.FechaHoraRegistroConsumo)
                .OrderBy(p => p.FechaHoraRegistroConsumo)
                .ToListAsync();

            double deudaPasaAnterior = facturaActual.DeudaPasa ?? 0;

            foreach (var planilla in subsequentPlanillas)
            {
                var facturaSiguiente = await context.Facturacions.FirstOrDefaultAsync(f => f.Idplanilla == planilla.Idplanilla && f.Idpredio == facturaActual.Idpredio);
                if (facturaSiguiente == null) break;

                var ingresos = await context.Ingresos.Where(i => i.Idfactura == facturaSiguiente.Idfactura).ToListAsync();
                facturaSiguiente.RecaudoPeriodoTotal = ingresos.Sum(i => i.Valor ?? 0);

                facturaSiguiente.DeudaAnterior = deudaPasaAnterior;
                var valorPeriodo = facturaSiguiente.ValorPeriodo ?? 0;
                facturaSiguiente.DeudaPasa = RedondearValor((facturaSiguiente.DeudaAnterior ?? 0) + valorPeriodo - (facturaSiguiente.RecaudoPeriodoTotal ?? 0));

                context.Facturacions.Update(facturaSiguiente);
                await context.SaveChangesAsync();

                deudaPasaAnterior = facturaSiguiente.DeudaPasa ?? 0;
            }
        }
        catch
        {
            // Registrar o ignorar errores para no bloquear captura de consumos
        }
    }

    private async Task ActualizaTodosFactuaAnterioraActual(string idPlanilla)
    {
        using var context = DbFactory.CreateDbContext();
        var planillaActual = await context.Planillas.Where(f => f.Idplanilla == idPlanilla).FirstOrDefaultAsync();
        if (planillaActual == null) return;

        var facturasActuales = await context.Facturacions.Where(f => f.Idplanilla == planillaActual.Idplanilla).ToListAsync();

        var planillaAnterior = await context.Planillas
            .Where(p => p.FechaHoraRegistroConsumo < planillaActual.FechaHoraRegistroConsumo)
            .OrderByDescending(p => p.FechaHoraRegistroConsumo)
            .FirstOrDefaultAsync();

        if (planillaAnterior == null) return;

        foreach (var factura in facturasActuales)
        {
            var facturaAnterior = await context.Facturacions
                .FirstOrDefaultAsync(f => f.Idplanilla == planillaAnterior.Idplanilla && f.Idpredio == factura.Idpredio);
            if (facturaAnterior != null)
            {
                factura.MedicionAnterior = facturaAnterior.MedicionActual;
                context.Facturacions.Update(factura);
                await context.SaveChangesAsync();
            }
        }
    }

