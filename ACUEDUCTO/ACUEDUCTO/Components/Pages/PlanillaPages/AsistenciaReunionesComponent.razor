@page "/planillas/asistenciareuniones"
@layout SimpleLayout
@using ACUEDUCTO.Components.Layout
@using ACUEDUCTO.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Linq
@inject IDbContextFactory<AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<title>
    ASISTENCIA REUNIÓN
</title>
<style>
.table-print {
    width: 100%;
    border-collapse: collapse;
}
.table-print th, .table-print td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
}
.table-print th {
    background-color: #f0f0f0;
}
</style>

<div class="container-fluid py-2 py-md-3">
    <h3 class="h5 mb-3">LISTADO DE USUARIOS PARA ASISTENCIA DE REUNIONES</h3>
    <h3 class="h5 mb-3">REUNIÓN : _____________________________________________________________________________</h3>
    <h3 class="h5 mb-3">FECHA: ________________________________________________HORA:____________________________________________________</h3>

    @if (predios == null)
    {
        <div>Cargando...</div>
    }
    else
    {
        <table class="table-print">
            <thead>
                <tr>
                    <th>Nombre del Predio - CodigoUsuario</th>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Firma</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var predio in predios)
                {
                    <tr>
                        <td>@predio.ApellidosNombresUsuario - @GetShortCode(predio.CodigoUsuario)</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

@code {
    private IList<Predio> predios = new List<Predio>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            predios = await context.Predios
                .Where(p => p.Activo == true)
                .OrderBy(p => p.ApellidosNombresUsuario)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando datos: {ex.Message}";
        }
    }
    private string GetShortCode(string? code)
    {
        if (string.IsNullOrEmpty(code)) return "";
        var parts = code.Split('-');
        return parts.Length > 1 ? parts[1] : code;
    }

}