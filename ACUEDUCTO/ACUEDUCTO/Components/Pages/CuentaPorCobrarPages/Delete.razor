@page "/cuentaporcobrars/delete"
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>CuentaPorCobrar</h2>
    <hr />
    @if (cuentaporcobrar is null)
    {
        <p><em>Llamando...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Numero</dt>
            <dd class="col-sm-10">@cuentaporcobrar.Numero</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Identificacion</dt>
            <dd class="col-sm-10">@cuentaporcobrar.Identificacion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Descripcion</dt>
            <dd class="col-sm-10">@cuentaporcobrar.Descripcion</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">FechaHora</dt>
            <dd class="col-sm-10">@cuentaporcobrar.FechaHora</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Vencimiento</dt>
            <dd class="col-sm-10">@cuentaporcobrar.Vencimiento</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ValorDebe</dt>
            <dd class="col-sm-10">@cuentaporcobrar.ValorDebe</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ValorPagado</dt>
            <dd class="col-sm-10">@cuentaporcobrar.ValorPagado</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CuotasTotales</dt>
            <dd class="col-sm-10">@cuentaporcobrar.CuotasTotales</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CuotasPagadas</dt>
            <dd class="col-sm-10">@cuentaporcobrar.CuotasPagadas</dd>
        </dl>
        <EditForm method="post" Model="cuentaporcobrar" OnValidSubmit="DeleteCuentaPorCobrar" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(cuentaporcobrar is null)">Delete</button> |
            <a href="/cuentaporcobrars">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private CuentaPorCobrar? cuentaporcobrar;

    [SupplyParameterFromQuery]
    private string IdcuentaxC { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        cuentaporcobrar = await context.CuentaPorCobrars.FirstOrDefaultAsync(m => m.IdcuentaxC == IdcuentaxC);

        if (cuentaporcobrar is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteCuentaPorCobrar()
    {
        using var context = DbFactory.CreateDbContext();
        context.CuentaPorCobrars.Remove(cuentaporcobrar!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/cuentaporcobrars");
    }
}
