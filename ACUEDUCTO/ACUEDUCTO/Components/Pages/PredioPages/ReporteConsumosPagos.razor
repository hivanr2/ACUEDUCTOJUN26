@page "/predios/report"
@using Microsoft.EntityFrameworkCore
@using System.Linq
@using System.Globalization
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager Nav

@rendermode InteractiveServer

<PageTitle>Reporte Consumos y Pagos - Predios</PageTitle>

<style>
    .dashboard-card { border-radius:10px; }
    .status-dot { display:inline-block; width:12px; height:12px; border-radius:50%; margin-right:8px; vertical-align:middle; }
    .status-excellent { background:#2ecc71; }
    .status-good { background:#9be7a1; }
    .status-fair { background:#f39c12; }
    .status-poor { background:#e74c3c; }
    .bar { background:#e9ecef; height:12px; border-radius:6px; overflow:hidden; }
    .bar-inner { height:100%; }
    .bar-label { min-width:110px; max-width:200px; font-size:0.95rem; }
    .behavior-row { display:flex; gap:12px; align-items:center; }
    /* force bars to start at same X: fixed label width and layout using flex (no bootstrap cols) */
    .behavior-row .bar-label { flex: 0 0 170px; width:170px; padding-right:8px; }
    .behavior-row .bar-col { flex: 1 1 auto; padding-left:0; }
    .behavior-row .count { flex: 0 0 auto; padding-left:8px; text-align:right; }
    .behavior-row .percent { flex: 0 0 auto; padding-left:8px; text-align:right; }
    @@media (max-width: 767.98px) {
        .behavior-row .bar-label { flex: 0 0 110px; width:110px; }
    }
    .consumption-bar { background:#e9ecef; height:14px; border-radius:8px; overflow:hidden; }
    .consumption-inner { height:100%; border-radius:8px 0 0 8px; transition:width .6s ease; }
    .consumption-list { padding-right:6px; }
</style>

<div class="container-fluid py-2 py-md-3">
    <div class="mb-2">
        <button type="button" class="btn btn-outline-secondary btn-sm me-2" @onclick="OnGoBackClicked">Regresar</button>
        <button type="button" class="btn btn-outline-warning btn-sm" @onclick="OnActualizarClicked" disabled="@isUpdating">
            @if (isUpdating)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            ACTUALIZA COMPORTAMIENTO PAGOS
        </button>
    </div>

    @if (showToast && !string.IsNullOrEmpty(updateStatus))
    {
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1055;">
            <div class="alert alert-info shadow" role="alert">@updateStatus</div>
        </div>
    }

    <div class="row mb-3">
        <div class="col-12">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title mb-2">Por tipo de consumo</h6>
                    <div class="consumption-list mt-2">
                        @if (consumptionGroups != null && consumptionGroups.Any())
                        {
                            @foreach (var g in consumptionGroups)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="text-truncate fw-medium">@(string.IsNullOrWhiteSpace(g.Tipo) ? "(Sin categoría)" : g.Tipo)</div>
                                        <div class="small text-muted">@g.Total &middot; @GetPercentForGroup(g).ToString("0.##", CultureInfo.InvariantCulture)%</div>
                                    </div>
                                    <div class="consumption-bar"><div class="consumption-inner bg-primary" style='width:@FormatPercentForWidth(GetPercentForGroup(g))%'></div></div>
                                    <div class="small text-muted mt-1">Siempre:@g.BehaviorCounts.GetValueOrDefault("Siempre al día",0) · Mayormente:@g.BehaviorCounts.GetValueOrDefault("Mayormente al día",0) · Intermitente:@g.BehaviorCounts.GetValueOrDefault("Intermitente",0) · Pobre:@g.BehaviorCounts.GetValueOrDefault("Casi no paga",0)</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted">No hay datos</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title mb-2">Comportamiento de pagos</h6>
                    <small class="text-muted">Total predios: @totalPrediosCount</small>
                    <div class="mt-3">
                        <div class="behavior-row mb-2">
                            <div class="bar-label text-truncate"><span class="status-dot status-excellent"></span>Siempre al día</div>
                            <div class="bar-col">
                                <div class="bar"><div class="bar-inner bg-success" style='width:@(GetPercent("Siempre al día"))%;'></div></div>
                            </div>
                            <div class="count small text-muted">@behaviorCounts.GetValueOrDefault("Siempre al día",0)</div>
                            <div class="percent small fw-semibold">@GetPercent("Siempre al día")%</div>
                        </div>
                        <div class="behavior-row mb-2">
                            <div class="bar-label text-truncate"><span class="status-dot status-good"></span>Mayormente al día</div>
                            <div class="bar-col">
                                <div class="bar"><div class="bar-inner bg-info" style='width:@(GetPercent("Mayormente al día"))%;'></div></div>
                            </div>
                            <div class="count small text-muted">@behaviorCounts.GetValueOrDefault("Mayormente al día",0)</div>
                            <div class="percent small fw-semibold">@GetPercent("Mayormente al día")%</div>
                        </div>
                        <div class="behavior-row mb-2">
                            <div class="bar-label text-truncate"><span class="status-dot status-fair"></span>Intermitente</div>
                            <div class="bar-col">
                                <div class="bar"><div class="bar-inner bg-warning" style='width:@(GetPercent("Intermitente"))%;'></div></div>
                            </div>
                            <div class="count small text-muted">@behaviorCounts.GetValueOrDefault("Intermitente",0)</div>
                            <div class="percent small fw-semibold">@GetPercent("Intermitente")%</div>
                        </div>
                        <div class="behavior-row mb-2">
                            <div class="bar-label text-truncate"><span class="status-dot status-poor"></span>Casi no paga</div>
                            <div class="bar-col">
                                <div class="bar"><div class="bar-inner bg-danger" style='width:@(GetPercent("Casi no paga"))%;'></div></div>
                            </div>
                            <div class="count small text-muted">@behaviorCounts.GetValueOrDefault("Casi no paga",0)</div>
                            <div class="percent small fw-semibold">@GetPercent("Casi no paga")%</div>
                        </div>
                        <div class="behavior-row">
                            <div class="bar-label text-truncate"><span class="badge bg-secondary">SF</span>Sin facturación</div>
                            <div class="bar-col">
                                <div class="bar"><div class="bar-inner bg-secondary" style='width:@(GetPercent("Sin facturación"))%;'></div></div>
                            </div>
                            <div class="count small text-muted">@behaviorCounts.GetValueOrDefault("Sin facturación",0)</div>
                            <div class="percent small fw-semibold">@GetPercent("Sin facturación")%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalPrediosCount = 0;
    private Dictionary<string, int> behaviorCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    private List<ConsumptionGroup> consumptionGroups = new List<ConsumptionGroup>();

    private bool isUpdating = false;
    private string? updateStatus = null;
    private bool showToast = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            using var ctx = DbFactory.CreateDbContext();
            var predios = await ctx.Predios
                .Include(p => p.TipoConsumoNavigation)
                .Include(p => p.Facturacions).ThenInclude(f => f.IdplanillaNavigation)
                .ToListAsync();

            totalPrediosCount = predios.Count;
            var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            var groups = new Dictionary<string, ConsumptionGroup>(StringComparer.OrdinalIgnoreCase);

            foreach (var p in predios)
            {
                var facts = p.Facturacions?
                    .Where(f => f.IdplanillaNavigation != null && f.IdplanillaNavigation.FechaHoraFacturacion.HasValue && f.IdplanillaNavigation.FechaHoraFacturacion.Value <= DateTime.Now)
                    .OrderByDescending(f => f.IdplanillaNavigation!.FechaHoraFacturacion)
                    .Take(6)
                    .ToList() ?? new List<ACUEDUCTO.Models.Facturacion>();

                var (behavior, score) = ComputeBehaviorFromFacts(facts);
                counts.TryGetValue(behavior, out var c);
                counts[behavior] = c + 1;

                var tipo = p.TipoConsumoNavigation?.Categoria ?? string.Empty;
                if (!groups.TryGetValue(tipo, out var grp))
                {
                    grp = new ConsumptionGroup { Tipo = tipo, Total = 0, BehaviorCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase) };
                    groups[tipo] = grp;
                }
                grp.Total++;
                grp.BehaviorCounts.TryGetValue(behavior, out var bc);
                grp.BehaviorCounts[behavior] = bc + 1;
            }

            behaviorCounts = counts;
            consumptionGroups = groups.Values.OrderByDescending(g => g.Total).ToList();
        }
        catch
        {
            // ignore
        }
    }

    private int GetPercent(string key)
        => totalPrediosCount == 0 ? 0 : (int)Math.Round(100.0 * (behaviorCounts.GetValueOrDefault(key, 0) / (double)totalPrediosCount));

    private double GetPercentForGroup(ConsumptionGroup g)
        => totalPrediosCount == 0 ? 0.0 : (100.0 * g.Total / totalPrediosCount);

    private static string FormatPercentForWidth(double pct)
        => Math.Max(0, Math.Min(100, pct)).ToString("0.##", CultureInfo.InvariantCulture);

    private class ConsumptionGroup
    {
        public string Tipo { get; set; } = string.Empty;
        public int Total { get; set; }
        public Dictionary<string, int> BehaviorCounts { get; set; } = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    }

    private async Task HideToastAfterDelay()
    {
        try
        {
            await Task.Delay(5000);
            showToast = false;
            updateStatus = null;
            StateHasChanged();
        }
        catch
        {
        }
    }

    private static (string behavior, int score) ComputeBehaviorFromFacts(List<ACUEDUCTO.Models.Facturacion> facts)
    {
        int total = facts.Count;
        int paidCount = 0;
        foreach (var f in facts)
        {
            var recaudo = f.RecaudoPeriodoTotal ?? 0.0;
            if (recaudo > 0.0) paidCount++;
        }

        string behavior;
        int score;
        if (total == 0)
        {
            behavior = "Sin facturación";
            score = 0;
        }
        else
        {
            var pctPaid = (double)paidCount / total;
            if (pctPaid >= 0.90) { behavior = "Siempre al día"; score = 0; }
            else if (pctPaid >= 0.75) { behavior = "Mayormente al día"; score = 1; }
            else if (pctPaid > 0.0) { behavior = "Intermitente"; score = 2; }
            else { behavior = "Casi no paga"; score = 3; }
        }

        return (behavior, score);
    }

    private async Task OnActualizarClicked()
    {
        // show immediate feedback and delegate to actual update implementation
        updateStatus = "Iniciando actualización...";
        showToast = true;
        StateHasChanged();
        await ActualizarComportamientoPagosAsync();
    }

    private async Task OnGoBackClicked()
    {
        try
        {
            // navigate back to index
            Nav.NavigateTo("/predios");
            await Task.Yield();
        }
        catch
        {
            // fallback: do nothing
        }
    }

    private async Task ActualizarComportamientoPagosAsync()
    {
        if (isUpdating) return;
        isUpdating = true;
        updateStatus = "Actualizando comportamientos...";
        StateHasChanged();
        try
        {
            using var ctx = DbFactory.CreateDbContext();
            var predios = await ctx.Predios
                .Include(p => p.Facturacions).ThenInclude(f => f.IdplanillaNavigation)
                .ToListAsync();

            var changed = false;
            foreach (var predioEntity in predios)
            {
                var facts = predioEntity.Facturacions?
                    .Where(f => f.IdplanillaNavigation != null && f.IdplanillaNavigation.FechaHoraFacturacion.HasValue && f.IdplanillaNavigation.FechaHoraFacturacion.Value <= DateTime.Now)
                    .OrderByDescending(f => f.IdplanillaNavigation!.FechaHoraFacturacion)
                    .Take(6)
                    .ToList() ?? new List<ACUEDUCTO.Models.Facturacion>();

                var (behavior, score) = ComputeBehaviorFromFacts(facts);

                var existing = predioEntity.ComportamientoPagos ?? string.Empty;
                if (existing != behavior)
                {
                    predioEntity.ComportamientoPagos = behavior;
                    changed = true;
                }
            }

            if (changed)
            {
                await ctx.SaveChangesAsync();
            }

            updateStatus = changed ? "Se han actualizado los comportamientos." : "No se detectaron cambios.";
            showToast = true;
            _ = HideToastAfterDelay();
            await LoadDashboardAsync();
        }
        catch (Exception ex)
        {
            updateStatus = "Error: " + ex.Message;
        }
        finally
        {
            isUpdating = false;
            StateHasChanged();
        }
    }

    private void GoBack() => Nav.NavigateTo("/predios");
}
