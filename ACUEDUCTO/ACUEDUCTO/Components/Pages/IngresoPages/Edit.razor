@page "/ingresos/edit"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Ingreso</h2>
<hr />
@if (Ingreso is null)
{
    <p><em>Llamando...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Ingreso" OnValidSubmit="UpdateIngreso" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Ingreso.Idingreso" value="@Ingreso.Idingreso" />
                <div class="mb-3">
                    <label for="numero" class="form-label">Número:</label>
                    <InputNumber id="numero" @bind-Value="Ingreso.Numero" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Numero" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="fechahora" class="form-label">FechaHora:</label>
                    <InputDate id="fechahora" @bind-Value="Ingreso.FechaHora" class="form-control" />
                    <ValidationMessage For="() => Ingreso.FechaHora" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="idcliente" class="form-label">Idcliente:</label>
                    <InputText id="idcliente" @bind-Value="Ingreso.Idcliente" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Idcliente" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="idfactura" class="form-label">Idfactura:</label>
                    <InputText id="idfactura" @bind-Value="Ingreso.Idfactura" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Idfactura" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="idcxc" class="form-label">Idcxc:</label>
                    <InputText id="idcxc" @bind-Value="Ingreso.Idcxc" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Idcxc" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="concepto" class="form-label">Concepto:</label>
                    <InputText id="concepto" @bind-Value="Ingreso.Concepto" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Concepto" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="valor" class="form-label">Valor:</label>
                    <InputNumber id="valor" @bind-Value="Ingreso.Valor" class="form-control" />
                    <ValidationMessage For="() => Ingreso.Valor" class="text-danger" />
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a class="btn btn-outline-secondary" href="/ingresos" onclick="return cerrarVentana('/ingresos');">Cerrar</a>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/ingresos" onclick="return cerrarVentana('/ingresos');">Cerrar</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private string Idingreso { get; set; }

    [SupplyParameterFromForm]
    private Ingreso? Ingreso { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Ingreso ??= await context.Ingresos.FirstOrDefaultAsync(m => m.Idingreso == Idingreso);

        if (Ingreso is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateIngreso()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Ingreso!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!IngresoExists(Ingreso!.Idingreso))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/ingresos");
    }

    private bool IngresoExists(string idingreso)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Ingresos.Any(e => e.Idingreso == idingreso);
    }
}
