    private string ExtractInvoiceNumber(string descripcion)
    {
        // Suponiendo que el nmero de la factura est al principio de la descripcin y separado por un espacio
        var parts = descripcion.Split(' ');
        return parts.Length > 0 ? parts[0] : descripcion;
    }

    private int ObtenerPeriodo(DateTime fechaHora)
    {
        // Suponiendo que los periodos son bimestrales y empiezan en enero
        int mes = fechaHora.Month;
        int anio = fechaHora.Year;
        if (mes == 12)
        {
            mes = 1;
        }
        int periodo = (mes + 1) / 2;
        return periodo;
    }
