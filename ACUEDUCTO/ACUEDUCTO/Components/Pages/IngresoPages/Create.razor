@page "/ingresos/create"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Ingreso</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Ingreso" OnValidSubmit="AddIngreso" FormName="create">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="fechahora" class="form-label">FechaHora:</label>
                <InputDate id="fechahora" @bind-Value="Ingreso.FechaHora" class="form-control" />
                <ValidationMessage For="() => Ingreso.FechaHora" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="numero" class="form-label">Numero:</label>
                <InputNumber id="numero" @bind-Value="Ingreso.Numero" class="form-control" />
                <ValidationMessage For="() => Ingreso.Numero" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="idcliente" class="form-label">Usuario Facturacin:</label>
                <InputSelect id="idcliente" @bind-Value="Ingreso.Idcliente" class="form-control">
                    <option value="">Seleccione un usuario</option>
                    @foreach (var usuario in Usuarios)
                    {
                        <option value="@usuario.Identificacion">@usuario.ApellidosNombres</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Ingreso.Idcliente" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="idcxc" class="form-label">IDCXC:</label>
                <InputSelect id="idcxc" @bind-Value="Ingreso.Idcxc" class="form-control" @oninput="OnCuentaPorCobrarChanged">
                    <option value="">Seleccione una cuenta por cobrar</option>
                    @foreach (var cuenta in cuentasPorCobrar)
                    {
                        <option value="@cuenta.IdcuentaxC">@cuenta.Descripcion</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label for="idfactura" class="form-label">IDFactura de Registro Abono:</label>
                <InputSelect id="idfactura" @bind-Value="Ingreso.Idfactura" class="form-control">
                    <option value="">Seleccione una factura</option>
                    @foreach (var factura in facturas)
                    {
                        <option value="@factura.CodigoFactura">@factura.CodigoFactura</option>
                    }
                </InputSelect>
            </div>
            <div class="mb-3">
                <label for="concepto" class="form-label">Concepto:</label>
                <InputText id="concepto" @bind-Value="Ingreso.Concepto" class="form-control" />
                <ValidationMessage For="() => Ingreso.Concepto" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="valor" class="form-label">Valor:</label>
                <InputNumber id="valor" @bind-Value="Ingreso.Valor" class="form-control" />
                <ValidationMessage For="() => Ingreso.Valor" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/ingresos" onclick="return cerrarVentana('/ingresos');">Cerrar</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Ingreso Ingreso { get; set; } = new();
    private MovimientoCaja movimientoCaja { get; set; } = new();
    private List<Facturacion> facturas = new();
    private List<CuentaPorCobrar> cuentasPorCobrar = new();

    private List<Usuario> Usuarios { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        // Cargar la lista de usuarios
        Usuarios = await context.Usuarios.OrderBy(c => c.ApellidosNombres).ToListAsync();
        facturas = await context.Facturacions.OrderBy(c => c.CodigoFactura).Include(c => c.IdpredioNavigation).ToListAsync();
        cuentasPorCobrar = await context.CuentaPorCobrars.Where(c => c.ValorDebe > 0).OrderBy(c => c.Descripcion).ToListAsync();
        if (Ingreso.Numero == null || Ingreso.Numero == 0)
        {
            int siguienteNumero = 4414; // Valor por defecto en caso de que no haya registros

            if (context.Ingresos.Any())
            {
                siguienteNumero = (context.Ingresos.Where(a => a.Numero > 0).Select(a => a.Numero).Max()) + 1;
            }
            Ingreso.Numero = siguienteNumero;
        }
    }

    private async Task AddIngreso()
    {
        using var context = DbFactory.CreateDbContext();
        Ingreso.Idingreso = Guid.NewGuid().ToString();

        if (!string.IsNullOrEmpty(Ingreso.Idcxc))
        {
            var selectedCuenta = cuentasPorCobrar.FirstOrDefault(c => c.IdcuentaxC == Ingreso.Idcxc);

            if (selectedCuenta != null)
            {
                Ingreso.Idcliente = selectedCuenta.Identificacion;

                if (selectedCuenta.CuotasTotales.HasValue && selectedCuenta.CuotasTotales.Value > 0)
                {
                    selectedCuenta.CuotasPagadas += 1;

                    // si es la ultima cuota
                    if (selectedCuenta.CuotasPagadas == selectedCuenta.CuotasTotales)
                    {
                        // Pago totalmente solo si el valor del ingreso es igual al valor de la cxc
                        if (selectedCuenta.ValorDebe == Ingreso.Valor)
                        {
                            // Pago totalmente la cxc CANCELANDO la cxc
                            Ingreso.Concepto = "CANCELO TOTALMENTE " + selectedCuenta.Descripcion;
                        }
                        else
                        {
                            // Pago una parte por lo que solo ABONO quedando aun debiendo saldo de la cxc
                            Ingreso.Concepto = "ABONO PARCIAL " + selectedCuenta.Descripcion;
                        }
                    }
                    else
                    {
                        // si no es la ultima cuota debe haber un abono de una cuota,
                        // partiendo el total en el nmero de cuotas que faltan
                        int cuotasRestantes = selectedCuenta.CuotasTotales.Value - selectedCuenta.CuotasPagadas.Value;
                        double valorCuota = selectedCuenta.ValorDebe.Value / cuotasRestantes;
                        Ingreso.Valor = valorCuota;
                        Ingreso.Concepto = "ABONO DE CUOTA " + selectedCuenta.Descripcion;
                    }
                }

                // Actualizar los valores de la cuenta por cobrar
                selectedCuenta.ValorDebe -= Ingreso.Valor;
                selectedCuenta.ValorPagado += Ingreso.Valor;
                selectedCuenta.Identificacion = Ingreso.Idcliente;

                context.CuentaPorCobrars.Update(selectedCuenta);
                await context.SaveChangesAsync();

                // se obtiene con Ingreso.idfactura el codigoFactura de la Factura del Cliente para hacer la actualizacin de la DeudaPasa y RecaudoPeriodoTotal
                var selectedFactura = facturas.FirstOrDefault(f => f.CodigoFactura == Ingreso.Idfactura);

                if (selectedFactura != null)
                {
                    selectedFactura.DeudaPasa -= Ingreso.Valor;
                    selectedFactura.RecaudoPeriodoTotal += Ingreso.Valor;
                    //Ingreso.Idfactura = selectedFactura.CodigoFactura;
                    if (selectedFactura.NotasFactura.Contains("SIN RECAUDO EN EL BIMESTRE"))
                    {
                        selectedFactura.NotasFactura = Ingreso.Concepto + " " + Ingreso.FechaHora;
                    }
                    else
                    {
                        selectedFactura.NotasFactura += " - " + Ingreso.Concepto + " " + Ingreso.FechaHora;
                    }
                    if (selectedFactura.NotasRecaudo.Contains("SIN RECAUDO EN EL BIMESTRE"))
                    {
                        selectedFactura.NotasRecaudo = Ingreso.Concepto + " " + Ingreso.FechaHora;
                    }
                    else
                    {
                        selectedFactura.NotasRecaudo += " - " + Ingreso.Concepto + " " + Ingreso.FechaHora;
                    }

                    // // Actualizar las cuotas en la factura
                    // selectedFactura.CuotasPagadas = selectedCuenta.CuotasPagadas;
                    // selectedFactura.CuotasTotales = selectedCuenta.CuotasTotales;

                    context.Facturacions.Update(selectedFactura);
                    await context.SaveChangesAsync();
                }
            }
        }
        Ingreso.FechaHora = this.Ingreso.FechaHora;

        context.Ingresos.Add(Ingreso);
        await context.SaveChangesAsync();

        // Se hace registro de movimiento de caja
        movimientoCaja.FechaHora = Ingreso.FechaHora;
        movimientoCaja.Entrada = Ingreso.Valor;
        movimientoCaja.Iddocumento = "INGRESO#" + Ingreso.Numero.ToString();
        movimientoCaja.Salida = 0;
        movimientoCaja.Saldo = Ingreso.Valor;
        context.MovimientoCajas.Add(movimientoCaja);
        await context.SaveChangesAsync();
        StateHasChanged();

        NavigationManager.NavigateTo("/ingresos");
        StateHasChanged();
    }


