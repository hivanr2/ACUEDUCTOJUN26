@page "/tipoconsumos/create"
@layout SimpleLayout
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO.Models
@inject IDbContextFactory<ACUEDUCTO.Models.AcueductoContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>TipoConsumo</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="TipoConsumo" OnValidSubmit="AddTipoConsumo" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="categoria" class="form-label">Categoria:</label> 
                <InputText id="categoria" @bind-Value="TipoConsumo.Categoria" class="form-control" /> 
                <ValidationMessage For="() => TipoConsumo.Categoria" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="rango" class="form-label">Rango:</label> 
                <InputText id="rango" @bind-Value="TipoConsumo.Rango" class="form-control" /> 
                <ValidationMessage For="() => TipoConsumo.Rango" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="observaciones" class="form-label">Observaciones:</label> 
                <InputText id="observaciones" @bind-Value="TipoConsumo.Observaciones" class="form-control" /> 
                <ValidationMessage For="() => TipoConsumo.Observaciones" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a class="btn btn-outline-secondary btn-sm" href="" onclick="return cerrarVentana('');">Cerrar</a>
</div>

@code {
    [SupplyParameterFromForm]
    private TipoConsumo TipoConsumo { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddTipoConsumo()
    {
        using var context = DbFactory.CreateDbContext();
        context.TipoConsumos.Add(TipoConsumo);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/tipoconsumos");
    }
}
