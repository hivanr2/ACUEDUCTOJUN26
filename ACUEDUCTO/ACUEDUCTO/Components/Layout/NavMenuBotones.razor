</div>

<style>
    .footer-images {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 10px;
    }

    .footer-images img {
        width: 80px;
        height: 80px;
        cursor: pointer;
    }

    .fixed-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background-color: #f8f9fa;
        text-align: center;
        padding: 10px 0;
        box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        transition: opacity 400ms ease, transform 400ms ease;
        opacity: 1;
        transform: translateY(0);
    }

    .fixed-footer.footer-hidden {
        opacity: 0;
        transform: translateY(100%);
        pointer-events: none;
    }

    main {
        padding-bottom: 60px;
    }
</style>

<script>
    (function () {
        const footer = document.getElementById('appFooter');
        if (!footer) return;

        const HIDE_DELAY_MS = 3000;
        let timerId = null;

        function showFooter() { footer.classList.remove('footer-hidden'); }
        function hideFooter() { footer.classList.add('footer-hidden'); }
        function resetTimer() {
            showFooter();
            if (timerId) window.clearTimeout(timerId);
            timerId = window.setTimeout(hideFooter, HIDE_DELAY_MS);
        }

        resetTimer();

        const events = ['mousemove', 'wheel', 'keydown', 'touchstart', 'pointermove'];
        events.forEach(ev => window.addEventListener(ev, resetTimer, { passive: true }));

        footer.addEventListener('mouseenter', () => {
            if (timerId) window.clearTimeout(timerId);
            showFooter();
        });
        footer.addEventListener('mouseleave', resetTimer);

        window.addEventListener('beforeunload', () => {
            if (timerId) window.clearTimeout(timerId);
            events.forEach(ev => window.removeEventListener(ev, resetTimer));
        });
    })();
</script>

@code{
    private string id_planilla_actual;
    private IReadOnlyDictionary<string, ACUEDUCTO.Models.MenuPermission> permissions = new Dictionary<string, ACUEDUCTO.Models.MenuPermission>();

    protected override async Task OnInitializedAsync()
    {
        await DeterminarPlanillaActual();
        var auth = await Auth.GetAuthenticationStateAsync();
        permissions = await Perms.GetPermissionsAsync(auth.User);
        if (permissions.Count == 0)
        {
            permissions = BuildDefaults(auth.User);
        }
    }

    private IReadOnlyDictionary<string, ACUEDUCTO.Models.MenuPermission> BuildDefaults(System.Security.Claims.ClaimsPrincipal user)
    {
        var dict = new Dictionary<string, ACUEDUCTO.Models.MenuPermission>(StringComparer.OrdinalIgnoreCase);
        bool isAdmin = user.IsInRole("Admin");
        bool isOperator = user.IsInRole("Operator");
        void Add(string key, bool view) => dict[key] = new ACUEDUCTO.Models.MenuPermission { MenuKey = key, CanView = view };

        if (isAdmin)
        {
            foreach (var k in new[] { "Footer-Consumos", "Footer-Recaudo", "Footer-Facturacion", "Footer-Mantenimiento" }) Add(k, true);
        }
        else if (isOperator)
        {
            foreach (var k in new[] { "Footer-Consumos", "Footer-Recaudo", "Footer-Facturacion", "Footer-Mantenimiento" }) Add(k, true);
        }
        else
        {
            foreach (var k in new[] { "Footer-Consumos" }) Add(k, true);
            foreach (var k in new[] { "Footer-Recaudo", "Footer-Facturacion", "Footer-Mantenimiento" }) Add(k, false);
        }
        return dict;
    }

    private const int MaxPeriodos = 10;
    private int CuantosDiasConsumos = 0;
    private int CuantosDiasPago = 0;
    private int CuantosDiasCorte = 0;
    private int CuantosDiasMantenimiento = 0;
    private string id_planilla_siguiente;
    private List<ConsumoPorPeriodo> consumosPorPeriodo = new List<ConsumoPorPeriodo>();

    private async Task DeterminarPlanillaActual()
    {
        using var context = DbFactory.CreateDbContext();

        var fechaActual = DateTime.Now;
        var planillaActual = await context.Planillas?
            .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                        p.FechaHoraRegistroConsumo <= fechaActual)
            .OrderByDescending(p => p.FechaHoraRegistroConsumo)
            .FirstOrDefaultAsync();

        id_planilla_actual = planillaActual?.Idplanilla ?? "No disponible";

        var planillaSiguiente = await context.Planillas
            .Where(p => p.FechaHoraRegistroConsumo.HasValue &&
                        p.FechaHoraRegistroConsumo > fechaActual)
            .OrderBy(p => p.FechaHoraRegistroConsumo)
            .FirstOrDefaultAsync();

        if (planillaSiguiente != null)
        {
            id_planilla_siguiente = planillaSiguiente.Idplanilla;
            if (planillaSiguiente.FechaHoraRegistroConsumo.HasValue)
            {
                CuantosDiasConsumos = (planillaSiguiente.FechaHoraRegistroConsumo.Value - fechaActual).Days + 1;
            }

            if (planillaActual?.FechaLimitePago != null)
            {
                CuantosDiasPago = (planillaActual.FechaLimitePago.Value.ToDateTime(TimeOnly.MinValue) - fechaActual).Days + 1;
            }
            if (planillaActual?.FechaSuspension != null)
            {
                CuantosDiasCorte = (planillaActual.FechaSuspension.Value.ToDateTime(TimeOnly.MinValue) - fechaActual).Days + 1;
            }
        }
        else
        {
            CuantosDiasConsumos = 0;
            CuantosDiasPago = 0;
        }
    }
}
