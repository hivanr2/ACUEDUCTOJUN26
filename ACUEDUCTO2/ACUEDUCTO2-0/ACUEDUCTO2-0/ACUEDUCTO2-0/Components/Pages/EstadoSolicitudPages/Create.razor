@page "/estado-solicitud/crear"
@using ACUEDUCTO2-0_0.Data
@using ACUEDUCTO2-0_0.Compartir.MODELS
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Crear estado de solicitud</PageTitle>

<h3>Crear estado de solicitud</h3>
<div class="mb-3">
    <button class="btn btn-secondary me-2" @onclick="Volver">Volver a solicitudes</button>
    <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
    <button class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
</div>

<label class="form-label">Nombre</label>
<InputText @bind-Value="nombre" class="form-control mb-2" />

@code {
    private string nombre = string.Empty;

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(nombre)) return;
        using var db = DbFactory.CreateDbContext();
        var item = new EstadoSolicitud
        {
            Guid = System.Guid.NewGuid().ToString(),
            NombreEstadoSolicitud = nombre
        };
        db.EstadoSolicitud.Add(item);
        await db.SaveChangesAsync();
        Navigation.NavigateTo("/estado-solicitud");
    }

    void Cancelar() => Navigation.NavigateTo("/estado-solicitud");
    void Volver() => Navigation.NavigateTo("/solicitud");
}
