        <EditForm method="post" Model="predio" OnValidSubmit="DeletePredio" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(predio is null)">Delete</button> |
            <a href="/predios">Back to List</a>
        </EditForm>
