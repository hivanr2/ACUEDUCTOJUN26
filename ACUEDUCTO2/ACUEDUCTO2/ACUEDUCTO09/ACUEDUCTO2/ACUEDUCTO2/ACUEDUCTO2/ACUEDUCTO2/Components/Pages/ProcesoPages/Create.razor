@page "/procesos/create"
@using ACUEDUCTO2.Share.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject ACUEDUCTO2.Services.ProcesoService ProcesoService
@inject NavigationManager Navigation

<h3>Crear proceso</h3>

<EditForm Model="proceso" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText @bind-Value="proceso.Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Objeto</label>
        <InputText @bind-Value="proceso.Objeto" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Id Tipo Proceso</label>
        <InputNumber @bind-Value="proceso.IdTipoProceso" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="(() => Navigation.NavigateTo(\"/procesos\"))">Cancelar</button>
</EditForm>

@code {
    private Proceso proceso = new Proceso();

    private async Task HandleValidSubmit()
    {
        await ProcesoService.CreateAsync(proceso);
        Navigation.NavigateTo("/procesos");
    }
}
