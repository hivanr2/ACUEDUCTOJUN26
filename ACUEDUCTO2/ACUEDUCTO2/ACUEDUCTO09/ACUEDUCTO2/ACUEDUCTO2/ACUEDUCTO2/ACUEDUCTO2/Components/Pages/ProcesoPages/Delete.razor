@page "/procesos/delete/{id}"
@using ACUEDUCTO2.Share.Models
@using Microsoft.AspNetCore.Components
@inject ACUEDUCTO2.Services.ProcesoService ProcesoService
@inject NavigationManager Navigation

<h3>Eliminar proceso</h3>

@if (proceso is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="alert alert-warning">
        <p>¿Desea eliminar el proceso <strong>@proceso.Nombre</strong>?</p>
    </div>
    <button class="btn btn-danger" @onclick="ConfirmDelete">Eliminar</button>
    <button class="btn btn-secondary ms-2" @onclick="(() => Navigation.NavigateTo(\"/procesos\"))">Cancelar</button>
}

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;

    private Proceso? proceso;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(id))
            proceso = await ProcesoService.GetByIdAsync(id);
    }

    private async Task ConfirmDelete()
    {
        if (string.IsNullOrWhiteSpace(id)) return;
        await ProcesoService.DeleteAsync(id);
        Navigation.NavigateTo("/procesos");
    }
}
