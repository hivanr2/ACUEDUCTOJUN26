@page "/procesos/edit/{id}"
@using ACUEDUCTO2.Share.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject ACUEDUCTO2.Services.ProcesoService ProcesoService
@inject NavigationManager Navigation

<h3>Editar proceso</h3>

@if (proceso is null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="proceso" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText @bind-Value="proceso.Nombre" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Objeto</label>
            <InputText @bind-Value="proceso.Objeto" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputText @bind-Value="proceso.descripcion" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Id Tipo Proceso</label>
            <InputNumber @bind-Value="proceso.IdTipoProceso" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="(() => Navigation.NavigateTo("/procesos"))">Cancelar</button>
    </EditForm>
}

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;

    private Proceso? proceso;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(id))
            proceso = await ProcesoService.GetByIdAsync(id);
    }

    private async Task HandleValidSubmit()
    {
        if (proceso is null) return;
        await ProcesoService.UpdateAsync(proceso);
        Navigation.NavigateTo("/procesos");
    }
}
