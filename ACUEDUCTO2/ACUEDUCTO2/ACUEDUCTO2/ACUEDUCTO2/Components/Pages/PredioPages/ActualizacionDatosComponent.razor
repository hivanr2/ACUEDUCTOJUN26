@page "/predio/actualizaciondatos"
@page "/proceso/Listado para Actualizacion Datos"
@layout SimpleLayout
@using ACUEDUCTO2.Components.Layout
@using ACUEDUCTO2.Share.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Linq
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
<title>
   ACTUALIZACIÓN DATOS
</title>
<style>
.table-print {
    width: 100%;
    border-collapse: collapse;
}
.table-print th, .table-print td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
}
.table-print th {
    background-color: #f0f0f0;
}
.small-text {
    font-size: 0.8em;
        width: 20px;
}
.wide-column {
    width: 200px;
}
</style>

<div class="container-fluid py-2 py-md-3">
    <h3 class="h5 mb-3">LISTADO DE ACTUALIZACIÓN DE DATOS</h3>

    @if (predios == null)
    {
        <div>Cargando...</div>
    }
    else
    {
        <table class="table-print">
            <thead>
                <tr>
                    <th class="small-text">Nombre Apellido</th>
                    <th class="small-text">Codigo Usuario</th>
                    <th>Nit o Cédula</th>
                    <th class="wide-column">Nombre</th>
                    <th>Correo Electrónico</th>
                    <th>Teléfono Celular</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var predio in predios)
                {
                    <tr>
                        <td class="small-text">@predio.ApellidosNombresUsuario</td>
                        <td class="small-text">@GetShortCode(predio.CodigoUsuario)</td>
                        <td>&nbsp;</td>
                        <td class="wide-column">&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-2">@errorMessage</div>
    }
</div>

@code {
    private IList<Predio> predios = new List<Predio>();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var context = DbFactory.CreateDbContext();
            predios = await context.Predios
                .Where(p => p.Activo == true)
                .OrderBy(p => p.ApellidosNombresUsuario)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando datos: {ex.Message}";
        }
    }

    private string GetShortCode(string? code)
    {
        if (string.IsNullOrEmpty(code)) return "";
        var parts = code.Split('-');
        return parts.Length > 1 ? parts[1] : code;
    }
}