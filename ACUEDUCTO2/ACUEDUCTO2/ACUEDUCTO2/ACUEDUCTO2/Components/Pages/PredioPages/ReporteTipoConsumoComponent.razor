<div class="d-flex justify-content-center align-items-center flex-column">

    @if (ReporteTipoConsumo is null || !ReporteTipoConsumo.Any())
    {
        <div class="text-center">
            <p><em>Cargando datos...</em></p>
        </div>
    }
    else
    {
        <div class="table-responsive mt-auto" style="max-width: 600px;">
            <table class="table table-sm table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Tipo Consumo</th>
                        <th>Rango</th>
                        <th>Cant Predios</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ReporteTipoConsumo)
                    {
                        <tr>
                            <td>@item.TipoConsumo</td>
                            <td>@item.Rango</td>
                            <td>@item.CantidadPredios</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ACUEDUCTO2.Services.PredioServices.TipoConsumoReportItem> ReporteTipoConsumo { get; set; } = new();

    [Inject]
    private ACUEDUCTO2.Services.PredioServices.PredioService PredioService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ReporteTipoConsumo = await PredioService.GetTipoConsumoReportAsync();
    }
}
