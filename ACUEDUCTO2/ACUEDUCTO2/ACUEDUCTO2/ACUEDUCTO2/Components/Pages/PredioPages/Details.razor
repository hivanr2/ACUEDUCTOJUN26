    private void LoadPredioMedia()
    {
        imageUrls.Clear();
        videoUrls.Clear();
        docUrls.Clear();
        try
        {
            var code = predio?.CodigoUsuario?.Trim();
            if (string.IsNullOrWhiteSpace(code)) return;
            var folder = System.IO.Path.Combine(Env.WebRootPath, "imagenes", code);
            if (!System.IO.Directory.Exists(folder)) return;

            var images = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
            var videos = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".mp4", ".webm", ".ogg" };
            var docs = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".ppt", ".pptx", ".odt", ".ods", ".odp", ".txt", ".zip" };

            foreach (var file in System.IO.Directory.EnumerateFiles(folder).OrderBy(f => f))
            {
                var ext = System.IO.Path.GetExtension(file);
                var name = System.IO.Path.GetFileName(file);
                var url = $"/imagenes/{Uri.EscapeDataString(code)}/{Uri.EscapeDataString(name)}";
                if (images.Contains(ext)) imageUrls.Add(url);
                else if (videos.Contains(ext)) videoUrls.Add(url);
                else if (docs.Contains(ext)) docUrls.Add((url, name));
            }
        }
        catch { }
    }

    private void DisableButton()
    {
        if (isProcessing) return;
        isProcessing = true;
        isSending = true;
        StateHasChanged();
        _ = EnviarHistorico();
    }

    private async Task EnviarHistorico()
    {
        try
        {
            var email = predio?.IdentificacionFacturacion;
            if (string.IsNullOrWhiteSpace(email)) return;

            var subject = $"Histórico de Facturas - {predio?.ApellidosNombresUsuario}";
            var body = GenerateHistoricoBody();

            await SendEmailAsync(email, subject, body);
            await JS.InvokeVoidAsync("alert", "Histórico enviado por correo electrónico.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error enviando correo: {ex.Message}");
            isSending = false; // allow retry on error
            StateHasChanged();
        }
        finally
        {
            isProcessing = false;
        }
    }

