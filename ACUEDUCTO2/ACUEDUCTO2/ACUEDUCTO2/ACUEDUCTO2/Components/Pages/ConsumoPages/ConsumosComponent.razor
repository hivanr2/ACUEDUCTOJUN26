        filtroCodigoUsuario = codigo ?? string.Empty;
        // if opening from Facturacion link and planilla is editable, enable tomaDatos
        if (!string.IsNullOrWhiteSpace(codigo) && editaPlanilla)
        {
            // enable tomaDatos so the user can edit the consumo
            tomaDatos = true;
        }
        await LoadData();
        // StateHasChanged();
    }

