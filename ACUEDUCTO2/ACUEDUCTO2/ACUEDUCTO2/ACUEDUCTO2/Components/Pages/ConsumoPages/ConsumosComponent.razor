@code {
    // ... código existente ...

    [Inject] private ConsumoOcrAppService OcrApp { get; set; } = default!;

    private IBrowserFile? selectedImage;
    private byte[]? _lastImageBytes;
    private OcrScanResult? _lastOcrResult;
    private string? _correctionSerial;
    private double? _correctionLectura;
    private string? _correctionStatus;
    private int _errorMessageVersion = 0;

    private CancellationTokenSource? _serialDebounceCts;

    private string? filtroNumeroContador;



    private IEnumerable<Facturacion> GetFacturacionFiltrada()
    {
        if (facturacion is null) return Array.Empty<Facturacion>();

        IEnumerable<Facturacion> q = facturacion;

        if (!string.IsNullOrWhiteSpace(filtroNombrePredio))
        {
            var term = filtroNombrePredio.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.ApellidosNombresUsuario ?? string.Empty)
                .Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroCodigoUsuario))
        {
            var term = filtroCodigoUsuario.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.CodigoUsuario ?? string.Empty)
                .Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        // If page was opened with 'codigo' query param, filter to that usuario only
        if (!string.IsNullOrWhiteSpace(codigo))
        {
            var term = codigo.Trim();
            q = q.Where(f => (f.IdpredioNavigation?.CodigoUsuario ?? string.Empty)
                .Equals(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroNumeroContador))
        {
            var termDigits = OnlyDigits(filtroNumeroContador);
            if (!string.IsNullOrWhiteSpace(termDigits) && termDigits.Length >= 4 && termDigits.Trim('0').Length > 0)
            {
                q = q.Where(f =>
                {
                    var digits = OnlyDigits(f.IdpredioNavigation?.NumeroMedidor);
                    if (string.IsNullOrWhiteSpace(digits)) return false;
                    if (digits.Length < 4) return false;
                    if (digits.Trim('0').Length == 0) return false; // evita "0", "00", etc.
                    return digits.Contains(termDigits) || termDigits.Contains(digits);
                });
            }
        }

        return q;
    }

    private sealed class OcrScanResult
    {
        public string? NumeroMedidor { get; set; }
        public double? LecturaActual { get; set; }
        public double? Confianza { get; set; }
    }

    private async Task SetErrorMessageAsync(string? message)
    {
        errorMessage = message;
        _errorMessageVersion++;
        var version = _errorMessageVersion;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(message)) return;

        try { await Task.Delay(5000); } catch { }

        if (version != _errorMessageVersion) return;

        errorMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        _lastImageBytes = null;
        _lastOcrResult = null;
        _correctionSerial = null;
        _correctionLectura = null;
        _correctionStatus = null;
        _ = Task.Run(() => SaveUploadedImageAsync(selectedImage));
        StateHasChanged();
    }

    private async Task SaveUploadedImageAsync(IBrowserFile? file)
    {
        if (file is null) return;

        try
        {
            var factura = GetFacturacionFiltrada().FirstOrDefault();
            var predio = factura?.IdpredioNavigation;
            var codigoUsuario = predio?.CodigoUsuario;
            if (string.IsNullOrWhiteSpace(codigoUsuario)) return;

            var predioNombre = predio?.ApellidosNombresUsuario ?? predio?.Direccion ?? "Predio";
            predioNombre = SanitizeFileName(predioNombre);

            var dateStamp = DateTime.Now.ToString("d", CultureInfo.GetCultureInfo("es-CO"));
            dateStamp = dateStamp.Replace("/", string.Empty).Replace("-", string.Empty).Replace(" ", string.Empty);

            var ext = Path.GetExtension(file.Name);
            if (string.IsNullOrWhiteSpace(ext)) ext = ".jpg";
            ext = ext.StartsWith('.') ? ext : "." + ext;

            var safeFileName = $"{predioNombre}_{dateStamp}{ext}";

            var folder = Path.Combine(Env.WebRootPath, "imagenes", codigoUsuario);
            Directory.CreateDirectory(folder);

            var fullPath = Path.Combine(folder, safeFileName);
            await using var read = file.OpenReadStream(maxAllowedSize: 15_000_000);
            await using var write = File.Create(fullPath);
            await read.CopyToAsync(write);
        }
        catch
        {
            // best-effort save; OCR flow must continue even if file I/O fails
        }
    }

    private static string SanitizeFileName(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = string.Join("_", input.Split(invalid, StringSplitOptions.RemoveEmptyEntries)).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "Predio" : cleaned;
    }

    private async Task OnSerialChanged()
    {
        _serialDebounceCts?.Cancel();
        _serialDebounceCts?.Dispose();
        _serialDebounceCts = new CancellationTokenSource();
        var ct = _serialDebounceCts.Token;

        // Espera un poco a que el usuario termine de escribir
        try { await Task.Delay(600, ct); } catch { return; }

        // Setear filtro de contador automáticamente con el serial (tal como lo escribió el usuario)
        if (!string.IsNullOrWhiteSpace(_correctionSerial))
        {
            await InvokeAsync(() =>
            {
                filtroNumeroContador = _correctionSerial;
                StateHasChanged();
            });
        }

        var serialDigits = OnlyDigits(_correctionSerial);
        if (string.IsNullOrWhiteSpace(serialDigits) || serialDigits.Length < 4) return;

        // Requiere lectura para poder aplicar el valor automáticamente
        if (_correctionLectura is null) return;

        var match = FindFacturaByMeterDigits(serialDigits);
        if (match is null) return;

        match.MedicionActual = _correctionLectura;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFiltroNumeroContadorChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void ClearFiltroNumeroContador()
    {
        filtroNumeroContador = null;
        StateHasChanged();
    }

    private static string OnlyDigits(string? input)
        => string.IsNullOrWhiteSpace(input) ? string.Empty : Regex.Replace(input, "\\D+", string.Empty);



    private Facturacion? FindFacturaByMeterDigits(string serialDigits)
    {
        if (facturacion is null || facturacion.Count == 0) return null;

        Facturacion? bestFactura = null;
        var bestScore = 0;

        foreach (var f in facturacion)
        {
            var digits = OnlyDigits(f.IdpredioNavigation?.NumeroMedidor);
            if (string.IsNullOrWhiteSpace(digits)) continue;

            var score = LongestCommonEdgeMatch(digits, serialDigits);
            if (score > bestScore)
            {
                bestScore = score;
                bestFactura = f;
            }
        }

        // mínimo 4 dígitos para evitar falsos positivos
        return bestScore >= 4 ? bestFactura : null;
    }

    private static int LongestCommonEdgeMatch(string a, string b)
    {
        if (string.IsNullOrEmpty(a) || string.IsNullOrEmpty(b)) return 0;

        var max = Math.Min(a.Length, b.Length);
        var best = 0;
        for (var len = 1; len <= max; len++)
        {
            if (a.EndsWith(b[^len..], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (a.StartsWith(b[..len], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (b.EndsWith(a[^len..], StringComparison.Ordinal)) best = Math.Max(best, len);
            if (b.StartsWith(a[..len], StringComparison.Ordinal)) best = Math.Max(best, len);
        }
        return best;
    }

    public async Task RegistroAutomatico()
    {
        if (_registroAutomaticoEnProceso)
        {
            return;
        }

        if (selectedImage == null)
        {
            await SetErrorMessageAsync("Por favor, selecciona una imagen.");
            return;
        }

        try
        {
            _registroAutomaticoEnProceso = true;
            _registroAutomaticoEstado = "Processing...";
            await InvokeAsync(StateHasChanged);

            _registroAutomaticoEstado = "Reading image...";
            await InvokeAsync(StateHasChanged);

            await using var stream = selectedImage.OpenReadStream(maxAllowedSize: 15_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _lastImageBytes = ms.ToArray();

            _registroAutomaticoEstado = "Running OCR...";
            await InvokeAsync(StateHasChanged);

            var scan = await OcrApp.ScanAsync(new MemoryStream(_lastImageBytes), CancellationToken.None);

            var result = new OcrScanResult
            {
                NumeroMedidor = scan.NumeroMedidor,
                LecturaActual = scan.LecturaActual,
                Confianza = scan.Confianza
            };

            _lastOcrResult = result;
            _correctionSerial = result.NumeroMedidor;
            _correctionLectura = result.LecturaActual;
            _correctionStatus = null;
            filtroNumeroContador = _correctionSerial;

            _registroAutomaticoEstado = "Applying results...";
            await InvokeAsync(StateHasChanged);

            if (result.LecturaActual is null)
            {
                await SetErrorMessageAsync("No fue posible detectar la lectura del medidor en la imagen.");
                return;
            }

            var serial = string.IsNullOrWhiteSpace(result.NumeroMedidor) ? "N/A" : result.NumeroMedidor;
            var confTxt = result.Confianza is null ? "N/A" : result.Confianza.Value.ToString("N0", CultureInfo.InvariantCulture) + "%";
            await SetErrorMessageAsync($"Lectura: {result.LecturaActual:0} | Serial: {serial} | Confianza: {confTxt}");
        }
        catch (Exception ex)
        {
            await SetErrorMessageAsync($"Error: {ex.Message}");
        }
        finally
        {
            _registroAutomaticoEnProceso = false;
            _registroAutomaticoEstado = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    private sealed class OcrCorrectionRequest
    {
        public required string ImageBase64 { get; set; }
        public string? NumeroMedidor { get; set; }
        public double? LecturaM3 { get; set; }

        public string? IdPlanilla { get; set; }
    }

    private async Task SaveOcrCorrectionAsync()
    {
        if (_lastImageBytes is null)
        {
            _correctionStatus = "No image data to save.";
            return;
        }

        var req = new OcrCorrectionRequest
        {
            ImageBase64 = Convert.ToBase64String(_lastImageBytes),
            NumeroMedidor = string.IsNullOrWhiteSpace(_correctionSerial) ? null : _correctionSerial.Trim(),
            LecturaM3 = _correctionLectura,
            IdPlanilla = id
        };

        try
        {
            var save = await OcrApp.SaveCorrectionAsync(
                imageBytes: _lastImageBytes,
                numeroMedidor: req.NumeroMedidor,
                lecturaM3: req.LecturaM3,
                idPlanilla: req.IdPlanilla,
                cancellationToken: CancellationToken.None);

            _correctionStatus = $"Correction {save.Status}.";
        }
        catch (Exception ex)
        {
            _correctionStatus = $"Failed to save: {ex.Message}";
        }
    }

    private async Task MoveUp(Facturacion factura)
    {
        if (!editaPlanilla) return;
        using var context = DbFactory.CreateDbContext();
        // Get all facturas in the planilla ordered
        var allFacturas = await context.Facturacions
            .Where(f => f.Idplanilla == id)
            .Include(f => f.IdpredioNavigation)
            .OrderBy(f => f.IdpredioNavigation.Ruta)
            .ToListAsync();
        // Find the index of the current factura
        int index = allFacturas.FindIndex(f => f.Idfactura == factura.Idfactura);
        if (index <= 0) return; // cannot move up
        // Swap routes with the previous one
        var current = allFacturas[index];
        var previous = allFacturas[index - 1];
        double temp = current.IdpredioNavigation.Ruta ?? 0;
        current.IdpredioNavigation.Ruta = previous.IdpredioNavigation.Ruta;
        previous.IdpredioNavigation.Ruta = temp;
        // Save changes
        try
        {
            await context.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            await SetErrorMessageAsync($"Error moving up: {ex.Message}");
            return;
        }
        // Renumber all routes consecutively
        var allPredios = allFacturas.Select(f => f.IdpredioNavigation).OrderBy(p => p.Ruta).ToList();
        double routeNumber = 1;
        foreach (var predio in allPredios)
        {
            predio.Ruta = routeNumber;
            routeNumber++;
        }
        await context.SaveChangesAsync();
        // Update the local list
        foreach (var f in facturacion)
        {
            var updated = allFacturas.FirstOrDefault(af => af.Idfactura == f.Idfactura);
            if (updated != null)
            {
                f.IdpredioNavigation.Ruta = updated.IdpredioNavigation.Ruta;
            }
        }
        StateHasChanged();
    }

    private async Task MoveDown(Facturacion factura)
    {
        if (!editaPlanilla) return;
        using var context = DbFactory.CreateDbContext();
        // Get all facturas in the planilla ordered by route
        var allFacturas = await context.Facturacions
            .Where(f => f.Idplanilla == id)
            .Include(f => f.IdpredioNavigation)
            .OrderBy(f => f.IdpredioNavigation.Ruta)
            .ToListAsync();
        // Find the index of the current factura
        int index = allFacturas.FindIndex(f => f.Idfactura == factura.Idfactura);
        if (index >= allFacturas.Count - 1 || index < 0) return; // cannot move down
        // Swap routes with the next one
        var current = allFacturas[index];
        var next = allFacturas[index + 1];
        double temp = current.IdpredioNavigation.Ruta ?? 0;
        current.IdpredioNavigation.Ruta = next.IdpredioNavigation.Ruta;
        next.IdpredioNavigation.Ruta = temp;
        // Save changes
        try
        {
            await context.SaveChangesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await SetErrorMessageAsync($"Error moving down: {ex.Message}");
            return;
        }
        // Renumber all routes consecutively
        var allPredios = allFacturas.Select(f => f.IdpredioNavigation).OrderBy(p => p.Ruta).ToList();
        double routeNumber = 1;
        foreach (var predio in allPredios)
        {
            predio.Ruta = routeNumber;
            routeNumber++;
        }
        await context.SaveChangesAsync();
        // Update the local list
        foreach (var f in facturacion)
        {
            var updated = allFacturas.FirstOrDefault(af => af.Idfactura == f.Idfactura);
            if (updated != null)
            {
                f.IdpredioNavigation.Ruta = updated.IdpredioNavigation.Ruta;
            }
        }
        StateHasChanged();
    }

    private async Task FiltrarPorCodigo(string codigo)
