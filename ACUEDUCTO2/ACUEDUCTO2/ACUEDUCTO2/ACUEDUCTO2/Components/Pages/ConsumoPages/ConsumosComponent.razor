@page "/consumoscomponent"
@layout SimpleLayout
@using ACUEDUCTO2.Components.Layout
@using ACUEDUCTO2.Share.Models
@using Facturacion = ACUEDUCTO2.Share.Models.Factura
@* QuickGrid removed - not available in this target. Use plain lists/tables *@
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager nav
@inject ACUEDUCTO2.Services.Email.EmailService EmailService
@using ACUEDUCTO2.Services
@using System.Globalization
@inject ACUEDUCTO2.Services.IWhatsAppService WhatsAppService
@inject ACUEDUCTO2.Services.IPdfService PdfService
@inject IWebHostEnvironment Env
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@using System.Text.RegularExpressions

@rendermode InteractiveServer

<style>
    @@media (max-width: 768px) {
        .table-container.table-responsive table {
            min-width: 860px;
        }

        .table-container input.form-control-lg {
            padding-top: .35rem;
            padding-bottom: .35rem;
            font-size: 1.1rem;
        }

        /* Mobile capture mode: keep header/footer visible, scroll list in the center */
        .consumos-mobile-shell {
            height: calc(100svh - 220px);
            min-height: 220px;
        }
        .consumos-mobile-list {
            height: 100%;
            overflow: auto;
            -webkit-overflow-scrolling: touch;
        }

        .consumos-mobile-card-a {
            border-left: 6px solid #6ea8fe;
            border-top-left-radius: .5rem;
            border-bottom-left-radius: .5rem;
        }

        .consumos-mobile-card-b {
            border-left: 6px solid #a3cfbb;
            border-top-left-radius: .5rem;
            border-bottom-left-radius: .5rem;
        }

        .consumos-mobile-list .card.consumos-mobile-card-a {
            background-color: #e7f1ff !important;
        }

        .consumos-mobile-list .card.consumos-mobile-card-b {
            background-color: #eaf7f0 !important;
        }

        .consumos-mobile-list .consumos-mobile-card-a > .card-body,
        .consumos-mobile-list .consumos-mobile-card-b > .card-body {
            background-color: rgba(255, 255, 255, 0.55) !important;
        }
        /* Make note areas full width on mobile for better UX */
        .notes-col, .note-block {
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
            display: block;
        }
        /* Center control checkboxes and actions on mobile to avoid overflow.
           Show checkboxes side-by-side by using inline-flex and auto width. */
        .controls-row {
            justify-content: center !important;
        }
        .controls-row .form-check {
            display: inline-flex !important;
            justify-content: center !important;
            align-items: center !important;
            width: auto !important;
            margin: .25rem !important;
        }
        /* smaller filter link on mobile */
        .btn-link.small {
            font-size: .85rem;
            padding: 0;
        }
    }
    /* Fixed width for observation/notes columns so both occupy the same space on desktop */
    .notes-col { width: 220px; max-width: 220px; }
    .note-block { min-width: 220px; max-width: 220px; }

    /* Responsive: override fixed widths on small screens */
    @@media (max-width: 768px) {
        .notes-col, .note-block {
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
            display: block;
        }
    }
</style>


<!-- Encabezado moderno con navegación -->
<div class="container-fluid @(tomaDatos ? "p-0" : "py-2 py-md-3")">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
            @if (facturacion != null && facturacion.Count == 1)
            {
                @if (@id_planilla_anterior != "No disponible")
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/consumoscomponent?id=@id_planilla_anterior" target="_self" title="Anterior">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                }
            }
            <h3 class="h5 mb-0">CONSUMOS :: @str_planilla</h3>
            @if (facturacion != null && facturacion.Count == 1)
            {
                @if (@id_planilla_siguiente != "No disponible")
                {
                    <a class="btn btn-outline-secondary btn-sm" href="/consumoscomponent?id=@id_planilla_siguiente" target="_self" title="Siguiente">
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            }
        </div>
        <div class="text-nowrap">
            <span class="badge bg-primary-subtle text-primary border">Periodo: <strong>@str_periodo_largo</strong></span>
        </div>
    </div>

    @if (!editaPlanilla)
    {
        <div class="alert alert-warning py-2 mb-2 text-center">
            La planilla está cerrada. La edición está deshabilitada.
        </div>
    }

    @if (mostrar && !tomaDatos)
    {
        <div class="alert alert-info py-2 mb-2 d-flex flex-wrap gap-2 align-items-center">
            <div>
                <strong>Fecha Toma de Consumos:</strong>
                <span>@(FechaTomaConsumoPlanilla.HasValue? FechaTomaConsumoPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
            <div>
                <strong>Último día de Pago:</strong>
                <span>@(FechaUltimoPagoPlanilla.HasValue? FechaUltimoPagoPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
            <div>
                <strong>Fecha de Suspensión:</strong>
                <span>@(FechaSuspensionPlanilla.HasValue? FechaSuspensionPlanilla.Value.ToString("D", new CultureInfo("es-CO")) : "")</span>
            </div>
                <div class="ms-auto">
                <a class="btn btn-outline-primary btn-sm" href="/periodos/edit?idplanilla=@id" title="Editar periodo" target="_blank">
                    <i class="bi bi-pencil-square"></i> Edita
                </a>
            </div>
        </div>
    }

    <!-- Controles principales -->
    @if (facturacion is not null && facturacion.Count > 0)
    {
        <div class="card shadow-sm mb-2">
            <div class="card-body py-2">
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-lg-auto d-flex justify-content-center align-items-center gap-2">
                            <InputFile OnChange="OnImageSelected" accept="image/*" class="form-control form-control-sm" style="width: 200px;" />
                            <button class="btn btn-primary btn-sm" @onclick="RegistroAutomatico" disabled="@(!editaPlanilla || _registroAutomaticoEnProceso)">
                                @if (_registroAutomaticoEnProceso)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>@_registroAutomaticoEstado</span>
                                }
                                else
                                {
                                    <span>Registro Automático</span>
                                }
                            </button>
                            @if (!tomaDatos)
                            {
                                <button class="btn btn-secondary btn-sm d-none d-md-inline-block" @onclick="PrintTextOnlyVersion">
                                    <i class="bi bi-printer"></i> Formato de Impresión de Consumos
                                </button>
                            }
                        </div>
                        <div class="col-12 col-lg d-flex flex-wrap align-items-center gap-3 justify-content-lg-end controls-row">
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <div class="form-check form-switch">
                                    <input type="checkbox" id="tomaDatos" class="form-check-input" @bind="tomaDatos" @bind:after="OnTomaDatosToggled" disabled="@(!editaPlanilla)" />
                                    <label for="tomaDatos" class="form-check-label">Toma Datos</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input type="checkbox" id="editarRuta" class="form-check-input" @bind="editarRuta" disabled="@(!editaPlanilla)" />
                                    <label for="editarRuta" class="form-check-label">Editar Ruta</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input type="checkbox" id="editarObservaciones" class="form-check-input" @bind="editarObservaciones" disabled="@(!editaPlanilla)" />
                                    <label for="editarObservaciones" class="form-check-label">Editar Observaciones Predio</label>
                                </div>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <div class="input-group input-group-sm" style="width: 180px;">
                                    <input id="filtroNombrePredio" class="form-control" placeholder="Filtrar predio" @bind="filtroNombrePredio" @bind:event="oninput" @bind:after="OnFiltroNombrePredioChanged" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroNombrePredio" title="Limpiar filtro">×</button>
                                </div>
                                <div class="input-group input-group-sm" style="width: 140px;">
                                    <input id="filtroCodigoUsuario" class="form-control" placeholder="Filtrar código" @bind="filtroCodigoUsuario" @bind:event="oninput" @bind:after="OnFiltroCodigoUsuarioChanged" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroCodigoUsuario" title="Limpiar filtro">×</button>
                                </div>
                                <div class="input-group input-group-sm" style="width: 170px;">
                                    <input id="filtroNumeroContador" class="form-control" placeholder="Filtrar contador" @bind="filtroNumeroContador" @bind:event="oninput" @bind:after="OnFiltroNumeroContadorChanged" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearFiltroNumeroContador" title="Limpiar filtro">×</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Tabla principal *@
    @if (facturacion == null)
    {
        <div>Cargando...</div>
    }
    else if (facturacion.Count > 0)
    {
        @* Mobile: when data capture is enabled, use a card layout for easier input.
           The list scrolls in the center so header and footer remain visible. *@
        <div class="d-md-none">
            <div class="consumos-mobile-shell">
                <div class="consumos-mobile-list">
                    @{ var facturacionFiltradaMobile = GetFacturacionFiltrada().ToList(); }
                    @for (int i = 0; i < facturacionFiltradaMobile.Count; i++)
                    {
                        var factura = facturacionFiltradaMobile[i];
                        <div class="card shadow-sm mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between gap-2">
                                    @if (editarRuta)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="small text-muted">Ruta: <strong>@factura.IdpredioNavigation.Ruta</strong></div>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveUp(factura)" title="Subir" disabled="@(!editaPlanilla)">
                                                    <i class="bi bi-arrow-up"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveDown(factura)" title="Bajar" disabled="@(!editaPlanilla)">
                                                    <i class="bi bi-arrow-down"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">Ruta: <strong>@factura.IdpredioNavigation.Ruta</strong></div>
                                    }
                                    <div class="small text-muted">Medidor: <strong>@factura.IdpredioNavigation.NumeroMedidor</strong></div>
                                </div>

                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <div class="fw-semibold">@factura.IdpredioNavigation.ApellidosNombresUsuario</div>
                                        <a class="small" href="/predios/details?idpredio=@factura.Idpredio" target="_blank">Ver</a>
                                    <button type="button" class="btn btn-link p-0 text-decoration-underline small" title="Filtrar por código" @onclick="() => FiltrarPorCodigo(factura.CodigoUsuario ?? string.Empty)">@factura.CodigoUsuario</button>
                                </div>
                                <div class="small text-muted">@factura.IdpredioNavigation.Direccion</div>

                                @* Mostrar observaciones del predio solo cuando se está editando observaciones *@
                                @if (editarObservaciones)
                                {
                                    <div class="mt-2">
                                        <div class="small text-muted">Observaciones</div>
                                        @if (editaPlanilla && editarObservaciones)
                                        {
                                            <textarea class="form-control form-control-sm mt-1 note-block" value="@factura.IdpredioNavigation.Observaciones" @onchange="async (e) => await OnObservacionesPredioChanged(factura, e)"></textarea>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mt-1 note-block">@(!string.IsNullOrWhiteSpace(factura.IdpredioNavigation.Observaciones) ? factura.IdpredioNavigation.Observaciones : "N/A")</div>
                                        }
                                    </div>
                                    @* Notas Factura: mostrar solo cuando se activa Ver Observaciones Predio *@
                                    <div class="mt-2">
                                        <div class="small text-muted">Notas Factura</div>
                                        @if (editaPlanilla)
                                        {
                                            <textarea class="form-control form-control-sm mt-1 note-block" @bind="factura.NotasFactura" @bind:after="async () => await OnNotasFacturaChanged(factura)"></textarea>
                                        }
                                        else
                                        {
                                            <div class="small text-muted mt-1 note-block">@(!string.IsNullOrWhiteSpace(factura.NotasFactura) ? factura.NotasFactura : "N/A")</div>
                                        }
                                    </div>
                                }

                                <div class="row g-2 mt-2 align-items-end">
                                    <div class="col-6">
                                        <label class="form-label small mb-1">Anterior</label>
                                        <input class="form-control" value="@factura.MedicionAnterior" readonly />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small mb-1">Actual</label>
                                        <input type="number" inputmode="numeric" pattern="[0-9]*"
                                               class="form-control form-control-lg"
                                               value="@factura.MedicionActual"
                                               @onfocus="() => OnFocusedFacturaChanged(factura.Idfactura)"
                                               @onchange="async (e) => await OnMedicionActualChanged(factura, e)"
                                               tabindex="@((i * 1000) + 1)"
                                               disabled="@(!(editaPlanilla && tomaDatos))" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between mt-2">
                                    <div class="small">Consumo: <strong>@factura.ConsumoM3</strong></div>
                                    <div class="small">Valor: <strong>@FormatCurrency(factura.ValorConsumo)</strong></div>
                                </div>

                                @if (factura.MedicionActual.HasValue && factura.MedicionAnterior.HasValue && factura.MedicionActual.Value >= factura.MedicionAnterior.Value)
                                {
                                    <div class="d-flex justify-content-end mt-2">
                                        @if (factura.IdpredioNavigation.ImprimeFactura ?? false)
                                        {
                                            @if (!editaPlanilla)
                                            {
                                                <a class="btn btn-outline-primary btn-sm" title="Ver Factura (PDF)" href="@($"/imagenes/{factura.IdpredioNavigation.CodigoUsuario}/{factura.CodigoFactura}.pdf")" target="_blank">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary btn-sm" title="Imprimir / Ver Factura" @onclick="() => OpenPrintWindow(factura.Idfactura)">
                                                    <i class="bi bi-printer"></i>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Factura</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Desktop/tablet: keep the original table *@
        <div class="d-none d-md-block">
            <div class="table-container table-responsive">
                <table class="table table-sm table-hover table-striped align-middle fixed-header">
                <thead class="table-light">
                    <tr>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("Ruta")'>Ruta</th>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("Predio")'>Predio</th>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("Anterior")'>Anterior</th>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("Actual")' class="border-blue">Actual</th>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("ConsumoM3")' class="border-blue">ConsumoM3</th>
                        <th scope="col" role="button" title="Ordenar" @onclick='() => OnHeaderClick("Valor Consumo")'>Valor Consumo</th>
                        @if(!tomaDatos)
                        {
                            <th scope="col">Seguimiento</th>
                        }
                        @if (editarObservaciones)
                        {
                            <th scope="col" class="notes-col">Notas Predio</th>
                        }
                        @if (editarObservaciones)
                        {
                            <th scope="col" class="notes-col">Notas Factura</th>
                        }
                        <th scope="col">Factura</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var facturacionFiltrada = GetFacturacionFiltrada().ToList(); }
                    @for (int i = 0; i < facturacionFiltrada.Count; i++)
                    {
                        var factura = facturacionFiltrada[i];
                        <tr>
                            <td class="text-center">
                                @if (editarRuta)
                                {
                                    <div>@factura.IdpredioNavigation.Ruta</div>
                                    <div class="d-flex justify-content-center gap-1 mt-1">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveUp(factura)" title="Subir" disabled="@(!editaPlanilla)">
                                            <i class="bi bi-arrow-up"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveDown(factura)" title="Bajar" disabled="@(!editaPlanilla)">
                                            <i class="bi bi-arrow-down"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    @factura.IdpredioNavigation.Ruta
                                }
                            </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fw-semibold">@factura.IdpredioNavigation.ApellidosNombresUsuario</div>
                                        <a class="small" href="/predios/details?idpredio=@factura.Idpredio" target="_blank">Ver</a>
                                <button type="button" class="small ms-2 btn btn-link p-0 text-decoration-underline" title="Filtrar por código" @onclick="() => FiltrarPorCodigo(factura.CodigoUsuario ?? factura.IdpredioNavigation?.CodigoUsuario ?? string.Empty)">@((factura.CodigoUsuario ?? factura.IdpredioNavigation?.CodigoUsuario) ?? string.Empty)</button>
                                    </div>
                                    <div class="small text-muted">@factura.IdpredioNavigation.Direccion - #@factura.IdpredioNavigation.NumeroMedidor</div>
                                </td>
                            <td class="text-center">@factura.MedicionAnterior</td>
                            <td class="text-center border-blue">
                                <div>@factura.MedicionActual</div>
                                @if (editaPlanilla && tomaDatos)
                                {
                                    <input type="number" inputmode="numeric" pattern="[0-9]*"
                                           class="form-control @(tomaDatos ? "form-control-lg" : "form-control-sm") mt-1"
                                           style="min-width: 7.5rem;"
                                           value="@factura.MedicionActual"
                                           @onchange="async (e) => await OnMedicionActualChanged(factura, e)"
                                           tabindex="@((i * 1000) + 1)"
                                           disabled="@(!editaPlanilla)" />
                                }
                            </td>
                            <td class="text-center border-blue"><span class="h6 mb-0">@factura.ConsumoM3</span></td>
                            <td class="text-center">
                                <div>@FormatCurrency(factura.ValorConsumo)</div>
                            </td>
                            @if (!tomaDatos)
                            {
                                <td class="text-center">
                                    @if(editaPlanilla){
                                        <input type="checkbox" @bind="factura.IdpredioNavigation.ContadorEnSeguimiento" tabindex="@((i * 1000) + 3)" disabled="@(!editaPlanilla)" />
                                    }else{
                                        <input type="checkbox" readonly @bind="factura.IdpredioNavigation.ContadorEnSeguimiento" tabindex="@((i * 1000) + 3)" disabled="@(!editaPlanilla)" />
                                    }
                                </td>
                            }
                            @if (editarObservaciones)
                            {
                                <td>
                                    @if (editaPlanilla && editarObservaciones)
                                    {
                                        <textarea class="form-control form-control-sm mt-1 note-block" value="@factura.IdpredioNavigation.Observaciones" @onchange="async (e) => await OnObservacionesPredioChanged(factura, e)" tabindex="@((i * 1000) + 4)"></textarea>
                                    }
                                    else
                                    {
                                        <div class="small text-muted note-block">@(!string.IsNullOrWhiteSpace(factura.IdpredioNavigation.Observaciones) ? factura.IdpredioNavigation.Observaciones : "N/A")</div>
                                    }
                                </td>
                            }
                            @if (editarObservaciones)
                            {
                                <td>
                                    <div class="small note-block">@factura.NotasFactura</div>
                                    @if (editaPlanilla)
                                    {
                                        <textarea class="form-control form-control-sm mt-1 note-block" @bind="factura.NotasFactura" @bind:after="async () => await OnNotasFacturaChanged(factura)" tabindex="@((i * 1000) + 4)" disabled="@(!editaPlanilla)"></textarea>
                                    }
                                </td>
                            }
                            <td>
                                @if (factura.MedicionActual.HasValue && factura.MedicionAnterior.HasValue && factura.MedicionActual.Value >= factura.MedicionAnterior.Value)
                                {
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (factura.IdpredioNavigation.ImprimeFactura ?? false)
                                        {
                                            @* If planilla closed show static pdf from wwwroot/imagenes/{codigoUsuario}/{codigoDocumento}.pdf, otherwise keep current behavior *@
                                            @if (!editaPlanilla)
                                            {
                                                <a class="btn btn-outline-primary" title="Ver Factura (PDF)" href="@($"/imagenes/{factura.IdpredioNavigation.CodigoUsuario}/{factura.CodigoFactura}.pdf")" target="_blank"><i class="bi bi-printer"></i></a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary" title="Imprimir / Ver Factura" @onclick="() => OpenPrintWindow(factura.Idfactura)"><i class="bi bi-printer"></i></button>
                                            }
                                        }
                                        @if (factura.IdpredioNavigation.EnviaWhatsapp ?? false)
                                        {
                                            <button class="btn btn-success" title="WhatsApp" @onclick="() => EnviarPorWhatsApp(factura)"><i class="bi bi-whatsapp"></i></button>
                                        }
                                        @if (factura.IdpredioNavigation.EnviaCorreo ?? false)
                                        {
                                            @if (PuedeEnviarCorreo(factura) && !sentEmails.Contains(factura.Idfactura))
                                            {
                                                <button class="btn btn-info" title="Correo" @onclick="() => EnviarPorCorreo(factura)"><i class="bi bi-envelope"></i></button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-info" title="@GetCorreoDisabledTitle(factura)" disabled><i class="bi bi-envelope"></i></button>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Consumo no Registrado</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="table-secondary fw-semibold">
                        <td colspan="5" class="text-end">Total ConsumoM3</td>
                        <td class="text-center border-blue">@totalConsumoM3</td>
                    </tr>
                    <tr>
                        <td colspan="6">
                            <input type="text" id="nombreRegistrador" class="form-control" placeholder="Nombre de quien registra los consumos" value="@nombreRegistrador"
                                   @onchange="OnNombreRegistradorChanged" disabled="@(!editaPlanilla)" />
                        </td>
                    </tr>
                </tbody>
                </table>
            </div>
        </div>

        <style>
            .table-container {
