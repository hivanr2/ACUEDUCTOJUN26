@page "/tipo-solicitud/eliminar/{guid}"
@using ACUEDUCTO2.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Eliminar tipo de solicitud</PageTitle>

<h3>Eliminar tipo de solicitud</h3>

<div class="mb-3">
    <button class="btn btn-secondary me-2" @onclick="Volver">Volver a solicitudes</button>
</div>

@if (item == null)
{
    <p>Cargando...</p>
}
else
{
    <p>¿Eliminar el tipo: <strong>@item.NombreTipoSolicitud</strong> ?</p>
    <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
    <button class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
}

@code {
    [Parameter]
    public string guid { get; set; } = string.Empty;

    private TipoSolicitud? item;

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        item = await db.TipoSolicitud.FirstOrDefaultAsync(x => x.Guid == guid);
    }

    private async Task ConfirmarEliminar()
    {
        if (item == null) return;
        using var db = DbFactory.CreateDbContext();
        var dbItem = await db.TipoSolicitud.FirstOrDefaultAsync(x => x.Guid == item.Guid);
        if (dbItem == null) return;
        db.TipoSolicitud.Remove(dbItem);
        await db.SaveChangesAsync();
        Navigation.NavigateTo("/tipo-solicitud");
    }

    void Cancelar() => Navigation.NavigateTo("/tipo-solicitud");
    void Volver() => Navigation.NavigateTo("/solicitud");
}
