@page "/autorizados"
@page "/proceso/Listado de Autorizados"
@page "/proceso/Listado Autorizados"
@page "/proceso/Actualizacion Datos Autorizado"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO2.Data
@using ACUEDUCTO2.Share.Models
@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Autorizados</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 mb-0">Autorizados</h1>
            <small class="text-muted">Personas autorizadas a ver predios</small>
        </div>
        <a class="btn btn-primary" href="/autorizados/crear">Nuevo Autorizado</a>
    </div>

    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <strong>ℹ️ Importante:</strong> Si la persona que desea autorizar no se encuentra registrada, primero debe crear una cuenta en el sistema y verificar su correo electrónico. Solo los usuarios registrados y con correo verificado pueden ser autorizados para consultar información de predios.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            @mensaje
            <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
        </div>
    }

    @if (!cargado)
    {
        <div class="text-center text-muted py-5">Cargando...</div>
    }
    else if (esAdmin)
    {
        <div class="row g-2 align-items-center mb-3">
            <div class="col-12 col-md-6">
                <input type="search" class="form-control" @bind="filtro" @bind:event="oninput" placeholder="Buscar por identificación o nombre..." />
            </div>
            <div class="col-auto">
                <span class="badge bg-secondary">@AutorizadosFiltrados.Count() registros</span>
            </div>
        </div>

        @if (autorizacionesDadas.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between">
                    <strong>Todas las Autorizaciones</strong>
                    <span class="badge bg-primary">@AutorizadosFiltrados.Count()</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Quién Autoriza</th>
                                    <th>A Quién Autoriza</th>
                                    <th>Fecha</th>
                                    <th>Observaciones</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in AutorizadosFiltrados)
                                {
                                    <tr>
                                        <td>
                                            <div>@a.QuienAutoriza</div>
                                            @if (nombresCache.TryGetValue(a.QuienAutoriza ?? "", out var nqa))
                                            {
                                                <small class="text-muted">@nqa</small>
                                            }
                                        </td>
                                        <td>
                                            <div>@a.AQueAutoriza</div>
                                            @if (nombresCache.TryGetValue(a.AQueAutoriza ?? "", out var naa))
                                            {
                                                <small class="text-muted">@naa</small>
                                            }
                                        </td>
                                        <td>@a.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><small>@(a.Observaciones ?? "—")</small></td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a class="btn btn-outline-primary" href="@($"/autorizados/details/{a.Guid}")">Ver</a>
                                                <a class="btn btn-outline-secondary" href="@($"/autorizados/edit/{a.Guid}")">Editar</a>
                                                <a class="btn btn-outline-danger" href="@($"/autorizados/delete/{a.Guid}")">Revocar</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">No hay autorizaciones registradas.</div>
        }
    }
    else
    {
        @* Vista de usuario normal: predios a los que tiene acceso *@

        @if (prediosAutorizados.Count > 0)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between">
                    <strong>Predios a los que Tiene Acceso</strong>
                    <span class="badge bg-success">@prediosAutorizados.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Autorizado por</th>
                                    <th>Predio</th>
                                    <th>Dirección</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in prediosAutorizados)
                                {
                                    <tr>
                                        <td>
                                            <div>@item.QuienAutoriza</div>
                                            @if (!string.IsNullOrWhiteSpace(item.NombreQuienAutoriza))
                                            {
                                                <small class="text-muted">@item.NombreQuienAutoriza</small>
                                            }
                                        </td>
                                        <td>@item.Predio.ApellidosNombresUsuario</td>
                                        <td>@(item.Predio.Direccion ?? "—")</td>
                                        <td>
                                            <span class="badge @(item.Predio.Activo == true ? "bg-success" : "bg-danger")">
                                                @(item.Predio.Activo == true ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm" href="@($"/predios/details?idpredio={item.Predio.IdPredio}")" target="_blank">Ver Predio</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (autorizacionesOtorgadas.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between">
                    <strong>Autorizaciones que Usted Otorgó</strong>
                    <span class="badge bg-primary">@autorizacionesOtorgadas.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>A Quién Autorizó</th>
                                    <th>Fecha</th>
                                    <th>Observaciones</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in autorizacionesOtorgadas)
                                {
                                    <tr>
                                        <td>
                                            <div>@a.AQueAutoriza</div>
                                            @if (nombresCache.TryGetValue(a.AQueAutoriza ?? "", out var n))
                                            {
                                                <small class="text-muted">@n</small>
                                            }
                                        </td>
                                        <td>@a.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><small>@(a.Observaciones ?? "—")</small></td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-danger btn-sm" href="@($"/autorizados/delete/{a.Guid}")">Revocar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (prediosAutorizados.Count == 0 && !autorizacionesOtorgadas.Any())
        {
            <div class="alert alert-info">No tiene predios autorizados ni autorizaciones registradas.</div>
        }
    }
</div>

@code {
    private ApplicationUser? usuarioActual;
    private bool esAdmin;
    private bool cargado;
    private string? mensaje;
    private bool esError;
    private string filtro = "";

    // Admin: todas las autorizaciones
    private List<Autorizado> autorizacionesDadas = [];
    private Dictionary<string, string> nombresCache = new(StringComparer.OrdinalIgnoreCase);

    // No-admin: predios a los que tiene acceso
    private List<PredioAutorizadoView> prediosAutorizados = [];
    private List<Autorizado> autorizacionesOtorgadas = [];

    private IEnumerable<Autorizado> AutorizadosFiltrados =>
        string.IsNullOrWhiteSpace(filtro)
            ? autorizacionesDadas
            : autorizacionesDadas.Where(a =>
                (a.QuienAutoriza ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                (a.AQueAutoriza ?? "").Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                (nombresCache.TryGetValue(a.QuienAutoriza ?? "", out var n1) && n1.Contains(filtro, StringComparison.OrdinalIgnoreCase)) ||
                (nombresCache.TryGetValue(a.AQueAutoriza ?? "", out var n2) && n2.Contains(filtro, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (claimsPrincipal.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        esAdmin = claimsPrincipal.IsInRole("Administradores");

        await using var context = await DbFactory.CreateDbContextAsync();

        var userId = UserManager.GetUserId(claimsPrincipal);
        usuarioActual = await context.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.Id == userId);

        if (usuarioActual is null)
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        await CargarDatosAsync(context);
        cargado = true;
    }

    private async Task CargarDatosAsync(ApplicationDbContext context)
    {
        var identificacion = usuarioActual!.Identificacion;

        if (esAdmin)
        {
            autorizacionesDadas = await context.Set<Autorizado>()
                .AsNoTracking()
                .OrderByDescending(a => a.FechaHoraRegistro)
                .ToListAsync();

            // Cargar nombres para las identificaciones (admin)
            var identificaciones = autorizacionesDadas
                .SelectMany(a => new[] { a.QuienAutoriza, a.AQueAutoriza })
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            foreach (var id in identificaciones)
            {
                if (nombresCache.ContainsKey(id!)) continue;
                var user = await context.Users
                    .AsNoTracking()
                    .FirstOrDefaultAsync(u => u.Identificacion == id);
                if (user is not null)
                {
                    nombresCache[id!] = user.ApellidosNombres ?? "";
                }
            }
        }
        else
        {
            // Autorizaciones que este usuario otorgó (si tiene predios)
            autorizacionesOtorgadas = await context.Set<Autorizado>()
                .AsNoTracking()
                .Where(a => a.QuienAutoriza == identificacion)
                .OrderByDescending(a => a.FechaHoraRegistro)
                .ToListAsync();

            // Autorizaciones recibidas → cargar los predios que puede ver
            var autorizacionesRecibidas = await context.Set<Autorizado>()
                .AsNoTracking()
                .Where(a => a.AQueAutoriza == identificacion)
                .ToListAsync();

            if (autorizacionesRecibidas.Count > 0)
            {
                var idsAutorizantes = autorizacionesRecibidas
                    .Select(a => a.QuienAutoriza)
                    .Where(id => !string.IsNullOrWhiteSpace(id))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                var predios = await context.Predio
                    .AsNoTracking()
                    .Where(p => idsAutorizantes.Contains(p.IdentificacionFacturacion))
                    .OrderBy(p => p.IdentificacionFacturacion)
                    .ThenBy(p => p.ApellidosNombresUsuario)
                    .ToListAsync();

                // Resolver nombres de quienes autorizan
                var nombresAutorizantes = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
                foreach (var id in idsAutorizantes)
                {
                    var user = await context.Users
                        .AsNoTracking()
                        .FirstOrDefaultAsync(u => u.Identificacion == id);
                    nombresAutorizantes[id!] = user?.ApellidosNombres;
                }

                prediosAutorizados = predios.Select(p => new PredioAutorizadoView
                {
                    Predio = p,
                    QuienAutoriza = p.IdentificacionFacturacion ?? "",
                    NombreQuienAutoriza = nombresAutorizantes.GetValueOrDefault(p.IdentificacionFacturacion ?? "")
                }).ToList();
            }

            // Nombres para las autorizaciones otorgadas
            foreach (var a in autorizacionesOtorgadas)
            {
                if (!string.IsNullOrWhiteSpace(a.AQueAutoriza) && !nombresCache.ContainsKey(a.AQueAutoriza))
                {
                    var user = await context.Users
                        .AsNoTracking()
                        .FirstOrDefaultAsync(u => u.Identificacion == a.AQueAutoriza);
                    if (user is not null)
                    {
                        nombresCache[a.AQueAutoriza] = user.ApellidosNombres ?? "";
                    }
                }
            }
        }
    }

    private sealed class PredioAutorizadoView
    {
        public required Predio Predio { get; init; }
        public required string QuienAutoriza { get; init; }
        public string? NombreQuienAutoriza { get; init; }
    }
}
