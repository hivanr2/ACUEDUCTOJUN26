@page "/autorizados/details/{Guid}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ACUEDUCTO2.Data
@using ACUEDUCTO2.Share.Models
@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Detalle Autorizado</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="h4 mb-0">Detalle de Autorización</h1>
            <small class="text-muted">Información completa del registro</small>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/autorizados">Volver</a>
            @if (puedeEditar)
            {
                <a class="btn btn-primary" href="@($"/autorizados/edit/{Guid}")">Editar</a>
            }
        </div>
    </div>

    @if (!cargado)
    {
        <div class="text-center text-muted py-5">Cargando...</div>
    }
    else if (autorizado is null)
    {
        <div class="alert alert-warning">No se encontró la autorización solicitada.</div>
        <a class="btn btn-outline-secondary" href="/autorizados">Volver al listado</a>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light"><strong>Datos de la Autorización</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Identificador</dt>
                    <dd class="col-sm-8"><code>@autorizado.Guid</code></dd>

                    <dt class="col-sm-4">Quién Autoriza</dt>
                    <dd class="col-sm-8">
                        <div>@autorizado.QuienAutoriza</div>
                        @if (!string.IsNullOrWhiteSpace(nombreQuienAutoriza))
                        {
                            <small class="text-muted">@nombreQuienAutoriza</small>
                        }
                    </dd>

                    <dt class="col-sm-4">A Quién Autoriza</dt>
                    <dd class="col-sm-8">
                        <div>@autorizado.AQueAutoriza</div>
                        @if (!string.IsNullOrWhiteSpace(nombreAQueAutoriza))
                        {
                            <small class="text-muted">@nombreAQueAutoriza</small>
                        }
                    </dd>

                    <dt class="col-sm-4">Fecha de Registro</dt>
                    <dd class="col-sm-8">@autorizado.FechaHoraRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Usuario que Registra</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(autorizado.IdUsuarioRegistra))
                        {
                            <span>@autorizado.IdUsuarioRegistra</span>
                            @if (!string.IsNullOrWhiteSpace(nombreUsuarioRegistra))
                            {
                                <small class="text-muted ms-1">(@nombreUsuarioRegistra)</small>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Observaciones</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(autorizado.Observaciones) ? "—" : autorizado.Observaciones)</dd>
                </dl>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Guid { get; set; } = default!;

    private Autorizado? autorizado;
    private bool cargado;
    private bool puedeEditar;

    private string? nombreQuienAutoriza;
    private string? nombreAQueAutoriza;
    private string? nombreUsuarioRegistra;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (claimsPrincipal.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        var userId = UserManager.GetUserId(claimsPrincipal);
        var usuarioActual = await context.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.Id == userId);

        if (usuarioActual is null)
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        var esAdmin = claimsPrincipal.IsInRole("Administradores");

        autorizado = await context.Set<Autorizado>()
            .AsNoTracking()
            .FirstOrDefaultAsync(a => a.Guid == Guid);

        if (autorizado is not null)
        {
            puedeEditar = esAdmin || autorizado.QuienAutoriza == usuarioActual.Identificacion;

            nombreQuienAutoriza = await ResolverNombreAsync(context, autorizado.QuienAutoriza);
            nombreAQueAutoriza = await ResolverNombreAsync(context, autorizado.AQueAutoriza);

            if (!string.IsNullOrWhiteSpace(autorizado.IdUsuarioRegistra))
            {
                var usuarioRegistra = await context.Set<Usuario>()
                    .AsNoTracking()
                    .FirstOrDefaultAsync(u => u.Guid == autorizado.IdUsuarioRegistra);
                nombreUsuarioRegistra = usuarioRegistra?.ApellidosNombres;
            }
        }

        cargado = true;
    }

    private static async Task<string?> ResolverNombreAsync(ApplicationDbContext context, string? identificacion)
    {
        if (string.IsNullOrWhiteSpace(identificacion)) return null;
        var user = await context.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.Identificacion == identificacion);
        return user?.ApellidosNombres;
    }
}
