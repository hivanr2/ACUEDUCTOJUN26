@page "/admin/migracion"
@using ACUEDUCTO2.Services.MigrationServices
@inject MigrationService MigrationService
@rendermode InteractiveServer

<PageTitle>Migración de datos V1 → V2</PageTitle>

<h3>Migración de datos V1 → V2</h3>

<p class="text-muted">
    Copiar datos desde la base de datos V1 (xcursoro_acueducto) a la base V2.
    Los registros que ya existen no se duplicarán.
</p>

<div class="d-flex gap-2 flex-wrap mb-4">
    <button class="btn btn-primary" @onclick="MigrarTodoAsync" disabled="@migrando">
        @if (migrando)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
        }
        Migrar todo
    </button>
    <button class="btn btn-outline-primary" @onclick="MigrarPrediosAsync" disabled="@migrando">
        Migrar predios
    </button>
    <button class="btn btn-outline-primary" @onclick="MigrarPlanillasAsync" disabled="@migrando">
        Migrar planillas → periodos
    </button>
    <button class="btn btn-outline-primary" @onclick="MigrarTrabajosAsync" disabled="@migrando">
        Migrar trabajos
    </button>
    <button class="btn btn-outline-primary" @onclick="MigrarFacturacionAsync" disabled="@migrando">
         Migrar facturación
    </button>
    <button class="btn btn-outline-primary" @onclick="MigrarConsumosAsync" disabled="@migrando">
         Migrar consumos
    </button>
    <a class="btn btn-outline-secondary" href="/proceso/Listado de Consumos" target="_blank">
         Ver consumos
    </a>
</div>

@if (!string.IsNullOrEmpty(resultado))
{
    <div class="alert @alertCss">@resultado</div>
}

@if (log.Count > 0)
{
    <h5>Registro de operaciones</h5>
    <ul class="list-group mb-3">
        @foreach (var entry in log)
        {
            <li class="list-group-item">@entry</li>
        }
    </ul>
}

@code {
    private bool migrando;
    private string? resultado;
    private string alertCss = "alert-info";
    private List<string> log = new();

    private async Task MigrarTodoAsync()
    {
        migrando = true;
        resultado = null;
        log.Clear();

        try
        {
            var predios = await MigrationService.MigratePrediosAsync();
            log.Add($"Predios migrados: {predios}");

            var planillas = await MigrationService.MigratePlanillasAsync();
            log.Add($"Planillas → Periodos migrados: {planillas}");

            var trabajos = await MigrationService.MigrateTrabajosAsync();
            log.Add($"Trabajos y tablas relacionadas migradas (registros totales): {trabajos}");

            var facturas = await MigrationService.MigrateFacturacionAsync();
            log.Add($"Facturas migradas: {facturas}");

            var consumos = await MigrationService.MigrateConsumosAsync();
            log.Add($"Consumos migrados: {consumos}");

            resultado = "Migración completada correctamente (predios, periodos, facturación y consumos).";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error durante la migración: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }

    private async Task MigrarPrediosAsync()
    {
        migrando = true;
        resultado = null;

        try
        {
            var count = await MigrationService.MigratePrediosAsync();
            log.Add($"Predios migrados: {count}");
            resultado = $"Se migraron {count} predios.";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }

    private async Task MigrarPlanillasAsync()
    {
        migrando = true;
        resultado = null;

        try
        {
            var count = await MigrationService.MigratePlanillasAsync();
            log.Add($"Planillas → Periodos migrados: {count}");
            resultado = $"Se migraron {count} planillas a periodos.";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }

    private async Task MigrarFacturacionAsync()
    {
        migrando = true;
        resultado = null;

        try
        {
            var count = await MigrationService.MigrateFacturacionAsync();
            log.Add($"Facturas migradas: {count}");
            resultado = $"Se migraron {count} registros de facturación.";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }

    private async Task MigrarConsumosAsync()
    {
        migrando = true;
        resultado = null;

        try
        {
            var count = await MigrationService.MigrateConsumosAsync();
            log.Add($"Consumos migrados: {count}");
            resultado = $"Se migraron {count} consumos desde facturación.";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }

    private async Task MigrarTrabajosAsync()
    {
        migrando = true;
        resultado = null;

        try
        {
            var count = await MigrationService.MigrateTrabajosAsync();
            log.Add($"Trabajos migrados (total registros insertados): {count}");
            resultado = $"Se migraron trabajos y tablas relacionadas. Registros insertados: {count}";
            alertCss = "alert-success";
        }
        catch (Exception ex)
        {
            resultado = $"Error: {ex.InnerException?.Message ?? ex.Message}";
            alertCss = "alert-danger";
        }
        finally
        {
            migrando = false;
        }
    }
}
