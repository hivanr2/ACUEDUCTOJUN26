@page "/cotizaciones"
@using FACTURA.Client.Models
@using FACTURA.Client.Services
@inject ICotizacionesService Cotizaciones
@inject IClientesService Clientes
@inject IProductosService Productos

<h3>Cotizaciones</h3>

@if (loading)
{
    <p>Cargando...</p>
}
else if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Número</label>
                <InputText class="form-control" @bind-Value="editing.Numero" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <InputSelect class="form-select" @bind-Value="editing.ClienteId" @onchange="ClienteChanged">
                    <option value="">-- Seleccione --</option>
                    @foreach (var c in clientes)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </InputSelect>
                <div class="form-text">@editing.ClienteNombre</div>
            </div>
            <div class="col-md-3">
                <label class="form-label">Valida hasta</label>
                <InputDate class="form-control" @bind-Value="editing.ValidaHasta" />
            </div>
        </div>

        <div class="mt-3">
            <h5>Ítems</h5>
            <button class="btn btn-sm btn-outline-primary mb-2" type="button" @onclick="AgregarItem">Agregar ítem</button>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th style="width:120px">Cant.</th>
                            <th style="width:150px" class="text-end">Precio</th>
                            <th style="width:120px" class="text-end">IVA %</th>
                            <th style="width:150px" class="text-end">Subtotal</th>
                            <th style="width:150px" class="text-end">Impuesto</th>
                            <th style="width:150px" class="text-end">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < editing.Items.Count; i++)
                        {
                            var it = editing.Items[i];
                            <tr>
                                <td>
                                    <select class="form-select" @onchange="e => SeleccionarProducto(i, e.Value?.ToString())">
                                        <option value="">-- Seleccione --</option>
                                        @foreach (var p in productos)
                                        {
                                            <option value="@p.Id" selected="@(p.Id==it.ProductoId)">@p.Nombre</option>
                                        }
                                    </select>
                                </td>
                                <td><InputNumber class="form-control" @bind-Value="it.Cantidad" /></td>
                                <td><InputNumber class="form-control text-end" @bind-Value="it.PrecioUnitario" /></td>
                                <td><InputNumber class="form-control text-end" @bind-Value="it.ImpuestoPorcentaje" /></td>
                                <td class="text-end">@it.Subtotal.ToString("N2")</td>
                                <td class="text-end">@it.Impuesto.ToString("N2")</td>
                                <td class="text-end">@it.Total.ToString("N2")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => EliminarItem(i)"><i class="fas fa-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3 d-flex flex-column align-items-end">
            <div>Subtotal: <strong>@editing.Subtotal.ToString("N2")</strong></div>
            <div>Impuestos: <strong>@editing.Impuestos.ToString("N2")</strong></div>
            <div>Total: <strong>@editing.Total.ToString("N2")</strong></div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-success" type="submit">Guardar</button>
            <button class="btn btn-secondary" type="button" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}
else
{
    <div class="d-flex mb-3 gap-2">
        <button class="btn btn-primary" @onclick="Nueva"><i class="fas fa-plus me-1"></i> Nueva cotización</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in listado)
                {
                    <tr>
                        <td>@c.Numero</td>
                        <td>@c.Fecha.ToShortDateString()</td>
                        <td>@c.ClienteNombre</td>
                        <td class="text-end">@c.Total.ToString("N2")</td>
                        <td>@c.Estado</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Editar(c)"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-sm btn-outline-success me-1" @onclick="() => ConvertirAsync(c)"><i class="fas fa-file-invoice-dollar"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(c)"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool loading;
    private List<Cotizacion> listado = [];
    private List<Cliente> clientes = [];
    private List<Producto> productos = [];
    private Cotizacion? editing;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            (clientes, productos, listado) = (
                (await Clientes.GetAsync()).ToList(),
                (await Productos.GetAsync()).ToList(),
                (await Cotizaciones.GetAsync()).ToList()
            );
        }
        finally { loading = false; }
    }

    private void Nueva()
    {
        editing = new Cotizacion { Fecha = DateTime.Today, ValidaHasta = DateTime.Today.AddDays(30), Estado = "Borrador" };
    }

    private void Editar(Cotizacion c)
    {
        editing = new Cotizacion
        {
            Id = c.Id,
            Numero = c.Numero,
            ClienteId = c.ClienteId,
            ClienteNombre = c.ClienteNombre,
            Fecha = c.Fecha,
            ValidaHasta = c.ValidaHasta,
            Estado = c.Estado,
            Items = c.Items.Select(i => new ItemFactura
            {
                ProductoId = i.ProductoId,
                ProductoNombre = i.ProductoNombre,
                Cantidad = i.Cantidad,
                PrecioUnitario = i.PrecioUnitario,
                ImpuestoPorcentaje = i.ImpuestoPorcentaje
            }).ToList()
        };
    }

    private async Task GuardarAsync()
    {
        if (editing is null) return;
        var existing = listado.FirstOrDefault(x => x.Id == editing.Id);
        if (existing is null)
        {
            var created = await Cotizaciones.CreateAsync(editing);
            listado.Add(created ?? editing);
        }
        else
        {
            await Cotizaciones.UpdateAsync(editing.Id, editing);
            var idx = listado.FindIndex(f => f.Id == editing.Id);
            if (idx >= 0) listado[idx] = editing;
        }
        editing = null;
    }

    private async Task EliminarAsync(Cotizacion c)
    {
        await Cotizaciones.DeleteAsync(c.Id);
        listado.Remove(c);
    }

    private async Task ConvertirAsync(Cotizacion c)
    {
        var factura = await Cotizaciones.ConvertirAFacturaAsync(c.Id);
        if (factura is not null)
        {
            c.Estado = "Convertida"; // refresco rápido
        }
    }

    private void AgregarItem() => editing?.Items.Add(new ItemFactura());
    private void EliminarItem(int i)
    {
        if (editing is null) return;
        if (i >= 0 && i < editing.Items.Count) editing.Items.RemoveAt(i);
    }

    private void Cancelar() => editing = null;

    private void ClienteChanged(ChangeEventArgs _)
    {
        if (editing is null) return;
        var c = clientes.FirstOrDefault(x => x.Id == editing.ClienteId);
        editing.ClienteNombre = c?.Nombre ?? string.Empty;
    }

    private void SeleccionarProducto(int idx, string? id)
    {
        if (editing is null) return;
        if (!Guid.TryParse(id, out var gid)) return;
        var p = productos.FirstOrDefault(x => x.Id == gid);
        if (p is null) return;
        var it = editing.Items[idx];
        it.ProductoId = p.Id;
        it.ProductoNombre = p.Nombre;
        it.PrecioUnitario = p.Precio;
        it.ImpuestoPorcentaje = p.Impuesto;
    }
}