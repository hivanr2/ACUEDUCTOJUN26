@page "/clientes"
@using FACTURA.Client.Models
@using FACTURA.Client.Services
@inject IClientesService Service

<h3>Clientes</h3>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <input class="form-control" style="max-width:320px" placeholder="Buscar por nombre o identificación" @bind-value="search" />
    <button class="btn btn-primary" @onclick="NewCliente"><i class="fas fa-plus me-1"></i> Nuevo</button>
</div>

@if (loading)
{
    <p>Cargando...</p>
}
else if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="editing.Nombre" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Identificación</label>
                <InputText class="form-control" @bind-Value="editing.Identificacion" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Teléfono</label>
                <InputText class="form-control" @bind-Value="editing.Telefono" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <InputText type="email" class="form-control" @bind-Value="editing.Email" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Dirección</label>
                <InputText class="form-control" @bind-Value="editing.Direccion" />
            </div>
            <div class="col-12 form-check">
                <InputCheckbox class="form-check-input" @bind-Value="editing.Activo" />
                <label class="form-check-label">Activo</label>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-success" type="submit">Guardar</button>
                <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancelar</button>
            </div>
        </div>
    </EditForm>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in filtered)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.Identificacion</td>
                        <td>@c.Telefono</td>
                        <td>@c.Email</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(c)"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(c)"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Cliente> clientes = [];
    private List<Cliente> filtered => string.IsNullOrWhiteSpace(search)
        ? clientes
        : clientes.Where(c => (c.Nombre + " " + c.Identificacion).Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    private string? search;
    private bool loading;
    private Cliente? editing;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            clientes = (await Service.GetAsync()).ToList();
        }
        finally { loading = false; }
    }

    private void NewCliente() => editing = new();
    private void Edit(Cliente c) => editing = new Cliente
    {
        Id = c.Id,
        Nombre = c.Nombre,
        Identificacion = c.Identificacion,
        Email = c.Email,
        Telefono = c.Telefono,
        Direccion = c.Direccion,
        Activo = c.Activo
    };

    private void CancelEdit() => editing = null;

    private async Task SaveAsync()
    {
        if (editing is null) return;
        var existing = clientes.FirstOrDefault(x => x.Id == editing.Id);
        if (existing is null)
        {
            // Crear
            var created = await Service.CreateAsync(editing);
            clientes.Add(created ?? editing);
        }
        else
        {
            // Actualizar
            await Service.UpdateAsync(editing.Id, editing);
            existing.Nombre = editing.Nombre;
            existing.Identificacion = editing.Identificacion;
            existing.Email = editing.Email;
            existing.Telefono = editing.Telefono;
            existing.Direccion = editing.Direccion;
            existing.Activo = editing.Activo;
        }
        editing = null;
    }

    private async Task DeleteAsync(Cliente c)
    {
        await Service.DeleteAsync(c.Id);
        clientes.Remove(c);
    }
}