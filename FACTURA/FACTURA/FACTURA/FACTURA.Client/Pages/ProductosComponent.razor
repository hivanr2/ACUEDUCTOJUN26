@page "/productos"
@using FACTURA.Client.Models
@using FACTURA.Client.Services
@inject IProductosService Service

<h3>Productos / Servicios</h3>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <input class="form-control" style="max-width:320px" placeholder="Buscar por nombre" @bind-value="search" />
    <button class="btn btn-primary" @onclick="NewProducto"><i class="fas fa-plus me-1"></i> Nuevo</button>
</div>

@if (loading)
{
    <p>Cargando...</p>
}
else if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="editing.Nombre" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Unidad</label>
                <InputText class="form-control" @bind-Value="editing.Unidad" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Precio</label>
                <InputNumber class="form-control" @bind-Value="editing.Precio" />
            </div>
            <div class="col-md-2">
                <label class="form-label">IVA %</label>
                <InputNumber class="form-control" @bind-Value="editing.Impuesto" />
            </div>
            <div class="col-12 form-check">
                <InputCheckbox class="form-check-input" @bind-Value="editing.Activo" />
                <label class="form-check-label">Activo</label>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-success" type="submit">Guardar</button>
                <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancelar</button>
            </div>
        </div>
    </EditForm>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Unidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">IVA %</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in filtered)
                {
                    <tr>
                        <td>@p.Nombre</td>
                        <td>@p.Unidad</td>
                        <td class="text-end">@p.Precio.ToString("N2")</td>
                        <td class="text-end">@p.Impuesto.ToString("N0")</td>
                        <td>
                            @if (p.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => Edit(p)"><i class="fas fa-edit"></i></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(p)"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Producto> productos = [];
    private List<Producto> filtered => string.IsNullOrWhiteSpace(search)
        ? productos
        : productos.Where(p => p.Nombre.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    private string? search;
    private bool loading;
    private Producto? editing;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try { productos = (await Service.GetAsync()).ToList(); }
        finally { loading = false; }
    }

    private void NewProducto() => editing = new();
    private void Edit(Producto p) => editing = new Producto
    {
        Id = p.Id,
        Nombre = p.Nombre,
        Unidad = p.Unidad,
        Precio = p.Precio,
        Impuesto = p.Impuesto,
        Activo = p.Activo
    };

    private void CancelEdit() => editing = null;

    private async Task SaveAsync()
    {
        if (editing is null) return;
        var existing = productos.FirstOrDefault(x => x.Id == editing.Id);
        if (existing is null)
        {
            var created = await Service.CreateAsync(editing);
            productos.Add(created ?? editing);
        }
        else
        {
            await Service.UpdateAsync(editing.Id, editing);
            existing.Nombre = editing.Nombre;
            existing.Unidad = editing.Unidad;
            existing.Precio = editing.Precio;
            existing.Impuesto = editing.Impuesto;
            existing.Activo = editing.Activo;
        }
        editing = null;
    }

    private async Task DeleteAsync(Producto p)
    {
        await Service.DeleteAsync(p.Id);
        productos.Remove(p);
    }
}