@page "/"

<PageTitle>Inicio</PageTitle>

<div class="container-fluid">
    <h2 class="mb-4">¡Bienvenido a FacturaPro!</h2>
    <p class="text-muted mb-4">
        Este es tu panel principal. Aquí puedes ver un resumen de la información más relevante de tu negocio.
    </p>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-file-invoice-dollar fa-2x text-primary me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Facturación</h5>
                        <p class="card-text mb-0">Total facturas este mes: <strong>25</strong></p>
                        <a href="/facturacion" class="stretched-link small">Ver detalles</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-file-alt fa-2x text-success me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Cotizaciones</h5>
                        <p class="card-text mb-0">Pendientes: <strong>8</strong></p>
                        <a href="/cotizaciones" class="stretched-link small">Ver detalles</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-users fa-2x text-info me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Clientes</h5>
                        <p class="card-text mb-0">Registrados: <strong>120</strong></p>
                        <a href="/clientes" class="stretched-link small">Ver clientes</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-box-open fa-2x text-warning me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Productos/Servicios</h5>
                        <p class="card-text mb-0">Activos: <strong>45</strong></p>
                        <a href="/productos" class="stretched-link small">Ver catálogo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-cash-register fa-2x text-secondary me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Recaudos</h5>
                        <p class="card-text mb-0">Pagos recientes: <strong>12</strong></p>
                        <a href="/pagos" class="stretched-link small">Ver pagos</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-chart-bar fa-2x text-dark me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Reportes</h5>
                        <p class="card-text mb-0">Genera reportes financieros y de ventas.</p>
                        <a href="/reportes" class="stretched-link small">Ir a reportes</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-cogs fa-2x text-muted me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Configuración</h5>
                        <p class="card-text mb-0">Ajusta la información de tu empresa.</p>
                        <a href="/configuracion" class="stretched-link small">Configurar</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <i class="fas fa-user-circle fa-2x text-primary me-3"></i>
                    <div>
                        <h5 class="card-title mb-1">Mi Cuenta</h5>
                        <p class="card-text mb-0">Gestiona tus datos personales y acceso.</p>
                        <a href="/cuenta" class="stretched-link small">Mi cuenta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
